---
// Footer.astro: Modern, comprehensive multi-page footer for SEO & AdSense compliance
import BrandLogo from "./BrandLogo.astro";
---

<footer
  style="
  background: var(--bg-card);
  border-top: 1px solid var(--border-hairline);
  padding: 64px 24px 40px;
  margin-top: 0;
"
>
  <div style="
    max-width: 1200px;
    margin: 0 auto;
  ">
    <!-- Top row: brand + columns -->
    <div
      style="
      display: grid;
      grid-template-columns: 1.4fr 2fr 1fr 1fr;
      gap: 40px;
      margin-bottom: 48px;
    "
      class="footer-grid"
    >
      <!-- Brand -->
      <div class="footer-brand-col">
        <a
          href="/"
          style="
          display: flex;
          align-items: center;
          gap: 8px;
          margin-bottom: 12px;
          text-decoration: none;
        "
        >
          <BrandLogo size={24} />
          <span
            style="font-size: 15px; font-weight: 700; color: var(--text-ink); letter-spacing: -0.2px;"
            >Platform Fee Matrix</span
          >
        </a>
        <p
          class="footer-brand-desc"
          style="
          font-size: 13px;
          color: var(--text-mute);
          line-height: 1.6;
          max-width: 260px;
          margin: 0 0 16px;
        "
        >
          Real-time interactive fee comparison and tax compliance calculator across 14 top creator, digital storefront, and freelance platforms.
        </p>
        <p style="font-size: 12px; color: var(--text-mute); margin: 0;">
          © {new Date().getFullYear()} PlatformFeeMatrix.com. All rights reserved.
        </p>
      </div>

      <!-- Column: Platforms (All 14) -->
      <div class="footer-platform-col" style="display: flex; flex-direction: column; align-items: center; text-align: center;">
        <p
          class="footer-platform-heading"
          style="
          font-family: var(--font-mono);
          font-size: 11px;
          font-weight: 600;
          text-transform: uppercase;
          letter-spacing: 0.08em;
          color: var(--text-mute);
          margin: 0 0 12px;
          text-align: center;
          width: 100%;
        "
        >
          Platforms (14 Fee Guides)
        </p>
        <div style="display: grid; grid-template-columns: auto auto; gap: 8px 36px; text-align: left;">
          {
            [
              { label: "Stripe Direct", url: "/platforms/stripe" },
              { label: "Lemon Squeezy", url: "/platforms/lemonsqueezy" },
              { label: "Paddle", url: "/platforms/paddle" },
              { label: "Gumroad", url: "/platforms/gumroad" },
              { label: "Whop", url: "/platforms/whop" },
              { label: "Sellfy", url: "/platforms/sellfy" },
              { label: "Podia", url: "/platforms/podia" },
              { label: "Stan Store", url: "/platforms/stan" },
              { label: "Payhip", url: "/platforms/payhip" },
              { label: "Teachable", url: "/platforms/teachable" },
              { label: "Fiverr", url: "/platforms/fiverr" },
              { label: "Etsy", url: "/platforms/etsy" },
              { label: "Amazon KDP", url: "/platforms/kdp" },
              { label: "Upwork", url: "/platforms/upwork" },
            ].map(({ label, url }) => (
              <a
                href={url}
                style="font-size: 13px; color: var(--text-body); text-decoration: none; transition: color 0.15s ease;"
                onmouseover="this.style.color='var(--color-primary)'"
                onmouseout="this.style.color='var(--text-body)'"
              >
                {label}
              </a>
            ))
          }
        </div>
        <div class="footer-comparisons-row" style="margin-top: 16px; width: 100%; border-top: 1px solid var(--border-hairline); padding-top: 10px; text-align: center; display: flex; flex-direction: column; align-items: center;">
          <p
            class="footer-comparisons-heading"
            style="
            font-family: var(--font-mono);
            font-size: 10.5px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-mute);
            margin: 0 0 6px;
            text-align: center;
          "
          >
            Top Comparisons
          </p>
          <div class="footer-comparisons-links" style="display: flex; flex-direction: column; align-items: center; gap: 5px; font-size: 12px; text-align: center; width: 100%;">
            <div style="display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 4px 8px;">
              <a href="/compare/gumroad-vs-lemon-squeezy" style="color: var(--text-body); text-decoration: none; transition: color 0.15s ease;" onmouseover="this.style.color='var(--color-primary)'" onmouseout="this.style.color='var(--text-body)'">Gumroad vs Lemon Squeezy</a>
              <span style="color: var(--border-hairline);">·</span>
              <a href="/compare/stripe-vs-paddle" style="color: var(--text-body); text-decoration: none; transition: color 0.15s ease;" onmouseover="this.style.color='var(--color-primary)'" onmouseout="this.style.color='var(--text-body)'">Stripe vs Paddle</a>
              <span style="color: var(--border-hairline);">·</span>
              <a href="/compare/fiverr-vs-upwork" style="color: var(--text-body); text-decoration: none; transition: color 0.15s ease;" onmouseover="this.style.color='var(--color-primary)'" onmouseout="this.style.color='var(--text-body)'">Fiverr vs Upwork</a>
            </div>
            <a href="/compare" style="color: var(--color-primary); text-decoration: none; font-weight: 600; font-size: 12px; transition: color 0.15s ease;" onmouseover="this.style.color='var(--color-primary-hover, #d97706)'" onmouseout="this.style.color='var(--color-primary)'">All 12 Comparisons →</a>
          </div>
        </div>
      </div>

      <!-- Column: Navigation & Tools -->
      <div class="footer-resources-col">
        <p
          style="
          font-family: var(--font-mono);
          font-size: 11px;
          font-weight: 600;
          text-transform: uppercase;
          letter-spacing: 0.08em;
          color: var(--text-mute);
          margin: 0 0 12px;
        "
        >
          Tools & Guides
        </p>
        <ul
          style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px;"
        >
          {
            [
              { label: "Fee Calculator", url: "/calculator" },
              { label: "Platforms Directory", url: "/platforms" },
              { label: "Compare Platforms", url: "/compare" },
              { label: "Creator Fee Guide", url: "/guide" },
              { label: "FAQ & Methodology", url: "/faq" },
            ].map(({ label, url }) => (
              <li>
                <a
                  href={url}
                  style="font-size: 13px; color: var(--text-body); text-decoration: none; transition: color 0.15s ease;"
                  onmouseover="this.style.color='var(--color-primary)'"
                  onmouseout="this.style.color='var(--text-body)'"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Column: Company & Legal -->
      <div class="footer-info-col">
        <p
          style="
          font-family: var(--font-mono);
          font-size: 11px;
          font-weight: 600;
          text-transform: uppercase;
          letter-spacing: 0.08em;
          color: var(--text-mute);
          margin: 0 0 12px;
        "
        >
          About & Legal
        </p>
        <ul
          style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px;"
        >
          <li>
            <a
              href="/about"
              style="font-size: 13px; color: var(--text-body); text-decoration: none; transition: color 0.15s ease;"
              onmouseover="this.style.color='var(--color-primary)'"
              onmouseout="this.style.color='var(--text-body)'"
              >About Us</a>
          </li>
          <li>
            <a
              href="/privacy"
              style="font-size: 13px; color: var(--text-body); text-decoration: none; transition: color 0.15s ease;"
              onmouseover="this.style.color='var(--color-primary)'"
              onmouseout="this.style.color='var(--text-body)'"
              >Privacy Policy</a>
          </li>
          <li>
            <a
              href="/terms"
              style="font-size: 13px; color: var(--text-body); text-decoration: none; transition: color 0.15s ease;"
              onmouseover="this.style.color='var(--color-primary)'"
              onmouseout="this.style.color='var(--text-body)'"
              >Terms of Service</a>
          </li>
        </ul>
        <p
          style="font-size: 11px; color: var(--text-mute); margin: 20px 0 0; line-height: 1.5;"
        >
          Fee data is for educational simulation. Platform trademarks belong to their respective owners.
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  @media (max-width: 820px) {
    .footer-grid {
      display: grid !important;
      grid-template-columns: 1.8fr 1fr !important;
      grid-template-areas:
        "brand brand"
        "platforms resources"
        "info info" !important;
      gap: 32px 20px !important;
    }
    .footer-brand-col {
      grid-area: brand;
    }
    .footer-platform-col {
      grid-area: platforms;
      align-items: flex-start !important;
      text-align: left !important;
    }
    .footer-platform-heading {
      text-align: left !important;
    }
    .footer-comparisons-row {
      align-items: flex-start !important;
      text-align: left !important;
    }
    .footer-comparisons-heading {
      text-align: left !important;
    }
    .footer-comparisons-links {
      align-items: flex-start !important;
      text-align: left !important;
    }
    .footer-comparisons-links > div {
      justify-content: flex-start !important;
    }
    .footer-resources-col {
      grid-area: resources;
    }
    .footer-info-col {
      grid-area: info;
    }
    .footer-brand-desc {
      max-width: 100% !important;
    }
  }

  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr !important;
      grid-template-areas:
        "brand"
        "platforms"
        "resources"
        "info" !important;
      gap: 28px !important;
    }
  }
</style>
