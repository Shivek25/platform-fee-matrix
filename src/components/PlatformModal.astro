---
---

<div id="platform-modal-overlay" class="modal-overlay" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="modal-card-container">
    <!-- Close Cross Button -->
    <button id="modal-close-btn" class="modal-close-chip" aria-label="Close modal">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Modal Body Content -->
    <div id="modal-body-content">
      <!-- Dynamic header -->
      <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 16px;">
        <img id="modal-icon" src="/icons/stripe.svg" width="36" height="36" alt="Platform Logo" style="border-radius: 8px; flex-shrink: 0;" />
        <div>
          <h3 id="modal-title" style="font-size: 22px; font-weight: 700; color: var(--text-ink); margin: 0; letter-spacing: -0.5px;">
            Platform Name
          </h3>
          <span id="modal-badge" class="badge badge-tax" style="margin-top: 4px; display: inline-block;">
            Category Badge
          </span>
        </div>
      </div>

      <!-- Overview description -->
      <p id="modal-description" style="font-size: 14.5px; color: var(--text-body); line-height: 1.65; margin: 0 0 20px;">
        Overview description text goes here.
      </p>

      <!-- Fee Breakdown Grid -->
      <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-hairline); border-radius: 12px; padding: 16px; margin-bottom: 20px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
          <span style="font-size: 13px; color: var(--text-mute);">Fee Structure</span>
          <span id="modal-fee-structure" style="font-size: 13.5px; font-weight: 600; color: #F59E0B; font-family: var(--font-mono);">
            5% + $0.50
          </span>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
          <span style="font-size: 13px; color: var(--text-mute);">Tax Handling</span>
          <span id="modal-tax-mode" style="font-size: 13px; font-weight: 600; color: var(--text-ink);">
            MoR — Auto Tax
          </span>
        </div>
        <div style="height: 1px; background: var(--border-hairline); margin: 10px 0;"></div>
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <span style="font-size: 13px; color: var(--text-mute);">Effective Fee Rate</span>
          <span id="modal-eff-rate" style="font-size: 13.5px; font-weight: 700; color: var(--color-profit); font-family: var(--font-mono);">
            ~5.5%
          </span>
        </div>
      </div>

      <!-- Key Highlights -->
      <div style="margin-bottom: 24px;">
        <p style="font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-mute); margin: 0 0 10px; font-family: var(--font-mono);">
          Key Highlights
        </p>
        <ul id="modal-highlights" style="margin: 0; padding-left: 18px; font-size: 13.5px; color: var(--text-body); line-height: 1.7;">
          <li>Highlight item 1</li>
          <li>Highlight item 2</li>
          <li>Highlight item 3</li>
        </ul>
      </div>

      <!-- Action Row -->
      <div style="display: flex; gap: 12px; justify-content: flex-end;">
        <button id="modal-calc-btn" class="modal-primary-btn">
          Compare in Calculator ↓
        </button>
      </div>
    </div>
  </div>
</div>

