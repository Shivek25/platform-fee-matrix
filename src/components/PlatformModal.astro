  function initPlatformModal() {
    const rawOverlay = document.getElementById("platform-modal-overlay");
    const closeBtn = document.getElementById("modal-close-btn");
    const calcBtn = document.getElementById("modal-calc-btn");
    if (!rawOverlay) return;
    const overlay = rawOverlay;

    let activeCardId = "";

    function openModal(name: string) {
      const data = PLATFORM_MODAL_DATA[name];
      if (!data) return;

      activeCardId = data.cardId;

      // Fill content
      const icon = document.getElementById("modal-icon") as HTMLImageElement;
      const title = document.getElementById("modal-title");
      const badge = document.getElementById("modal-badge");
      const desc = document.getElementById("modal-description");
      const feeStruct = document.getElementById("modal-fee-structure");
      const taxMode = document.getElementById("modal-tax-mode");
      const effRate = document.getElementById("modal-eff-rate");
      const highlights = document.getElementById("modal-highlights");

      if (icon) { icon.src = data.icon; icon.alt = data.name; }
      if (title) title.textContent = data.name;
      if (badge) {
        badge.textContent = data.badge;
        badge.className = `badge ${data.badgeClass}`;
      }
      if (desc) desc.textContent = data.description;
      if (feeStruct) feeStruct.textContent = data.feeStructure;
      if (taxMode) taxMode.textContent = data.taxMode;
      if (effRate) effRate.textContent = data.effRate;

      if (highlights) {
        highlights.innerHTML = data.highlights.map(h => `<li>${h}</li>`).join("");
      }

      // Show overlay with class
      overlay.classList.add("modal-open");
      overlay.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    }

    function closeModal() {
      overlay.classList.remove("modal-open");
      overlay.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }

    // Attach click handlers to pill buttons in Hero
    document.querySelectorAll(".hero-platform-pill").forEach(btn => {
      btn.addEventListener("click", () => {
        const platformName = btn.getAttribute("data-platform");
        if (platformName) openModal(platformName);
      });
    });

    // Close button click
    if (closeBtn) closeBtn.addEventListener("click", closeModal);

    // Backdrop click outside card container
    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) closeModal();
    });

    // Escape key listener
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && overlay.classList.contains("modal-open")) {
        closeModal();
      }
    });

    // Scroll to Matrix Card button
    if (calcBtn) {
      calcBtn.addEventListener("click", () => {
        closeModal();
        if (activeCardId) {
          const targetCard = document.getElementById(activeCardId);
          if (targetCard) {
            targetCard.scrollIntoView({ behavior: "smooth", block: "center" });
            targetCard.classList.remove("card-winner-glow");
            void targetCard.offsetWidth; // Force reflow
            targetCard.classList.add("card-winner-glow");
          }
        }
      });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPlatformModal);
  } else {
    initPlatformModal();
  }
</script>

<style>
  /* Glassmorphism Backdrop Overlay */
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(11, 15, 23, 0.82);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .modal-overlay.modal-open {
    opacity: 1;
    pointer-events: auto;
  }

  /* Centered Modal Card Box */
  .modal-card-container {
    position: relative;
    width: 100%;
    max-width: 520px;
    background: rgba(17, 23, 38, 0.95);
    border: 1px solid var(--border-hairline-strong);
    border-radius: 20px;
    padding: 32px 28px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8), 0 0 40px rgba(245, 158, 11, 0.15);
    transform: scale(0.92) translateY(10px);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    max-height: calc(100vh - 60px);
    overflow-y: auto;
  }

  .modal-overlay.modal-open .modal-card-container {
    transform: scale(1) translateY(0);
  }

  /* Close Chip Button */
  .modal-close-chip {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-mute);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .modal-close-chip:hover {
    background: rgba(255, 255, 255, 0.15);
    color: var(--text-ink);
    transform: rotate(90deg);
  }

  /* Primary Action Button */
  .modal-primary-btn {
    background: linear-gradient(135deg, #F59E0B, #D97706);
    color: #0B0F17;
    border: none;
    border-radius: 100px;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 0 16px rgba(245, 158, 11, 0.35);
    transition: all 0.2s ease;
  }

  .modal-primary-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 24px rgba(245, 158, 11, 0.6);
  }
</style>
