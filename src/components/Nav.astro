---
// Nav.astro — Vercel-inspired sticky top nav
---

<header id="nav" style="
  position: sticky;
  top: 0;
  z-index: 50;
  height: 64px;
  background: var(--bg-nav);
  backdrop-filter: saturate(180%) blur(16px);
  -webkit-backdrop-filter: saturate(180%) blur(16px);
  border-bottom: 1px solid var(--border-hairline);
">
  <div style="
    max-width: 1200px;
    margin: 0 auto;
    height: 100%;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  ">
    <!-- Logo / Brand -->
    <a href="/" style="
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--text-ink);
      flex-shrink: 0;
    " aria-label="Platform Fee Matrix home">
      <!-- Minimal logo mark -->
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="2" y="14" width="4" height="8" rx="1" fill="currentColor" opacity="0.4"/>
        <rect x="8" y="9" width="4" height="13" rx="1" fill="currentColor" opacity="0.7"/>
        <rect x="14" y="4" width="4" height="18" rx="1" fill="currentColor" opacity="0.9"/>
        <rect x="20" y="1" width="2" height="21" rx="1" fill="currentColor"/>
      </svg>
      <span style="
        font-size: 14px;
        font-weight: 600;
        letter-spacing: -0.3px;
        line-height: 1;
      ">Platform Fee Matrix</span>
    </a>

    <!-- Centre nav links -->
    <nav aria-label="Primary navigation" style="
      display: flex;
      align-items: center;
      gap: 4px;
    " class="nav-links-desktop">
      <a href="/#calculator" class="nav-link" style="
        font-size: 14px;
        font-weight: 400;
        color: var(--text-body);
        text-decoration: none;
        padding: 6px 12px;
        border-radius: 100px;
        transition: color 0.15s ease, background 0.15s ease;
      " onmouseover="this.style.color='var(--text-ink)';this.style.background='var(--bg-card-soft)'" onmouseout="this.style.color='var(--text-body)';this.style.background='transparent'">Calculator</a>
      <a href="/#guide" class="nav-link" style="
        font-size: 14px;
        font-weight: 400;
        color: var(--text-body);
        text-decoration: none;
        padding: 6px 12px;
        border-radius: 100px;
        transition: color 0.15s ease, background 0.15s ease;
      " onmouseover="this.style.color='var(--text-ink)';this.style.background='var(--bg-card-soft)'" onmouseout="this.style.color='var(--text-body)';this.style.background='transparent'">Guide</a>
      <a href="/#platforms" class="nav-link" style="
        font-size: 14px;
        font-weight: 400;
        color: var(--text-body);
        text-decoration: none;
        padding: 6px 12px;
        border-radius: 100px;
        transition: color 0.15s ease, background 0.15s ease;
      " onmouseover="this.style.color='var(--text-ink)';this.style.background='var(--bg-card-soft)'" onmouseout="this.style.color='var(--text-body)';this.style.background='transparent'">Platforms</a>
    </nav>

    <!-- Right: theme toggle -->
    <div style="display: flex; align-items: center; gap: 8px; flex-shrink: 0;">
      <!-- Theme toggle button -->
      <button
        id="theme-toggle"
        aria-label="Toggle dark mode"
        style="
          width: 32px;
          height: 32px;
          border-radius: 6px;
          border: 1px solid var(--border-hairline);
          background: var(--bg-card);
          color: var(--text-ink);
          cursor: pointer;
          display: flex;
          align-items: center;
          justify-content: center;
          transition: background 0.15s ease, border-color 0.15s ease;
        "
        onmouseover="this.style.background='var(--bg-card-soft)'"
        onmouseout="this.style.background='var(--bg-card)'"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg id="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
          <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg id="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <!-- Share / Copy link CTA -->
      <a
        href="/#calculator"
        style="
          display: inline-flex;
          align-items: center;
          height: 28px;
          padding: 0 10px;
          font-size: 13px;
          font-weight: 500;
          color: var(--text-on-primary);
          background: var(--color-primary);
          border-radius: 6px;
          text-decoration: none;
          white-space: nowrap;
          transition: opacity 0.15s ease;
          letter-spacing: -0.1px;
        "
        onmouseover="this.style.opacity='0.85'"
        onmouseout="this.style.opacity='1'"
      >
        Try Calculator
      </a>
    </div>
  </div>
</header>

<script>
  // Dark mode toggle
  const btn = document.getElementById("theme-toggle");
  const sun = document.getElementById("icon-sun");
  const moon = document.getElementById("icon-moon");

  function syncIcons() {
    const isDark = document.documentElement.classList.contains("dark");
    if (sun) sun.style.display = isDark ? "block" : "none";
    if (moon) moon.style.display = isDark ? "none" : "block";
  }

  syncIcons();

  btn?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
    syncIcons();
  });
</script>

<style>
  @media (max-width: 600px) {
    .nav-links-desktop {
      display: none !important;
    }
  }
</style>
