---
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
// Floating winner dock is only relevant where the interactive calculator exists
const isCalcPage = pathname === "/" || pathname === "/calculator";
---

{isCalcPage && (
  <div
    id="floating-winner-dock"
    role="region"
    aria-label="Floating Navigation and Winner Summary"
    class="floating-dock-container"
  >
    <!-- Animated Gradient Aura Border Layer -->
    <div class="dock-aura-border"></div>

    <!-- Main Glass Capsule -->
    <div class="dock-glass-content">
      <!-- Live Winner Badge -->
      <div class="dock-badge-wrapper">
        <span id="dock-pulse-dot" class="radar-pulse-dot"></span>
        <div id="dock-winner-text-wrap" class="dock-text-wrap">
          <span id="dock-winner-text" class="dock-winner-text">
            <span class="dock-label">⚡ Best:</span>
            <span class="dock-winner-name">Calculating...</span>
          </span>
        </div>
      </div>

      <!-- Quick Anchors -->
      <div style="display: flex; align-items: center; gap: 8px; flex-shrink: 0;">
        <a
          href="/calculator"
          class="dock-chip-btn"
        >
          Calc
        </a>
        <a
          href="/guide"
          class="dock-chip-btn dock-link-hide-mobile"
        >
          Guide
        </a>
        <button
          id="dock-back-to-top"
          aria-label="Back to Top"
          class="dock-chip-btn dock-chip-btn-primary"
        >
          Top ↑
        </button>
      </div>
    </div>
  </div>
)}

<script>
  function initFloatingDock() {
    const dock = document.getElementById('floating-winner-dock');
    if (!dock) return;
    const dockEl = dock;

    const calcSection = document.getElementById('calculator');
    const platformsGrid = document.getElementById('platforms');
    // If not on calculator or platforms grid isn't present, stay hidden
    if (!calcSection || !platformsGrid) {
      dockEl.classList.remove('dock-visible');
      return;
    }
    const calcEl = calcSection;
    const platformsEl = platformsGrid;

    const methodologySection = document.getElementById('calc-methodology');
    const guideSection = document.getElementById('guide');
    const bottomBoundary = methodologySection || guideSection;

    const winnerText = document.getElementById('dock-winner-text');
    const textWrap = document.getElementById('dock-winner-text-wrap');
    const topBtn = document.getElementById('dock-back-to-top');

    // Drag & Drop State
    let currentOffsetX = 0;
    let currentOffsetY = 0;
    let isDragging = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let initialOffsetX = 0;
    let initialOffsetY = 0;

    // Mobile Long-Press (> 1s) Drag State
    let longPressTimer: any = null;
    let touchStartX = 0;
    let touchStartY = 0;

    function applyTransform() {
      if (!dockEl) return;
      const isVisible = dockEl.classList.contains('dock-visible');
      const baseOffsetY = isVisible ? 0 : 140;
      const finalY = currentOffsetY + baseOffsetY;
      dockEl.style.transform = `translate3d(calc(-50% + ${currentOffsetX}px), ${finalY}px, 0)`;
    }

    // Toggle Dock visibility: show strictly within platform cards area, hide above calculator & before methodology/guide
    let ticking = false;
    function checkScroll() {
      if (!dockEl || !calcEl || !platformsEl) return;

      const calcRect = calcEl.getBoundingClientRect();
      const platformsRect = platformsEl.getBoundingClientRect();

      // Top threshold: User has scrolled into the calculator section
      const isPastCalcTop = calcRect.top <= 250;

      // Bottom threshold: User is within the platform cards area
      // When the bottom of the platforms grid reaches near viewport bottom,
      // or when the methodology / guide section enters the viewport, hide the dock.
      let isBeforeBottom = platformsRect.bottom > (window.innerHeight - 80);

      if (bottomBoundary) {
        const bottomRect = bottomBoundary.getBoundingClientRect();
        if (bottomRect.top <= (window.innerHeight - 80)) {
          isBeforeBottom = false;
        }
      }

      const isInCalcSection = isPastCalcTop && isBeforeBottom;

      if (isInCalcSection) {
        dockEl.classList.add('dock-visible');
      } else {
        dockEl.classList.remove('dock-visible');
      }
      applyTransform();
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(checkScroll);
        ticking = true;
      }
    }, { passive: true });

    // ─── Drag & Drop Handlers ─────────────────────────────────
    function constrainOffset(x: number, y: number) {
      const rect = dockEl.getBoundingClientRect();
      const halfWidth = rect.width / 2;
      const halfHeight = rect.height / 2;

      // Calculate max allowed offsets from center
      const maxOffX = Math.max(0, (window.innerWidth / 2) - halfWidth - 12);
      const minOffX = -maxOffX;

      // Bottom baseline is 28px from bottom
      const defaultCenterY = window.innerHeight - 28 - halfHeight;

      // Constrain Top Edge: Keep dock strictly within calculator section
      let minAllowedTop = 16;
      if (calcEl) {
        const calcRect = calcEl.getBoundingClientRect();
        if (calcRect.top > 0) {
          minAllowedTop = Math.max(16, calcRect.top + 16);
        }
      }

      const minOffY = minAllowedTop - (defaultCenterY - halfHeight);
      const maxOffY = 20; // 20px lower than baseline

      const clampedX = Math.min(Math.max(x, minOffX), maxOffX);
      const clampedY = Math.min(Math.max(y, minOffY), maxOffY);
      return { x: clampedX, y: clampedY };
    }

    function startDrag(clientX: number, clientY: number) {
      isDragging = true;
      dragStartX = clientX;
      dragStartY = clientY;
      initialOffsetX = currentOffsetX;
      initialOffsetY = currentOffsetY;
      dockEl.classList.add('dock-is-dragging');
    }

    function moveDrag(clientX: number, clientY: number) {
      if (!isDragging) return;
      const deltaX = clientX - dragStartX;
      const deltaY = clientY - dragStartY;
      const targetX = initialOffsetX + deltaX;
      const targetY = initialOffsetY + deltaY;

      const constrained = constrainOffset(targetX, targetY);
      currentOffsetX = constrained.x;
      currentOffsetY = constrained.y;
      applyTransform();
    }

    function stopDrag() {
      if (isDragging) {
        isDragging = false;
        dockEl.classList.remove('dock-is-dragging');
        dockEl.classList.remove('dock-mobile-drag-ready');
      }
      if (longPressTimer) {
        clearTimeout(longPressTimer);
        longPressTimer = null;
      }
    }

    // ─── Desktop Mouse Drag ──────────────────────────────────
    dockEl.addEventListener('mousedown', (e: MouseEvent) => {
      const target = e.target as HTMLElement;
      if (target.closest('a, button')) return;

      startDrag(e.clientX, e.clientY);
    });

    window.addEventListener('mousemove', (e: MouseEvent) => {
      if (isDragging) {
        moveDrag(e.clientX, e.clientY);
      }
    });

    window.addEventListener('mouseup', () => {
      stopDrag();
    });

    // ─── Mobile Touch Drag (Long Press > 0.5 Seconds) ───────────
    dockEl.addEventListener('touchstart', (e: TouchEvent) => {
      const target = e.target as HTMLElement;
      if (target.closest('a, button')) return;

      const touch = e.touches[0];
      touchStartX = touch.clientX;
      touchStartY = touch.clientY;

      if (longPressTimer) clearTimeout(longPressTimer);

      longPressTimer = setTimeout(() => {
        startDrag(touch.clientX, touch.clientY);
        dockEl.classList.add('dock-mobile-drag-ready');
        if (navigator.vibrate) {
          try { navigator.vibrate(50); } catch (_) {}
        }
      }, 500);
    }, { passive: true });

    dockEl.addEventListener('touchmove', (e: TouchEvent) => {
      const touch = e.touches[0];

      if (!isDragging) {
        const dist = Math.hypot(touch.clientX - touchStartX, touch.clientY - touchStartY);
        if (dist > 10 && longPressTimer) {
          clearTimeout(longPressTimer);
          longPressTimer = null;
        }
      } else {
        if (e.cancelable) e.preventDefault();
        moveDrag(touch.clientX, touch.clientY);
      }
    }, { passive: false });

    dockEl.addEventListener('touchend', () => {
      stopDrag();
    });
    dockEl.addEventListener('touchcancel', () => {
      stopDrag();
    });

    if (topBtn) {
      topBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // Filter label titles for display
    const FILTER_LABELS: Record<string, string> = {
      all: "Overall Best",
      mor: "Best Auto-Tax (MoR)",
      direct: "Best Direct Gateway",
      monthly: "Best Monthly Plan",
    };

    // Listen for custom winner-updated event from Calculator component
    window.addEventListener('matrix-winner-updated', ((e: CustomEvent) => {
      if (winnerText && e.detail && dockEl) {
        const { name, netFormatted, netCompact, activeFilter, isReverse, reqPriceFormatted, grossFormatted } = e.detail;
        const compactClean = netCompact ? netCompact.replace(/[\(\)]/g, '').replace(/^≈\s*/, '') : '';
        const filterBadgeText = isReverse
          ? (activeFilter === "mor" ? "Lowest Price (MoR)" : activeFilter === "direct" ? "Lowest Price (Gateway)" : activeFilter === "monthly" ? "Lowest Price (Monthly)" : "Lowest Price to Charge")
          : (FILTER_LABELS[activeFilter || 'all'] || 'Best');
        const icon = isReverse ? "🎯" : "⚡";

        // Trigger Dock Scale Pulse Animation on inner capsule
        const glassContent = dockEl.querySelector('.dock-glass-content') as HTMLElement;
        if (glassContent) {
          glassContent.classList.remove('dock-pop-pulse');
          void glassContent.offsetWidth; // Force reflow
          glassContent.classList.add('dock-pop-pulse');
        }

        // Smooth text transition
        if (textWrap) {
          textWrap.style.opacity = '0';
          textWrap.style.transform = 'translateY(-4px)';
          setTimeout(() => {
            if (isReverse) {
              winnerText.innerHTML = `<span class="dock-label">${icon} ${filterBadgeText}:</span> <strong class="dock-winner-name">${name}</strong> <span class="dock-net-val">Charge ${reqPriceFormatted}</span> <span class="dock-sub-val">(Gross ${grossFormatted})</span>`;
            } else {
              winnerText.innerHTML = `<span class="dock-label">${icon} ${filterBadgeText}:</span> <strong class="dock-winner-name">${name}</strong> <span class="dock-net-val">${compactClean ? compactClean + ' net' : netFormatted}</span> <span class="dock-sub-val">(${netFormatted})</span>`;
            }
            textWrap.style.opacity = '1';
            textWrap.style.transform = 'translateY(0)';
          }, 150);
        }
      }
    }) as EventListener);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFloatingDock);
  } else {
    initFloatingDock();
  }
</script>

<style>
  /* Container Positioning & Ambient Float */
  .floating-dock-container {
    position: fixed;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%) translateY(140px);
    opacity: 0;
    z-index: 990;
    pointer-events: auto;
    white-space: nowrap;
    max-width: calc(100vw - 32px);
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
    border-radius: 100px;
    padding: 2px;
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
  }

  .floating-dock-container.dock-is-dragging {
    transition: none !important;
    animation: none !important;
    cursor: grabbing !important;
  }

  .floating-dock-container.dock-mobile-drag-ready {
    border-color: rgba(245, 158, 11, 1) !important;
    box-shadow: 0 0 35px rgba(245, 158, 11, 0.7), 0 16px 40px rgba(0, 0, 0, 0.9) !important;
  }

  .floating-dock-container.dock-visible {
    opacity: 1;
  }

  /* Winner Update Pop Scale Pulse on Inner Capsule */
  .dock-glass-content.dock-pop-pulse {
    animation: dock-pop 0.45s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  @keyframes dock-pop {
    0% { transform: scale(1); }
    50% { transform: scale(1.04); }
    100% { transform: scale(1); }
  }

  @keyframes ambient-float {
    0% { transform: translateY(0); }
    100% { transform: translateY(-3px); }
  }

  /* Shimmering Aura Border Layer */
  .dock-aura-border {
    position: absolute;
    inset: 0;
    border-radius: 100px;
    padding: 1.5px;
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.9), rgba(251, 191, 36, 0.7), rgba(217, 119, 6, 0.4), rgba(245, 158, 11, 0.9));
    background-size: 200% 200%;
    animation: aura-shimmer 4s ease infinite;
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  @keyframes aura-shimmer {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  /* Main Glass Capsule Inner */
  .dock-glass-content {
    position: relative;
    background: rgba(13, 19, 32, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 100px;
    padding: 10px 22px;
    display: flex;
    align-items: center;
    gap: 18px;
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.8), 0 0 30px rgba(245, 158, 11, 0.35), 0 0 15px rgba(245, 158, 11, 0.2);
    cursor: grab;
    animation: ambient-float 5s ease-in-out infinite alternate;
  }

  .floating-dock-container.dock-is-dragging .dock-glass-content {
    cursor: grabbing !important;
  }

  /* Live Winner Badge */
  .dock-badge-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-right: 16px;
    border-right: 1px solid rgba(255, 255, 255, 0.15);
    font-size: 13.5px;
    font-weight: 600;
    color: #F9FAFB;
    min-width: 0;
    flex: 1 1 auto;
    overflow: hidden;
  }

  .dock-text-wrap {
    transition: opacity 0.2s ease, transform 0.2s ease;
    min-width: 0;
    flex: 1 1 auto;
    overflow: hidden;
  }

  .dock-winner-text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
    min-width: 0;
  }

  .dock-label {
    color: #9CA3AF;
    font-weight: 500;
  }
  .dock-winner-name {
    color: #F59E0B;
    font-weight: 700;
    margin-left: 4px;
    font-size: 14px;
  }
  .dock-net-val {
    color: #10B981;
    font-weight: 700;
    font-family: var(--font-mono);
    font-size: 14px;
    margin-left: 6px;
  }
  .dock-sub-val {
    color: #9CA3AF;
    font-size: 12px;
    font-family: var(--font-mono);
    margin-left: 4px;
  }

  /* Light mode overrides for Floating Dock */
  :global(html.light) .dock-aura-border {
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.85), rgba(251, 191, 36, 0.65), rgba(217, 119, 6, 0.4), rgba(245, 158, 11, 0.85));
    background-size: 200% 200%;
  }

  :global(html.light) .dock-glass-content {
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid rgba(245, 158, 11, 0.25);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.1), 0 0 24px rgba(217, 119, 6, 0.2);
  }
  :global(html.light) .dock-badge-wrapper {
    border-right-color: rgba(15, 23, 42, 0.12);
    color: #0f172a;
  }
  :global(html.light) .dock-label {
    color: #475569;
  }
  :global(html.light) .dock-winner-name {
    color: #d97706;
  }
  :global(html.light) .dock-net-val {
    color: #059669;
  }
  :global(html.light) .dock-sub-val {
    color: #64748b;
  }
  :global(html.light) .dock-chip-btn {
    color: #0f172a;
    background: rgba(15, 23, 42, 0.06);
    border-color: rgba(15, 23, 42, 0.12);
  }
  :global(html.light) .dock-chip-btn:hover {
    color: #b45309;
    background: rgba(245, 158, 11, 0.15);
    border-color: rgba(217, 119, 6, 0.4);
  }
  :global(html.light) .dock-chip-btn-primary {
    background: rgba(245, 158, 11, 0.2);
    border-color: rgba(217, 119, 6, 0.4);
  }
  :global(html.light) .dock-chip-btn-primary:hover {
    background: rgba(245, 158, 11, 0.3);
    border-color: rgba(217, 119, 6, 0.6);
  }

  /* Radar Pulse Dot */
  .radar-pulse-dot {
    position: relative;
    width: 10px;
    height: 10px;
    background: #10B981;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
  }
  .radar-pulse-dot::before {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    background: rgba(16, 185, 129, 0.4);
    animation: radar-wave 2s cubic-bezier(0, 0.2, 0.8, 1) infinite;
  }

  @keyframes radar-wave {
    0% { transform: scale(0.6); opacity: 1; }
    100% { transform: scale(2.2); opacity: 0; }
  }

  /* Nav Chip Buttons */
  .dock-chip-btn {
    color: #F9FAFB;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    padding: 5px 12px;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .dock-chip-btn:hover {
    color: #F59E0B;
    background: rgba(245, 158, 11, 0.18);
    border-color: rgba(245, 158, 11, 0.5);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.2);
  }

  .dock-chip-btn-primary {
    background: rgba(245, 158, 11, 0.2);
    border-color: rgba(245, 158, 11, 0.5);
    font-size: 12.5px;
    cursor: pointer;
  }
  .dock-chip-btn-primary:hover {
    background: rgba(245, 158, 11, 0.35);
    border-color: rgba(245, 158, 11, 0.8);
    box-shadow: 0 4px 14px rgba(245, 158, 11, 0.3);
  }

  /* Mobile Responsiveness */
  @media (max-width: 640px) {
    .floating-dock-container {
      bottom: 16px !important;
      max-width: calc(100vw - 24px) !important;
    }
    .dock-glass-content {
      padding: 8px 12px !important;
      gap: 8px !important;
      max-width: 100% !important;
      box-sizing: border-box !important;
    }
    .dock-badge-wrapper {
      padding-right: 8px !important;
      font-size: 11.5px !important;
      gap: 6px !important;
    }
    .dock-winner-text {
      font-size: 11px !important;
      max-width: 155px !important;
      overflow: hidden !important;
      text-overflow: ellipsis !important;
      white-space: nowrap !important;
      display: inline-block !important;
    }
    .dock-chip-btn {
      padding: 4px 10px !important;
      font-size: 11.5px !important;
    }
    .dock-link-hide-mobile {
      display: none !important;
    }
  }

  @media (max-width: 380px) {
    .dock-winner-text {
      max-width: 115px !important;
    }
    .dock-sub-val {
      display: none !important;
    }
  }
</style>
