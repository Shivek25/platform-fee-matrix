<!-- ─────────────────────────────────────────────────────────────
     Calculator JavaScript: Live exchange rate & currency engine
     ───────────────────────────────────────────────────────── -->
<script>
  // ── Currency Definitions & Live Rates ────────────────────────
  interface CurrencyConfig {
    symbol: string;
    code: string;
    locale: string;
    rate: number; // 1 USD = rate units
  }

  const CURRENCIES: Record<string, CurrencyConfig> = {
    USD: { symbol: "$", code: "USD", locale: "en-US", rate: 1.0 },
    EUR: { symbol: "€", code: "EUR", locale: "de-DE", rate: 0.8688 },
    GBP: { symbol: "£", code: "GBP", locale: "en-GB", rate: 0.7446 },
    INR: { symbol: "₹", code: "INR", locale: "en-IN", rate: 95.69 },
    CAD: { symbol: "C$", code: "CAD", locale: "en-CA", rate: 1.4018 },
    AUD: { symbol: "A$", code: "AUD", locale: "en-AU", rate: 1.4270 },
  };

  let selectedCurrency = "USD";

  // ── Formatters ───────────────────────────────────────────────
  const fmt = (n: number) => {
    const cfg = CURRENCIES[selectedCurrency] || CURRENCIES.USD;
    const absVal = Math.abs(n);
    const formattedNum = absVal.toLocaleString(cfg.locale, {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    });
    const prefix = n < 0 ? "−" : "";
    return `${prefix}${cfg.symbol}${formattedNum}`;
  };

  const fmtCompact = (n: number) => {
    const cfg = CURRENCIES[selectedCurrency] || CURRENCIES.USD;
    const absVal = Math.abs(n);
    const sign = n < 0 ? "−" : "";

    if (selectedCurrency === "INR") {
      if (absVal >= 10000000) {
        const val = absVal / 10000000;
        const formatted = val % 1 === 0 ? val.toFixed(0) : val.toFixed(2).replace(/\.00$/, "");
        return `(≈ ${sign}${cfg.symbol}${formatted} Cr)`;
      }
      if (absVal >= 100000) {
        const val = absVal / 100000;
        const formatted = val % 1 === 0 ? val.toFixed(0) : val.toFixed(2).replace(/\.00$/, "");
        return `(≈ ${sign}${cfg.symbol}${formatted} L)`;
      }
      if (absVal >= 1000) {
        const val = absVal / 1000;
        const formatted = val % 1 === 0 ? val.toFixed(0) : val.toFixed(1).replace(/\.0$/, "");
        return `(≈ ${sign}${cfg.symbol}${formatted} K)`;
      }
      return `(≈ ${sign}${cfg.symbol}${absVal.toFixed(0)})`;
    } else {
      if (absVal >= 1000000000) {
        const val = absVal / 1000000000;
        const formatted = val % 1 === 0 ? val.toFixed(0) : val.toFixed(2).replace(/\.00$/, "");
        return `(≈ ${sign}${cfg.symbol}${formatted}B)`;
      }
      if (absVal >= 1000000) {
        const val = absVal / 1000000;
        const formatted = val % 1 === 0 ? val.toFixed(0) : val.toFixed(2).replace(/\.00$/, "");
        return `(≈ ${sign}${cfg.symbol}${formatted}M)`;
      }
      if (absVal >= 1000) {
        const val = absVal / 1000;
        const formatted = val % 1 === 0 ? val.toFixed(0) : val.toFixed(1).replace(/\.0$/, "");
        return `(≈ ${sign}${cfg.symbol}${formatted}K)`;
      }
      return `(≈ ${sign}${cfg.symbol}${absVal.toFixed(0)})`;
    }
  };

  const pct = (n: number) => `${(n * 100).toFixed(1)}%`;

  function el(id: string): HTMLElement | null {
    return document.getElementById(id);
  }

  function setText(id: string, val: string) {
    const e = el(id);
    if (e) e.textContent = val;
  }

  // ── State (Base USD values) ──────────────────────────────────
  let price = 25; // Base price or Target Net in USD
  let volume = 50;
  let intl = false;
  let paypal = false;
  let gumroadDiscover = false;
  let isPhysical = false;
  let cogs = 0; // Base USD
  let shippingCharge = 0; // Base USD
  let shippingCost = 0; // Base USD
  let activeFilter = "all";
  let activeSort = "net-desc";
  let calcMode: "standard" | "reverse" = "standard";
  let lastSnapshot: any = null;

  interface PresetItem {
    title: string;
    price: number;
    volume: number;
    cogs?: number;
    shippingCharge?: number;
    shippingCost?: number;
  }

  const PRESETS: Record<"standard" | "reverse", { digital: PresetItem[]; physical: PresetItem[] }> = {
    standard: {
      digital: [
        { title: "Micro-Template", price: 5, volume: 100 },
        { title: "Ebook", price: 29, volume: 50 },
        { title: "Course", price: 149, volume: 20 },
        { title: "SaaS", price: 49, volume: 30 },
      ],
      physical: [
        { title: "Handmade Craft", price: 35, volume: 40, cogs: 8, shippingCharge: 5, shippingCost: 4.5 },
        { title: "Apparel / Merch", price: 28, volume: 80, cogs: 9, shippingCharge: 4.99, shippingCost: 4.5 },
        { title: "Hardware / Tech", price: 120, volume: 25, cogs: 42, shippingCharge: 9.99, shippingCost: 9 },
        { title: "Print-on-Demand", price: 24, volume: 60, cogs: 12, shippingCharge: 0, shippingCost: 4.5 },
      ],
    },
    reverse: {
      digital: [
        { title: "Micro Target", price: 3, volume: 100 },
        { title: "Ebook Target", price: 25, volume: 50 },
        { title: "Course Target", price: 120, volume: 20 },
        { title: "High Ticket", price: 250, volume: 10 },
      ],
      physical: [
        { title: "Craft ($15 Net)", price: 15, volume: 40, cogs: 8, shippingCharge: 5, shippingCost: 4.5 },
        { title: "Merch ($12 Net)", price: 12, volume: 80, cogs: 9, shippingCharge: 4.99, shippingCost: 4.5 },
        { title: "Tech ($50 Net)", price: 50, volume: 25, cogs: 42, shippingCharge: 9.99, shippingCost: 9 },
        { title: "POD ($8 Net)", price: 8, volume: 60, cogs: 12, shippingCharge: 0, shippingCost: 4.5 },
      ],
    },
  };

  function solvePrice(targetNet: number, feePercent: number, fixedFeePerUnit: number, unitCost: number = 0): number {
    if (feePercent >= 1) return targetNet + unitCost;
    return (targetNet + fixedFeePerUnit + unitCost) / (1 - feePercent);
  }

  // ── Fee Formulas ───────────────────────────────────────────────
  function calcGumroad(p: number, intl: boolean, pp: boolean, discover: boolean, rate: number) {
    if (discover) {
      const platformCut = p * 0.30;
      return { gross: p, fees: platformCut, net: p - platformCut };
    }
    const platformCut = p * 0.10 + 0.50 * rate;
    const proc = (0.029 + (intl ? 0.015 : 0)) * p + 0.30 * rate;
    const totalProc = pp ? (0.0349 * p + 0.49 * rate) : proc;
    const totalFees = platformCut + totalProc;
    return { gross: p, fees: totalFees, net: p - totalFees };
  }

  function calcLemonSqueezy(p: number, intl: boolean, pp: boolean, rate: number) {
    const platformCut = p * 0.05 + 0.50 * rate;
    const intlExtra = intl ? p * 0.015 : 0;
    const paypalExtra = pp ? p * 0.015 : 0;
    const totalFees = platformCut + intlExtra + paypalExtra;
    return { gross: p, fees: totalFees, net: p - totalFees };
  }

  function calcPaddle(p: number, intl: boolean, rate: number) {
    const platformCut = p * 0.05 + 0.50 * rate;
    const intlExtra = intl ? p * 0.015 : 0;
    const totalFees = platformCut + intlExtra;
    return { gross: p, fees: totalFees, net: p - totalFees };
  }

  function calcProcFee(p: number, intl: boolean, pp: boolean, rate: number) {
    if (pp) return 0.0349 * p + 0.49 * rate;
    return (0.029 + (intl ? 0.015 : 0)) * p + 0.30 * rate;
  }

  function calcPayhip(p: number, vol: number, intl: boolean, pp: boolean, rate: number) {
    const proc = calcProcFee(p, intl, pp, rate);

    const freeFees = p * 0.05 + proc;
    const freeNet = p - freeFees;

    const plusMonthlyCost = 29 * rate;
    const plusTxFees = p * 0.02 + proc;
    const plusNetPerUnit = p - plusTxFees - plusMonthlyCost / vol;
    const plusFees = p - plusNetPerUnit;

    const proMonthlyCost = 99 * rate;
    const proTxFees = proc;
    const proNetPerUnit = p - proTxFees - proMonthlyCost / vol;
    const proFees = p - proNetPerUnit;

    return {
      free: { fees: freeFees, net: freeNet, totalFees: freeFees * vol, totalNet: freeNet * vol },
      plus: { fees: plusFees, net: plusNetPerUnit, totalFees: plusFees * vol, totalNet: plusNetPerUnit * vol },
      pro: { fees: proFees, net: proNetPerUnit, totalFees: proFees * vol, totalNet: proNetPerUnit * vol },
    };
  }

  function calcStripe(p: number, intl: boolean, pp: boolean, rate: number) {
    const proc = calcProcFee(p, intl, pp, rate);
    return { gross: p, fees: proc, net: p - proc };
  }

  function calcWhop(p: number, intl: boolean, pp: boolean, rate: number) {
    const platformCut = p * 0.03;
    const proc = calcProcFee(p, intl, pp, rate);
    const totalFees = platformCut + proc;
    return { gross: p, fees: totalFees, net: p - totalFees };
  }

  function calcSellfy(p: number, vol: number, intl: boolean, pp: boolean, rate: number) {
    const proc = calcProcFee(p, intl, pp, rate);
    const monthlyCost = 29 * rate;
    const feesPerUnit = proc + monthlyCost / vol;
    const netPerUnit = p - feesPerUnit;
    return { gross: p, fees: feesPerUnit, net: netPerUnit };
  }

  function calcPodia(p: number, vol: number, intl: boolean, pp: boolean, rate: number) {
    const proc = calcProcFee(p, intl, pp, rate);
    const monthlyCost = 39 * rate;
    const feesPerUnit = proc + monthlyCost / vol;
    const netPerUnit = p - feesPerUnit;
    return { gross: p, fees: feesPerUnit, net: netPerUnit };
  }

  function calcStan(p: number, vol: number, intl: boolean, pp: boolean, rate: number) {
    const proc = calcProcFee(p, intl, pp, rate);
    const monthlyCost = 29 * rate;
    const feesPerUnit = proc + monthlyCost / vol;
    const netPerUnit = p - feesPerUnit;
    return { gross: p, fees: feesPerUnit, net: netPerUnit };
  }

  function calcTeachable(p: number, vol: number, intl: boolean, pp: boolean, rate: number) {
    const proc = calcProcFee(p, intl, pp, rate);

    const basicMonthlyCost = 39 * rate;
    const basicTxFees = p * 0.05 + proc;
    const basicNetPerUnit = p - basicTxFees - basicMonthlyCost / vol;
    const basicFees = p - basicNetPerUnit;

    const proMonthlyCost = 119 * rate;
    const proTxFees = proc;
    const proNetPerUnit = p - proTxFees - proMonthlyCost / vol;
    const proFees = p - proNetPerUnit;

    return {
      basic: { fees: basicFees, net: basicNetPerUnit, totalFees: basicFees * vol, totalNet: basicNetPerUnit * vol },
      pro: { fees: proFees, net: proNetPerUnit, totalFees: proFees * vol, totalNet: proNetPerUnit * vol },
    };
  }

  function calcFiverr(p: number) {
    const fees = p * 0.20;
    return { gross: p, fees, net: p - fees };
  }

  function calcEtsy(p: number, intl: boolean, rate: number) {
    const listingFee = 0.20 * rate;
    const txFee = p * 0.065;
    const procFee = p * (0.03 + (intl ? 0.025 : 0)) + 0.25 * rate;
    const totalFees = listingFee + txFee + procFee;
    return { gross: p, fees: totalFees, net: p - totalFees };
  }

  function calcKDP(p: number, rate: number) {
    const platformCut = p * 0.30;
    const deliveryFee = 0.15 * rate;
    const totalFees = platformCut + deliveryFee;
    return { gross: p, fees: totalFees, net: p - totalFees };
  }

  function calcUpwork(p: number) {
    const fees = p * 0.10;
    return { gross: p, fees, net: p - fees };
  }

  // ── Render / Recalculate Matrix ──────────────────────────────
  function update() {
    const curr = CURRENCIES[selectedCurrency] || CURRENCIES.USD;
    const rate = curr.rate;
    const convPrice = price * rate;
    const isReverse = calcMode === "reverse";

    const convCogs = isPhysical ? cogs * rate : 0;
    const convShipCharge = isPhysical ? shippingCharge * rate : 0;
    const convShipCost = isPhysical ? shippingCost * rate : 0;
    const unitDirectCost = convCogs + convShipCost;
    const totalDirectCosts = unitDirectCost * volume;

    // Standard mode transaction price per unit paid by buyer
    const buyerPaidPerUnit = isPhysical ? (convPrice + convShipCharge) : convPrice;
    const standardGross = buyerPaidPerUnit * volume;

    const targetNetPerUnit = convPrice;
    const totalTargetNet = targetNetPerUnit * volume;

    // Show/hide COGS & shipping panel
    const cogsPanel = el("cogs-shipping-panel");
    if (cogsPanel) {
      cogsPanel.style.display = isPhysical ? "block" : "none";
    }

    // Show/hide card rows for direct costs and margin
    document.querySelectorAll(".card-row-costs").forEach((elem) => {
      (elem as HTMLElement).style.display = isPhysical ? "flex" : "none";
    });
    document.querySelectorAll(".card-row-margin").forEach((elem) => {
      (elem as HTMLElement).style.display = isPhysical ? "flex" : "none";
    });

    // Update input values and currency symbols in COGS panel
    setText("cogs-symbol", curr.symbol);
    setText("ship-charge-symbol", curr.symbol);
    setText("ship-cost-symbol", curr.symbol);

    const cInput = el("input-cogs") as HTMLInputElement | null;
    if (cInput && document.activeElement !== cInput) {
      cInput.value = (cogs * rate).toFixed(2).replace(/\.00$/, "");
    }
    const scInput = el("input-shipping-charge") as HTMLInputElement | null;
    if (scInput && document.activeElement !== scInput) {
      scInput.value = (shippingCharge * rate).toFixed(2).replace(/\.00$/, "");
    }
    const sCostInput = el("input-shipping-cost") as HTMLInputElement | null;
    if (sCostInput && document.activeElement !== sCostInput) {
      sCostInput.value = (shippingCost * rate).toFixed(2).replace(/\.00$/, "");
    }

    // Update COGS live summary strip
    if (isReverse) {
      setText("cogs-strip-buyer-paid", `Target: ${fmt(targetNetPerUnit)}/unit net`);
    } else {
      setText("cogs-strip-buyer-paid", `${fmt(buyerPaidPerUnit)} (${fmt(convPrice)} + ${fmt(convShipCharge)} ship)`);
    }
    setText("cogs-strip-direct-cost", `−${fmt(unitDirectCost)} / unit`);
    setText("cogs-strip-total-costs", `−${fmt(totalDirectCosts)} (${volume} units)`);

    // Update Card Row Labels
    document.querySelectorAll(".card-row-lbl-gross").forEach((el) => {
      el.textContent = isReverse ? "Target Net (Total)" : "Gross Revenue";
    });
    document.querySelectorAll(".card-row-lbl-net").forEach((el) => {
      el.textContent = isReverse ? "Required Price" : "Net Profit";
    });

    // Update Live Exchange Rate Badge
    const rateBadge = el("exchange-rate-badge");
    if (rateBadge) {
      if (selectedCurrency === "USD") {
        rateBadge.textContent = "🟢 Live rate: 1 USD = 1.00 USD (Base)";
      } else {
        rateBadge.textContent = `🟢 Live rate: 1 USD = ${rate.toFixed(4)} ${selectedCurrency}`;
      }
    }

    // Update Input value to show converted price (without stealing active focus)
    const pInput = el("price-input") as HTMLInputElement | null;
    if (pInput && document.activeElement !== pInput) {
      pInput.value = convPrice.toFixed(2).replace(/\.00$/, "");
    }

    // Update Currency Labels & Subtitles
    setText("price-symbol-label", curr.symbol);
    setText("price-min-label", fmt(1 * rate));
    const pSlider = el("price-slider") as HTMLInputElement | null;
    if (pSlider) setText("price-max-label", fmt(Number(pSlider.max) * rate));
    const vSlider = el("volume-slider") as HTMLInputElement | null;
    if (vSlider) setText("volume-max-label", Number(vSlider.max).toLocaleString());

    setText("paypal-toggle-desc", `3.49% + ${fmt(0.49 * rate)} per transaction`);
    setText("gumroad-toggle-desc", `Switch to marketplace (30% cut) vs. Direct (10% + ${fmt(0.50 * rate)})`);

    // Update Presets Meta Text & Data attributes
    const presetType = isPhysical ? "physical" : "digital";
    const currentPresets = PRESETS[calcMode][presetType];
    currentPresets.forEach((p, idx) => {
      setText(`preset-title-${idx + 1}`, p.title);
      if (isPhysical) {
        setText(`preset-meta-${idx + 1}`, `${fmt(p.price * rate)} · COGS ${fmt((p.cogs || 0) * rate)}`);
      } else {
        setText(`preset-meta-${idx + 1}`, `${fmt(p.price * rate)} × ${p.volume} sales`);
      }
      const btn = el(`preset-btn-${idx + 1}`);
      if (btn) {
        btn.setAttribute("data-price", String(p.price));
        btn.setAttribute("data-volume", String(p.volume));
        btn.setAttribute("data-cogs", String(p.cogs ?? 0));
        btn.setAttribute("data-ship-charge", String(p.shippingCharge ?? 0));
        btn.setAttribute("data-ship-cost", String(p.shippingCost ?? 0));
      }
    });

    const highlightTier = (id: string, active: boolean) => {
      const row = el(id);
      if (!row) return;
      row.style.background = active ? "var(--color-profit-bg)" : "";
      row.style.borderColor = active ? "var(--color-profit)" : "var(--border-hairline)";
    };

    // Helper to format net subtext in reverse mode
    const formatReverseSubtext = (gross: number, reqTotalPaid: number) => {
      if (isPhysical) {
        if (convShipCharge > 0) {
          return `(Gross ${fmtCompact(gross)} · +${fmt(convShipCharge)} ship)`;
        }
        return `(Gross ${fmtCompact(gross)} · Free ship)`;
      }
      return `(Gross ${fmtCompact(gross)})`;
    };

    // 1. Gumroad
