---
// Calculator.astro: Interactive multi-platform net margin calculator
// Dynamic Live Currency Engine: Fetches real-time exchange rates & converts all figures
---

<section
  id="calculator"
  class="calc-section"
  style="padding: 80px 24px; background: var(--bg-page);"
>
  <div style="max-width: 1200px; margin: 0 auto;">
    <!-- Section header -->
    <div style="text-align: center; margin-bottom: 40px;">
      <p
        style="
        font-family: var(--font-mono);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--text-mute);
        margin: 0 0 12px;
      "
      >
        Real-time Calculator
      </p>
      <h2
        style="
        font-size: clamp(28px, 4vw, 40px);
        font-weight: 600;
        letter-spacing: -1.5px;
        color: var(--text-ink);
        margin: 0 0 16px;
        line-height: 1.1;
      "
      >
        Compare platform fees instantly.
      </h2>
      <p
        style="
        font-size: 17px;
        color: var(--text-body);
        max-width: 540px;
        margin: 0 auto 24px;
        line-height: 1.6;
      "
      >
        Adjust price, volume, and payment options to see exact take-home profit
        across 10 top creator platforms with live currency conversion.
      </p>

      <!-- Currency Selector Bar & Live Exchange Rate Indicator -->
      <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px;">
        <div style="display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap;">
          <span style="font-size: 13px; color: var(--text-mute); font-weight: 500;">Currency:</span>
          <div id="currency-selector" class="currency-selector-box">
            <button type="button" class="curr-btn active" data-curr="USD">$ USD</button>
            <button type="button" class="curr-btn" data-curr="EUR">€ EUR</button>
            <button type="button" class="curr-btn" data-curr="GBP">£ GBP</button>
            <button type="button" class="curr-btn" data-curr="INR">₹ INR</button>
            <button type="button" class="curr-btn" data-curr="CAD">C$ CAD</button>
            <button type="button" class="curr-btn" data-curr="AUD">A$ AUD</button>
          </div>
        </div>
        <div id="exchange-rate-badge" style="font-size: 11px; font-family: var(--font-mono); color: var(--color-emerald-profit); background: rgba(16, 185, 129, 0.1); padding: 3px 12px; border-radius: 100px; border: 1px solid rgba(16, 185, 129, 0.25);">
          🟢 Live rate: 1 USD = 1.00 USD (Base)
        </div>
      </div>
    </div>

    <!-- ─── Controls Panel ─────────────────────────── -->
    <div class="card-base sticky-controls-card" style="padding: 28px 32px; margin-bottom: 32px;">
      <!-- Quick Presets Row -->
      <div style="margin-bottom: 28px; padding-bottom: 20px; border-bottom: 1px solid var(--border-hairline);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;">
          <span style="font-size: 13px; font-weight: 600; color: var(--text-ink); text-transform: uppercase; letter-spacing: 0.05em; font-family: var(--font-mono);">
            ⚡ 1-Click Quick Presets
          </span>
          <span style="font-size: 12px; color: var(--text-mute);">Select a creator model to auto-fill</span>
        </div>
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px;" id="preset-buttons" class="preset-grid">
          <button type="button" class="preset-btn" data-price="5" data-volume="100">
            <span class="preset-title">Micro-Template</span>
            <span class="preset-meta" id="preset-meta-1">$5.00 × 100 sales</span>
          </button>
          <button type="button" class="preset-btn" data-price="29" data-volume="50">
            <span class="preset-title">Ebook</span>
            <span class="preset-meta" id="preset-meta-2">$29.00 × 50 sales</span>
          </button>
          <button type="button" class="preset-btn" data-price="149" data-volume="20">
            <span class="preset-title">Course</span>
            <span class="preset-meta" id="preset-meta-3">$149.00 × 20 sales</span>
          </button>
          <button type="button" class="preset-btn" data-price="49" data-volume="30">
            <span class="preset-title">SaaS</span>
            <span class="preset-meta" id="preset-meta-4">$49.00 × 30 sales</span>
          </button>
        </div>
      </div>

      <!-- Sliders row -->
      <div
        style="
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        margin-bottom: 32px;
      "
        class="controls-grid"
      >
        <!-- Price slider -->
        <div>
          <div
            class="slider-header-row"
            style="display: flex; justify-content: space-between; align-items: flex-end; min-height: 36px; margin-bottom: 12px;"
          >
            <label
              for="price-slider"
              class="slider-label"
              style="font-size: 14px; font-weight: 500; color: var(--text-ink); white-space: nowrap;"
            >
              Product Price
            </label>
            <div style="display: flex; align-items: center; gap: 4px;">
              <span id="price-symbol-label" style="font-size: 14px; color: var(--text-body);">$</span>
              <input
                type="number"
                id="price-input"
                min="1"
                value="25"
                step="any"
                style="
                  width: 110px;
                  height: 32px;
                  padding: 0 8px;
                  font-size: 14px;
                  font-weight: 600;
                  color: var(--text-ink);
                  background: var(--bg-input);
                  border: 1px solid var(--border-hairline);
                  border-radius: 6px;
                  text-align: right;
                  font-family: var(--font-mono);
                "
              />
            </div>
          </div>
          <input
            type="range"
            id="price-slider"
            min="1"
            max="5000"
            value="25"
            step="1"
            aria-label="Product price slider"
          />
          <div
            style="display: flex; justify-content: space-between; margin-top: 6px;"
          >
            <span id="price-min-label" style="font-size: 12px; color: var(--text-mute);">$1.00</span>
            <span id="price-max-label" style="font-size: 12px; color: var(--text-mute);">$5,000.00</span>
          </div>
        </div>

        <!-- Volume slider -->
        <div>
          <div
            class="slider-header-row"
            style="display: flex; justify-content: space-between; align-items: flex-end; min-height: 36px; margin-bottom: 12px;"
          >
            <label
              for="volume-slider"
              class="slider-label"
              style="font-size: 14px; font-weight: 500; color: var(--text-ink); white-space: nowrap;"
            >
              Monthly Sales
            </label>
            <div style="display: flex; align-items: center; gap: 4px;">
              <input
                type="number"
                id="volume-input"
                min="1"
                value="50"
                style="
                  width: 100px;
                  height: 32px;
                  padding: 0 8px;
                  font-size: 14px;
                  font-weight: 600;
                  color: var(--text-ink);
                  background: var(--bg-input);
                  border: 1px solid var(--border-hairline);
                  border-radius: 6px;
                  text-align: right;
                  font-family: var(--font-mono);
                "
              />
              <span style="font-size: 14px; color: var(--text-body);"
                >units</span
              >
            </div>
          </div>
          <input
            type="range"
            id="volume-slider"
            min="1"
            max="5000"
            value="50"
            step="1"
            aria-label="Monthly sales volume slider"
          />
          <div
            style="display: flex; justify-content: space-between; margin-top: 6px;"
          >
            <span style="font-size: 12px; color: var(--text-mute);">1</span>
            <span id="volume-max-label" style="font-size: 12px; color: var(--text-mute);">5,000</span>
          </div>
        </div>
      </div>

      <!-- Toggles row -->
      <div
        style="
        border-top: 1px solid var(--border-hairline);
        padding-top: 24px;
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
      "
        class="toggles-row"
      >
        <!-- International cards -->
        <label
          style="display: flex; align-items: center; gap: 12px; cursor: pointer;"
        >
          <span class="toggle-switch">
            <input
              type="checkbox"
              id="toggle-intl"
              role="switch"
              aria-label="International card surcharge toggle"
            />
            <span class="toggle-track"></span>
            <span class="toggle-thumb"></span>
          </span>
          <span style="display: flex; flex-direction: column; gap: 2px;">
            <span
              style="font-size: 13px; font-weight: 500; color: var(--text-ink);"
              >International Cards</span
            >
            <span style="font-size: 12px; color: var(--text-mute);"
              >+1.5% surcharge on card fees</span
            >
          </span>
        </label>

        <!-- PayPal processing -->
        <label
          style="display: flex; align-items: center; gap: 12px; cursor: pointer;"
        >
          <span class="toggle-switch">
            <input
              type="checkbox"
              id="toggle-paypal"
              role="switch"
              aria-label="PayPal processing toggle"
            />
            <span class="toggle-track"></span>
            <span class="toggle-thumb"></span>
          </span>
          <span style="display: flex; flex-direction: column; gap: 2px;">
            <span
              style="font-size: 13px; font-weight: 500; color: var(--text-ink);"
              >PayPal Processing</span
            >
            <span style="font-size: 12px; color: var(--text-mute);" id="paypal-toggle-desc"
              >3.49% + $0.49 per transaction</span
            >
          </span>
        </label>

        <!-- Gumroad mode -->
        <label
          style="display: flex; align-items: center; gap: 12px; cursor: pointer;"
        >
          <span class="toggle-switch">
            <input
              type="checkbox"
              id="toggle-gumroad-mode"
              role="switch"
              aria-label="Gumroad Discover marketplace toggle"
            />
            <span class="toggle-track"></span>
            <span class="toggle-thumb"></span>
          </span>
          <span style="display: flex; flex-direction: column; gap: 2px;">
            <span
              style="font-size: 13px; font-weight: 500; color: var(--text-ink);"
              >Gumroad Discover</span
            >
            <span style="font-size: 12px; color: var(--text-mute);" id="gumroad-toggle-desc"
              >Switch to marketplace (30% cut) vs. Direct (10% + $0.50)</span
            >
          </span>
        </label>
      </div>
    </div>

    <!-- ─── Matrix Toolbar: Filter Tabs & Sorting ────── -->
    <div
      style="
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 24px;
        background: var(--bg-card-soft);
        padding: 12px 20px;
        border-radius: var(--radius-lg);
        border: 1px solid var(--border-hairline);
      "
      class="matrix-toolbar"
    >
      <!-- Filter Tabs -->
      <div style="display: flex; align-items: center; justify-content: center; gap: 8px 6px; flex-wrap: wrap;" id="filter-tabs" class="matrix-filter-tabs">
        <button type="button" class="filter-tab active" data-filter="all">All Platforms (14)</button>
        <button type="button" class="filter-tab" data-filter="mor">Auto-Tax (MoR)</button>
        <button type="button" class="filter-tab" data-filter="direct">Direct Gateways</button>
        <button type="button" class="filter-tab" data-filter="monthly">Fixed Monthly Plans</button>
        <button type="button" class="filter-tab" data-filter="marketplace">Marketplace & Freelance</button>
      </div>

      <!-- Sorting Selector -->
      <div style="display: flex; align-items: center; justify-content: center; gap: 8px;" class="matrix-sort-group">
        <label for="sort-select" style="font-size: 13px; color: var(--text-mute); font-weight: 500;">Sort By:</label>
        <select
          id="sort-select"
          style="
            background: var(--bg-input);
            color: var(--text-ink);
            border: 1px solid var(--border-hairline);
            border-radius: 8px;
            padding: 6px 12px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            outline: none;
            font-family: var(--font-sans);
          "
        >
          <option value="net-desc">Highest Take-Home</option>
          <option value="rate-asc">Lowest Effective Fee %</option>
          <option value="name-asc">Alphabetical</option>
        </select>
      </div>
    </div>

    <!-- ─── Platform Cards Grid ─────────────────────── -->
    <div
      id="platforms"
      style="
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    "
      class="platforms-grid"
      aria-live="polite"
      aria-label="Platform fee comparison"
    >
      <!-- ─── GUMROAD ─── -->
      <div
        class="card-base platform-card"
        id="card-gumroad"
        data-categories="direct"
        data-name="Gumroad"
        style="padding: 24px;"
      >
        <div
          style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 16px;"
        >
          <div>
            <div
              style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;"
            >
              <img src="/icons/gumroad.svg" width="20" height="20" alt="Gumroad" style="border-radius: 4px;" />
              <h3
                style="font-size: 15px; font-weight: 600; color: var(--text-ink); margin: 0; letter-spacing: -0.3px;"
              >
                Gumroad
              </h3>
            </div>
            <p
              id="gumroad-mode-label"
              style="font-size: 12px; color: var(--text-mute); margin: 0; font-family: var(--font-mono);"
            >
              Direct: 10% + $0.50
            </p>
          </div>
          <div
            style="display: flex; flex-direction: column; gap: 4px; align-items: flex-end;"
          >
            <span class="badge badge-tax">Self-File Taxes</span>
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 12px;">
          <div
            style="display: flex; justify-content: space-between; align-items: baseline;"
          >
            <span style="font-size: 13px; color: var(--text-mute);"
              >Gross Revenue</span
            >
            <span
              id="gumroad-gross"
              style="font-size: 13px; font-weight: 500; color: var(--text-ink); font-family: var(--font-mono);"
              >$1,250.00</span
            >
          </div>
          <div
            style="display: flex; justify-content: space-between; align-items: baseline;"
          >
            <span style="font-size: 13px; color: var(--text-mute);"
              >Platform & Fees</span
            >
            <span
              id="gumroad-fees"
              style="font-size: 13px; font-weight: 500; color: var(--color-error); font-family: var(--font-mono);"
              >−$235.00</span
            >
          </div>
          <div style="height: 1px; background: var(--border-hairline);"></div>
          <div
            style="display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; border-radius: 8px; background: var(--color-profit-bg);"
          >
            <span
              style="font-size: 14px; font-weight: 600; color: var(--color-profit);"
              >Net Profit</span
            >
            <div style="text-align: right; display: flex; flex-direction: column; align-items: flex-end;">
              <span
                id="gumroad-net"
                style="font-size: 17px; font-weight: 700; color: var(--color-profit); font-family: var(--font-mono); letter-spacing: -0.5px;"
                >$1,015.00</span
              >
              <span
                id="gumroad-net-compact"
                style="font-size: 11px; font-weight: 600; color: var(--color-profit); opacity: 0.85; font-family: var(--font-mono); margin-top: 1px;"
                >(≈ $1K)</span
              >
            </div>
          </div>
          <div
            style="display: flex; justify-content: space-between; align-items: center;"
          >
            <span style="font-size: 12px; color: var(--text-mute);"
              >Effective fee rate</span
            >
            <span
              id="gumroad-rate"
              style="font-size: 13px; font-weight: 600; color: var(--text-ink); font-family: var(--font-mono);"
              >18.8%</span
            >
          </div>
        </div>
      </div>

      <!-- ─── LEMON SQUEEZY ─── -->
      <div
        class="card-base platform-card"
        id="card-lemonsqueezy"
        data-categories="mor"
        data-name="Lemon Squeezy"
        style="padding: 24px;"
      >
        <div
          style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 16px;"
        >
          <div>
            <div
              style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;"
            >
              <img src="/icons/lemonsqueezy.svg" width="20" height="20" alt="Lemon Squeezy" style="border-radius: 4px;" />
              <h3
                style="font-size: 15px; font-weight: 600; color: var(--text-ink); margin: 0; letter-spacing: -0.3px;"
              >
                Lemon Squeezy
              </h3>
            </div>
            <p
              style="font-size: 12px; color: var(--text-mute); margin: 0; font-family: var(--font-mono);"
              id="ls-subtitle"
            >
              5% + $0.50 per sale
            </p>
          </div>
          <div
            style="display: flex; flex-direction: column; gap: 4px; align-items: flex-end;"
          >
            <span class="badge badge-mor">MoR (Auto-Tax)</span>
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 12px;">
          <div
            style="display: flex; justify-content: space-between; align-items: baseline;"
          >
            <span style="font-size: 13px; color: var(--text-mute);"
              >Gross Revenue</span
            >
            <span
              id="ls-gross"
              style="font-size: 13px; font-weight: 500; color: var(--text-ink); font-family: var(--font-mono);"
              >$1,250.00</span
            >
          </div>
          <div
            style="display: flex; justify-content: space-between; align-items: baseline;"
          >
            <span style="font-size: 13px; color: var(--text-mute);"
              >Platform & Fees</span
            >
            <span
              id="ls-fees"
              style="font-size: 13px; font-weight: 500; color: var(--color-error); font-family: var(--font-mono);"
              >−$87.50</span
            >
          </div>
          <div style="height: 1px; background: var(--border-hairline);"></div>
          <div
            style="display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; border-radius: 8px; background: var(--color-profit-bg);"
          >
            <span
              style="font-size: 14px; font-weight: 600; color: var(--color-profit);"
              >Net Profit</span
            >
            <div style="text-align: right; display: flex; flex-direction: column; align-items: flex-end;">
              <span
                id="ls-net"
                style="font-size: 17px; font-weight: 700; color: var(--color-profit); font-family: var(--font-mono); letter-spacing: -0.5px;"
                >$1,162.50</span
              >
              <span
                id="ls-net-compact"
                style="font-size: 11px; font-weight: 600; color: var(--color-profit); opacity: 0.85; font-family: var(--font-mono); margin-top: 1px;"
                >(≈ $1K)</span
              >
            </div>
          </div>
          <div
            style="display: flex; justify-content: space-between; align-items: center;"
          >
            <span style="font-size: 12px; color: var(--text-mute);"
              >Effective fee rate</span
            >
            <span
              id="ls-rate"
              style="font-size: 13px; font-weight: 600; color: var(--text-ink); font-family: var(--font-mono);"
              >7.0%</span
            >
          </div>
        </div>
      </div>

      <!-- ─── PADDLE ─── -->
      <div
        class="card-base platform-card"
        id="card-paddle"
        data-categories="mor"
        data-name="Paddle"
        style="padding: 24px;"
      >
        <div
          style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 16px;"
        >
          <div>
            <div
              style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;"
            >
              <img src="/icons/paddle.svg" width="20" height="20" alt="Paddle" style="border-radius: 4px;" />
              <h3
                style="font-size: 15px; font-weight: 600; color: var(--text-ink); margin: 0; letter-spacing: -0.3px;"
              >
                Paddle
              </h3>
            </div>
            <p
              style="font-size: 12px; color: var(--text-mute); margin: 0; font-family: var(--font-mono);"
              id="paddle-subtitle"
            >
              5% + $0.50 per sale · Auto VAT
            </p>
          </div>
          <div
            style="display: flex; flex-direction: column; gap: 4px; align-items: flex-end;"
          >
            <span class="badge badge-mor">MoR (Auto-Tax)</span>
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 12px;">
          <div
            style="display: flex; justify-content: space-between; align-items: baseline;"
          >
            <span style="font-size: 13px; color: var(--text-mute);"
              >Gross Revenue</span
            >
            <span
              id="paddle-gross"
              style="font-size: 13px; font-weight: 500; color: var(--text-ink); font-family: var(--font-mono);"
              >$1,250.00</span
            >
          </div>
          <div
            style="display: flex; justify-content: space-between; align-items: baseline;"
          >
            <span style="font-size: 13px; color: var(--text-mute);"
              >Platform & Fees</span
            >
            <span
              id="paddle-fees"
              style="font-size: 13px; font-weight: 500; color: var(--color-error); font-family: var(--font-mono);"
              >−$87.50</span
            >
          </div>
          <div style="height: 1px; background: var(--border-hairline);"></div>
          <div
            style="display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; border-radius: 8px; background: var(--color-profit-bg);"
          >
            <span
              style="font-size: 14px; font-weight: 600; color: var(--color-profit);"
              >Net Profit</span
            >
            <div style="text-align: right; display: flex; flex-direction: column; align-items: flex-end;">
              <span
                id="paddle-net"
                style="font-size: 17px; font-weight: 700; color: var(--color-profit); font-family: var(--font-mono); letter-spacing: -0.5px;"
                >$1,162.50</span
              >
              <span
                id="paddle-net-compact"
                style="font-size: 11px; font-weight: 600; color: var(--color-profit); opacity: 0.85; font-family: var(--font-mono); margin-top: 1px;"
                >(≈ $1K)</span
              >
            </div>
          </div>
          <div
            style="display: flex; justify-content: space-between; align-items: center;"
          >
            <span style="font-size: 12px; color: var(--text-mute);"
              >Effective fee rate</span
            >
            <span
              id="paddle-rate"
              style="font-size: 13px; font-weight: 600; color: var(--text-ink); font-family: var(--font-mono);"
              >7.0%</span
            >
          </div>
        </div>
      </div>

      <!-- ─── PAYHIP ─── -->
      <div
        class="card-base platform-card"
        id="card-payhip"
        data-categories="direct monthly"
