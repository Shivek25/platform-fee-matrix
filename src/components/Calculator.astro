      const tcBasicReqPrice = Math.max(0, tcBasicReqTotal - convShipCharge);
      const tcBasicGross = tcBasicReqTotal * volume;
      const tcBasicFees = tcBasicGross - totalTargetNet - totalDirectCosts;
      const tcBasicRate = tcBasicGross > 0 ? (tcBasicFees / tcBasicGross) : 0;

      const tcProReqTotal = solvePrice(targetNetPerUnit, tcProcRate, tcProcFixed + (119 * rate) / volume, unitDirectCost);
      const tcProReqPrice = Math.max(0, tcProReqTotal - convShipCharge);
      const tcProGross = tcProReqTotal * volume;
      const tcProFees = tcProGross - totalTargetNet - totalDirectCosts;
      const tcProRate = tcProGross > 0 ? (tcProFees / tcProGross) : 0;

      const tcReqPrices = [tcBasicReqPrice, tcProReqPrice];
      tcBestIdx = tcReqPrices.indexOf(Math.min(...tcReqPrices));
      tcBestReqPrice = tcReqPrices[tcBestIdx];
      const tcGrosses = [tcBasicGross, tcProGross];
      tcBestGross = tcGrosses[tcBestIdx];
      tcBestNet = totalTargetNet;
      tcBestRate = [tcBasicRate, tcProRate][tcBestIdx];
      tcBestMargin = tcBestGross > 0 ? (tcBestNet / tcBestGross) : 0;

      highlightTier("teachable-basic-row", tcBestIdx === 0);
      highlightTier("teachable-pro-row", tcBestIdx === 1);

      setText("teachable-subtitle", `Basic ${fmt(39 * rate)}/mo + 5% · Pro ${fmt(119 * rate)}/mo + 0%`);
      setText("teachable-basic-label", `Basic (${fmt(39 * rate)}/mo + 5%)`);
      setText("teachable-pro-label", `Pro (${fmt(119 * rate)}/mo + 0%)`);
      setText("teachable-basic-net", `Charge ${fmt(tcBasicReqPrice)}`);
      setText("teachable-basic-net-compact", formatReverseSubtext(tcBasicGross, tcBasicReqTotal));
      setText("teachable-basic-fees", fmt(tcBasicFees));
      setText("teachable-basic-rate", pct(tcBasicRate));
      setText("teachable-pro-net", `Charge ${fmt(tcProReqPrice)}`);
      setText("teachable-pro-net-compact", formatReverseSubtext(tcProGross, tcProReqTotal));
      setText("teachable-pro-fees", fmt(tcProFees));
      setText("teachable-pro-rate", pct(tcProRate));
      setText("teachable-costs", fmt(-totalDirectCosts));
      setText("teachable-margin", pct(tcBestMargin));
      setText("teachable-best-label", `↑ ${tcBestLabels[tcBestIdx]} lets you charge the lowest price`);
    } else {
      const tc = calcTeachable(buyerPaidPerUnit, volume, intl, paypal, rate);
      const tcBasicNet = (tc.basic.net - unitDirectCost) * volume;
      const tcProNet = (tc.pro.net - unitDirectCost) * volume;
      const tcNets = [tcBasicNet, tcProNet];

      tcBestIdx = tcNets.indexOf(Math.max(...tcNets));
      tcBestNet = tcNets[tcBestIdx];
      tcBestRate = [tc.basic.fees / buyerPaidPerUnit, tc.pro.fees / buyerPaidPerUnit][tcBestIdx];
      tcBestGross = standardGross;
      tcBestMargin = tcBestGross > 0 ? (tcBestNet / tcBestGross) : 0;
      tcBestReqPrice = convPrice;

      highlightTier("teachable-basic-row", tcBestIdx === 0);
      highlightTier("teachable-pro-row", tcBestIdx === 1);

      setText("teachable-subtitle", `Basic ${fmt(39 * rate)}/mo + 5% · Pro ${fmt(119 * rate)}/mo + 0%`);
      setText("teachable-basic-label", `Basic (${fmt(39 * rate)}/mo + 5%)`);
      setText("teachable-pro-label", `Pro (${fmt(119 * rate)}/mo + 0%)`);
      setText("teachable-basic-net", fmt(tcBasicNet));
      setText("teachable-basic-net-compact", fmtCompact(tcBasicNet));
      setText("teachable-basic-fees", fmt(tc.basic.totalFees));
      setText("teachable-basic-rate", pct(tc.basic.fees / buyerPaidPerUnit));
      setText("teachable-pro-net", fmt(tcProNet));
      setText("teachable-pro-net-compact", fmtCompact(tcProNet));
      setText("teachable-pro-fees", fmt(tc.pro.totalFees));
      setText("teachable-pro-rate", pct(tc.pro.fees / buyerPaidPerUnit));
      setText("teachable-costs", fmt(-totalDirectCosts));
      setText("teachable-margin", pct(tcBestMargin));
      setText("teachable-best-label", `↑ ${tcBestLabels[tcBestIdx]} is best at this volume`);
    }

    // 11. Fiverr
    let fvTotalNet: number, fvTotalFees: number, fvRate: number, fvMargin: number, fvGross: number, fvReqPrice: number;
    if (isReverse) {
      const reqTotalPaid = solvePrice(targetNetPerUnit, 0.20, 0, unitDirectCost);
      fvReqPrice = Math.max(0, reqTotalPaid - convShipCharge);
      fvGross = reqTotalPaid * volume;
      fvTotalFees = fvGross - totalTargetNet - totalDirectCosts;
      fvTotalNet = totalTargetNet;
      fvRate = fvGross > 0 ? (fvTotalFees / fvGross) : 0;
      fvMargin = fvGross > 0 ? (fvTotalNet / fvGross) : 0;

      setText("fiverr-subtitle", "20% flat seller fee · Buyer pays gateway fees");
      setText("fiverr-gross", fmt(totalTargetNet));
      setText("fiverr-fees", fmt(-fvTotalFees));
      setText("fiverr-costs", fmt(-totalDirectCosts));
      setText("fiverr-net", `Charge ${fmt(fvReqPrice)}`);
      setText("fiverr-net-compact", formatReverseSubtext(fvGross, reqTotalPaid));
      setText("fiverr-rate", pct(fvRate));
      setText("fiverr-margin", pct(fvMargin));
    } else {
      const fv = calcFiverr(buyerPaidPerUnit);
      fvTotalFees = fv.fees * volume;
      fvTotalNet = (fv.net - unitDirectCost) * volume;
      fvRate = buyerPaidPerUnit > 0 ? (fv.fees / buyerPaidPerUnit) : 0;
      fvGross = standardGross;
      fvMargin = fvGross > 0 ? (fvTotalNet / fvGross) : 0;
      fvReqPrice = convPrice;

      setText("fiverr-subtitle", "20% flat seller fee · Buyer pays gateway fees");
      setText("fiverr-gross", fmt(fvGross));
      setText("fiverr-fees", fmt(-fvTotalFees));
      setText("fiverr-costs", fmt(-totalDirectCosts));
      setText("fiverr-net", fmt(fvTotalNet));
      setText("fiverr-net-compact", fmtCompact(fvTotalNet));
      setText("fiverr-rate", pct(fvRate));
      setText("fiverr-margin", pct(fvMargin));
    }

    // 12. Etsy
    let etTotalNet: number, etTotalFees: number, etRate: number, etMargin: number, etGross: number, etReqPrice: number;
    if (isReverse) {
      const etFeePct = 0.065 + 0.03 + (intl ? 0.025 : 0);
      const etFixed = (0.20 + 0.25) * rate;
      const reqTotalPaid = solvePrice(targetNetPerUnit, etFeePct, etFixed, unitDirectCost);
      etReqPrice = Math.max(0, reqTotalPaid - convShipCharge);
      etGross = reqTotalPaid * volume;
      etTotalFees = etGross - totalTargetNet - totalDirectCosts;
      etTotalNet = totalTargetNet;
      etRate = etGross > 0 ? (etTotalFees / etGross) : 0;
      etMargin = etGross > 0 ? (etTotalNet / etGross) : 0;

      setText("etsy-subtitle", `${fmt(0.20 * rate)} listing + 6.5% + 3% + ${fmt(0.25 * rate)} card`);
      setText("etsy-gross", fmt(totalTargetNet));
      setText("etsy-fees", fmt(-etTotalFees));
      setText("etsy-costs", fmt(-totalDirectCosts));
      setText("etsy-net", `Charge ${fmt(etReqPrice)}`);
      setText("etsy-net-compact", formatReverseSubtext(etGross, reqTotalPaid));
      setText("etsy-rate", pct(etRate));
      setText("etsy-margin", pct(etMargin));
    } else {
      const et = calcEtsy(buyerPaidPerUnit, intl, rate);
      etTotalFees = et.fees * volume;
      etTotalNet = (et.net - unitDirectCost) * volume;
      etRate = buyerPaidPerUnit > 0 ? (et.fees / buyerPaidPerUnit) : 0;
      etGross = standardGross;
      etMargin = etGross > 0 ? (etTotalNet / etGross) : 0;
      etReqPrice = convPrice;

      setText("etsy-subtitle", `${fmt(0.20 * rate)} listing + 6.5% + 3% + ${fmt(0.25 * rate)} card`);
      setText("etsy-gross", fmt(etGross));
      setText("etsy-fees", fmt(-etTotalFees));
      setText("etsy-costs", fmt(-totalDirectCosts));
      setText("etsy-net", fmt(etTotalNet));
      setText("etsy-net-compact", fmtCompact(etTotalNet));
      setText("etsy-rate", pct(etRate));
      setText("etsy-margin", pct(etMargin));
    }

    // 13. Amazon KDP
    let kdTotalNet: number, kdTotalFees: number, kdRate: number, kdMargin: number, kdGross: number, kdReqPrice: number;
    if (isReverse) {
      const reqTotalPaid = solvePrice(targetNetPerUnit, 0.30, 0.15 * rate, unitDirectCost);
      kdReqPrice = Math.max(0, reqTotalPaid - convShipCharge);
      kdGross = reqTotalPaid * volume;
      kdTotalFees = kdGross - totalTargetNet - totalDirectCosts;
      kdTotalNet = totalTargetNet;
      kdRate = kdGross > 0 ? (kdTotalFees / kdGross) : 0;
      kdMargin = kdGross > 0 ? (kdTotalNet / kdGross) : 0;

      setText("kdp-subtitle", `30% fee (70% royalty) + ${fmt(0.15 * rate)}/MB · Amazon handles card fees`);
      setText("kdp-gross", fmt(totalTargetNet));
      setText("kdp-fees", fmt(-kdTotalFees));
      setText("kdp-costs", fmt(-totalDirectCosts));
      setText("kdp-net", `Charge ${fmt(kdReqPrice)}`);
      setText("kdp-net-compact", formatReverseSubtext(kdGross, reqTotalPaid));
      setText("kdp-rate", pct(kdRate));
      setText("kdp-margin", pct(kdMargin));
    } else {
      const kd = calcKDP(buyerPaidPerUnit, rate);
      kdTotalFees = kd.fees * volume;
      kdTotalNet = (kd.net - unitDirectCost) * volume;
      kdRate = buyerPaidPerUnit > 0 ? (kd.fees / buyerPaidPerUnit) : 0;
      kdGross = standardGross;
      kdMargin = kdGross > 0 ? (kdTotalNet / kdGross) : 0;
      kdReqPrice = convPrice;

      setText("kdp-subtitle", `30% fee (70% royalty) + ${fmt(0.15 * rate)}/MB · Amazon handles card fees`);
      setText("kdp-gross", fmt(kdGross));
      setText("kdp-fees", fmt(-kdTotalFees));
      setText("kdp-costs", fmt(-totalDirectCosts));
      setText("kdp-net", fmt(kdTotalNet));
      setText("kdp-net-compact", fmtCompact(kdTotalNet));
      setText("kdp-rate", pct(kdRate));
      setText("kdp-margin", pct(kdMargin));
    }

    // 14. Upwork
    let uwTotalNet: number, uwTotalFees: number, uwRate: number, uwMargin: number, uwGross: number, uwReqPrice: number;
    if (isReverse) {
      const reqTotalPaid = solvePrice(targetNetPerUnit, 0.10, 0, unitDirectCost);
      uwReqPrice = Math.max(0, reqTotalPaid - convShipCharge);
      uwGross = reqTotalPaid * volume;
      uwTotalFees = uwGross - totalTargetNet - totalDirectCosts;
      uwTotalNet = totalTargetNet;
      uwRate = 0.10;
      uwMargin = uwGross > 0 ? (uwTotalNet / uwGross) : 0;

      setText("upwork-subtitle", "10% freelancer fee · Buyer pays gateway fees");
      setText("upwork-gross", fmt(totalTargetNet));
      setText("upwork-fees", fmt(-uwTotalFees));
      setText("upwork-costs", fmt(-totalDirectCosts));
      setText("upwork-net", `Charge ${fmt(uwReqPrice)}`);
      setText("upwork-net-compact", formatReverseSubtext(uwGross, reqTotalPaid));
      setText("upwork-rate", pct(uwRate));
      setText("upwork-margin", pct(uwMargin));
    } else {
      const uw = calcUpwork(buyerPaidPerUnit);
      uwTotalFees = uw.fees * volume;
      uwTotalNet = (uw.net - unitDirectCost) * volume;
      uwRate = buyerPaidPerUnit > 0 ? (uw.fees / buyerPaidPerUnit) : 0;
      uwGross = standardGross;
      uwMargin = uwGross > 0 ? (uwTotalNet / uwGross) : 0;
      uwReqPrice = convPrice;

      setText("upwork-subtitle", "10% freelancer fee · Buyer pays gateway fees");
      setText("upwork-gross", fmt(uwGross));
      setText("upwork-fees", fmt(-uwTotalFees));
      setText("upwork-costs", fmt(-totalDirectCosts));
      setText("upwork-net", fmt(uwTotalNet));
      setText("upwork-net-compact", fmtCompact(uwTotalNet));
      setText("upwork-rate", pct(uwRate));
      setText("upwork-margin", pct(uwMargin));
    }

    // ── Collect Platform Dataset ─────────────────────────────
    interface PlatformData {
      id: string;
      cardId: string;
      name: string;
      net: number;
      gross: number;
      reqPrice: number;
      rate: number;
      margin: number;
      isMoR: boolean;
      categories: string[];
    }

    const platforms: PlatformData[] = [
      { id: "gumroad", cardId: "card-gumroad", name: "Gumroad", net: isReverse ? totalTargetNet : guTotalNet, gross: isReverse ? guGross : guGross, reqPrice: isReverse ? guReqPrice : convPrice, rate: guRate, margin: guMargin, isMoR: false, categories: ["direct"] },
      { id: "lemonsqueezy", cardId: "card-lemonsqueezy", name: "Lemon Squeezy", net: isReverse ? totalTargetNet : lsTotalNet, gross: isReverse ? lsGross : lsGross, reqPrice: isReverse ? lsReqPrice : convPrice, rate: lsRate, margin: lsMargin, isMoR: true, categories: ["mor"] },
      { id: "paddle", cardId: "card-paddle", name: "Paddle", net: isReverse ? totalTargetNet : pdTotalNet, gross: isReverse ? pdGross : pdGross, reqPrice: isReverse ? pdReqPrice : convPrice, rate: pdRate, margin: pdMargin, isMoR: true, categories: ["mor"] },
      { id: "payhip", cardId: "card-payhip", name: `Payhip (${phBestLabels[phBestIdx]})`, net: isReverse ? totalTargetNet : phBestNet, gross: isReverse ? phBestGross : phBestGross, reqPrice: isReverse ? phBestReqPrice : convPrice, rate: phBestRate, margin: phBestMargin, isMoR: false, categories: ["direct", "monthly"] },
      { id: "stripe", cardId: "card-stripe", name: "Stripe Direct", net: isReverse ? totalTargetNet : stTotalNet, gross: isReverse ? stGross : stGross, reqPrice: isReverse ? stReqPrice : convPrice, rate: stRate, margin: stMargin, isMoR: false, categories: ["direct"] },
      { id: "whop", cardId: "card-whop", name: "Whop", net: isReverse ? totalTargetNet : whTotalNet, gross: isReverse ? whGross : whGross, reqPrice: isReverse ? whReqPrice : convPrice, rate: whRate, margin: whMargin, isMoR: false, categories: ["direct"] },
      { id: "sellfy", cardId: "card-sellfy", name: "Sellfy", net: isReverse ? totalTargetNet : sfTotalNet, gross: isReverse ? sfGross : sfGross, reqPrice: isReverse ? sfReqPrice : convPrice, rate: sfRate, margin: sfMargin, isMoR: false, categories: ["direct", "monthly"] },
      { id: "podia", cardId: "card-podia", name: "Podia", net: isReverse ? totalTargetNet : poTotalNet, gross: isReverse ? poGross : poGross, reqPrice: isReverse ? poReqPrice : convPrice, rate: poRate, margin: poMargin, isMoR: false, categories: ["direct", "monthly"] },
      { id: "stan", cardId: "card-stan", name: "Stan Store", net: isReverse ? totalTargetNet : snTotalNet, gross: isReverse ? snGross : snGross, reqPrice: isReverse ? snReqPrice : convPrice, rate: snRate, margin: snMargin, isMoR: false, categories: ["direct", "monthly"] },
      { id: "teachable", cardId: "card-teachable", name: `Teachable (${tcBestLabels[tcBestIdx]})`, net: isReverse ? totalTargetNet : tcBestNet, gross: isReverse ? tcBestGross : tcBestGross, reqPrice: isReverse ? tcBestReqPrice : convPrice, rate: tcBestRate, margin: tcBestMargin, isMoR: false, categories: ["direct", "monthly"] },
      { id: "fiverr", cardId: "card-fiverr", name: "Fiverr", net: isReverse ? totalTargetNet : fvTotalNet, gross: isReverse ? fvGross : fvGross, reqPrice: isReverse ? fvReqPrice : convPrice, rate: fvRate, margin: fvMargin, isMoR: false, categories: ["marketplace"] },
      { id: "etsy", cardId: "card-etsy", name: "Etsy", net: isReverse ? totalTargetNet : etTotalNet, gross: isReverse ? etGross : etGross, reqPrice: isReverse ? etReqPrice : convPrice, rate: etRate, margin: etMargin, isMoR: false, categories: ["marketplace"] },
      { id: "kdp", cardId: "card-kdp", name: "Amazon KDP", net: isReverse ? totalTargetNet : kdTotalNet, gross: isReverse ? kdGross : kdGross, reqPrice: isReverse ? kdReqPrice : convPrice, rate: kdRate, margin: kdMargin, isMoR: false, categories: ["marketplace"] },
      { id: "upwork", cardId: "card-upwork", name: "Upwork", net: isReverse ? totalTargetNet : uwTotalNet, gross: isReverse ? uwGross : uwGross, reqPrice: isReverse ? uwReqPrice : convPrice, rate: uwRate, margin: uwMargin, isMoR: false, categories: ["marketplace"] },
    ];

    // Filter platforms based on activeFilter
    const filteredPlatforms = platforms.filter(
      (p) => activeFilter === "all" || p.categories.includes(activeFilter)
    );

    // Find Winner within active filter category
    const activeWinner = isReverse
      ? [...filteredPlatforms].sort((a, b) => a.reqPrice - b.reqPrice)[0] || platforms[0]
      : [...filteredPlatforms].sort((a, b) => b.net - a.net)[0] || platforms[0];

    if (isReverse) {
      setText("winner-metric-label", "Lowest customer price to charge");
      setText("winner-name", activeWinner.name);
      setText("winner-net", `Charge ${fmt(activeWinner.reqPrice)}`);
      setText("winner-net-compact", formatReverseSubtext(activeWinner.gross, activeWinner.reqPrice + convShipCharge));
    } else {
      setText("winner-metric-label", "Best net profit");
      setText("winner-name", activeWinner.name);
      setText("winner-net", `${fmt(activeWinner.net)} net`);
      setText("winner-net-compact", fmtCompact(activeWinner.net));
    }

    // Update Winner Physical Summary
    const winnerPhysicalSummary = el("winner-physical-summary");
    if (winnerPhysicalSummary) {
      winnerPhysicalSummary.style.display = isPhysical ? "block" : "none";
      setText("winner-total-cogs-ship", `−${fmt(totalDirectCosts)}`);
      setText("winner-net-margin", pct(activeWinner.margin));
    }

    // Dispatch floating dock notification for active filter winner
    if (typeof window !== "undefined") {
      window.dispatchEvent(
        new CustomEvent("matrix-winner-updated", {
          detail: {
            name: activeWinner.name,
            netFormatted: `${fmt(activeWinner.net)} net`,
            netCompact: fmtCompact(activeWinner.net),
            activeFilter: activeFilter,
            isReverse: isReverse,
            reqPriceFormatted: fmt(activeWinner.reqPrice),
            grossFormatted: fmtCompact(activeWinner.gross),
          },
        })
      );
    }

    // Deltas vs Active Winner
    interface DeltaConfig {
      id: string;
      cardId: string;
      net: number;
      reqPrice: number;
      categories: string[];
    }

    const deltasConfig: DeltaConfig[] = [
      { id: "delta-stripe", cardId: "card-stripe", net: isReverse ? totalTargetNet : stTotalNet, reqPrice: isReverse ? stReqPrice : convPrice, categories: ["direct"] },
      { id: "delta-gumroad", cardId: "card-gumroad", net: isReverse ? totalTargetNet : guTotalNet, reqPrice: isReverse ? guReqPrice : convPrice, categories: ["direct"] },
      { id: "delta-ls", cardId: "card-lemonsqueezy", net: isReverse ? totalTargetNet : lsTotalNet, reqPrice: isReverse ? lsReqPrice : convPrice, categories: ["mor"] },
      { id: "delta-paddle", cardId: "card-paddle", net: isReverse ? totalTargetNet : pdTotalNet, reqPrice: isReverse ? pdReqPrice : convPrice, categories: ["mor"] },
      { id: "delta-payhip", cardId: "card-payhip", net: isReverse ? totalTargetNet : phBestNet, reqPrice: isReverse ? phBestReqPrice : convPrice, categories: ["direct", "monthly"] },
      { id: "delta-whop", cardId: "card-whop", net: isReverse ? totalTargetNet : whTotalNet, reqPrice: isReverse ? whReqPrice : convPrice, categories: ["direct"] },
      { id: "delta-sellfy", cardId: "card-sellfy", net: isReverse ? totalTargetNet : sfTotalNet, reqPrice: isReverse ? sfReqPrice : convPrice, categories: ["direct", "monthly"] },
      { id: "delta-podia", cardId: "card-podia", net: isReverse ? totalTargetNet : poTotalNet, reqPrice: isReverse ? poReqPrice : convPrice, categories: ["direct", "monthly"] },
      { id: "delta-stan", cardId: "card-stan", net: isReverse ? totalTargetNet : snTotalNet, reqPrice: isReverse ? snReqPrice : convPrice, categories: ["direct", "monthly"] },
      { id: "delta-teachable", cardId: "card-teachable", net: isReverse ? totalTargetNet : tcBestNet, reqPrice: isReverse ? tcBestReqPrice : convPrice, categories: ["direct", "monthly"] },
      { id: "delta-fiverr", cardId: "card-fiverr", net: isReverse ? totalTargetNet : fvTotalNet, reqPrice: isReverse ? fvReqPrice : convPrice, categories: ["marketplace"] },
      { id: "delta-etsy", cardId: "card-etsy", net: isReverse ? totalTargetNet : etTotalNet, reqPrice: isReverse ? etReqPrice : convPrice, categories: ["marketplace"] },
      { id: "delta-kdp", cardId: "card-kdp", net: isReverse ? totalTargetNet : kdTotalNet, reqPrice: isReverse ? kdReqPrice : convPrice, categories: ["marketplace"] },
      { id: "delta-upwork", cardId: "card-upwork", net: isReverse ? totalTargetNet : uwTotalNet, reqPrice: isReverse ? uwReqPrice : convPrice, categories: ["marketplace"] },
    ];

    for (const item of deltasConfig) {
      const e = el(item.id);
      if (!e) continue;
      const row = (e.closest(".delta-row") as HTMLElement | null) || e.parentElement;
      const isWinnerCard = item.cardId === activeWinner.cardId;
      const isCategoryMatch = activeFilter === "all" || item.categories.includes(activeFilter);
      const isVisible = isCategoryMatch && !isWinnerCard;

      if (row) {
        row.style.display = isVisible ? "flex" : "none";
      }

      if (isVisible) {
        if (isReverse) {
          const delta = item.reqPrice - activeWinner.reqPrice;
          if (Math.abs(delta) < 0.01) {
            e.textContent = `${fmt(0)} (Tied)`;
            e.style.color = "var(--text-body)";
          } else {
            e.textContent = `+${fmt(delta)} / sale`;
            e.style.color = "var(--color-error)";
          }
        } else {
          const delta = activeWinner.net - item.net;
          if (Math.abs(delta) < 0.01) {
            e.textContent = `${fmt(0)} (Tied)`;
            e.style.color = "var(--text-body)";
          } else {
            e.textContent = fmt(-delta);
            e.style.color = "var(--text-mute)";
          }
        }
      }
    }

    // Pro Tip
    let tip = "";
    if (isReverse) {
      if (isPhysical) {
        tip = `In Physical Mode, ${activeWinner.name} lets you charge the lowest item price (${fmt(activeWinner.reqPrice)}) to cover ${fmt(unitDirectCost)}/unit COGS & shipping while keeping 100% of your target net.`;
      } else if (activeFilter === "mor") {
        tip = "Lemon Squeezy and Paddle let you charge lower customer prices while automatically remitting global sales tax/VAT.";
      } else if (activeWinner.isMoR) {
        tip = `${activeWinner.name} lets you charge the lowest customer price while handling global taxes automatically.`;
      } else {
        tip = `${activeWinner.name} lets you charge the lowest price to customers (${fmt(activeWinner.reqPrice)}) while keeping 100% of your target profit.`;
      }
    } else {
      if (isPhysical) {
        tip = `Factoring in COGS & shipping, ${activeWinner.name} delivers ${fmt(activeWinner.net)} true net profit (${pct(activeWinner.margin)} margin). Consider Auto-Tax platforms if shipping cross-border.`;
      } else if (activeFilter === "mor") {
        tip = "Lemon Squeezy and Paddle both charge 5% + $0.50 as Merchants of Record, auto-filing global VAT/GST taxes.";
      } else if (activeWinner.isMoR) {
        tip = `${activeWinner.name} handles all VAT/GST globally: no tax headaches.`;
      } else {
        tip = `${activeWinner.name} gives maximum profit in this view. Consider Lemon Squeezy or Paddle for automatic global tax compliance.`;
      }
    }
    setText("pro-tip-text", tip);

    // Highlight Winner Card
    document.querySelectorAll(".platform-card").forEach((c) => {
      c.classList.remove("card-winner-glow");
    });
    const winnerEl = el(activeWinner.cardId);
    if (winnerEl) {
      winnerEl.classList.add("card-winner-glow");
    }

    // ── Apply Filtering & Sorting to DOM Grid ───────────────────
    const grid = el("platforms");
    if (!grid) return;

    platforms.forEach((p) => {
      const card = el(p.cardId);
      if (!card) return;
      const isVisible = activeFilter === "all" || p.categories.includes(activeFilter);
      card.style.display = isVisible ? "flex" : "none";
      if (isVisible) {
        card.style.flexDirection = "column";
      }
    });

    const sortedPlatforms = [...platforms];
    if (activeSort === "net-desc") {
      if (isReverse) {
        sortedPlatforms.sort((a, b) => a.reqPrice - b.reqPrice);
      } else {
        sortedPlatforms.sort((a, b) => b.net - a.net);
      }
    } else if (activeSort === "rate-asc") {
      sortedPlatforms.sort((a, b) => a.rate - b.rate);
    } else if (activeSort === "name-asc") {
      sortedPlatforms.sort((a, b) => a.name.localeCompare(b.name));
    }

    sortedPlatforms.forEach((p, index) => {
      const card = el(p.cardId);
      if (card) {
        card.style.order = String(index);
      }
    });

    const summaryCard = el("card-winner");
    if (summaryCard) {
      summaryCard.style.order = "999";
    }

    // Highlight active preset button if match
    document.querySelectorAll(".preset-btn").forEach((btn) => {
      const pAttr = Number(btn.getAttribute("data-price"));
      const vAttr = Number(btn.getAttribute("data-volume"));
      const cAttr = Number(btn.getAttribute("data-cogs") || 0);
      const scAttr = Number(btn.getAttribute("data-ship-charge") || 0);
      const scCostAttr = Number(btn.getAttribute("data-ship-cost") || 0);

      const matches = pAttr === price && vAttr === volume &&
        (!isPhysical || (Math.abs(cAttr - cogs) < 0.01 && Math.abs(scAttr - shippingCharge) < 0.01 && Math.abs(scCostAttr - shippingCost) < 0.01));

      if (matches) {
        btn.classList.add("active");
      } else {
        btn.classList.remove("active");
      }
    });

    // Populate simulation snapshot for CSV export
    lastSnapshot = {
      currency: selectedCurrency,
      currencySymbol: curr.symbol,
      rate,
      calcMode,
      unitPrice: convPrice,
      salesVolume: volume,
      grossRevenue: isReverse ? totalTargetNet : standardGross,
      isPhysical,
      cogs: convCogs,
      shippingCharge: convShipCharge,
      shippingCost: convShipCost,
      intl,
      paypal,
      discover: gumroadDiscover,
      platforms: platforms.map((p) => ({
        id: p.id,
        name: p.name,
        category: p.categories.join(", "),
        isMoR: p.isMoR,
        gross: p.gross,
        fees: Math.max(0, p.gross - p.net - (isPhysical ? totalDirectCosts : 0)),
        directCosts: isPhysical ? totalDirectCosts : 0,
        net: p.net,
        rate: p.rate,
        margin: p.margin,
        reqPrice: p.reqPrice,
        isWinner: p.id === activeWinner.id,
      })),
    };
  }

  // ── Event Wiring ───────────────────────────────────────────────
  function updateTrackFill(slider: HTMLInputElement) {
    const min = Number(slider.min) || 1;
    const max = Number(slider.max) || 100;
    const val = Number(slider.value) || min;
    const pct = ((val - min) / (max - min)) * 100;
    const isLight = document.documentElement.classList.contains("light");
    const unfilled = isLight ? "rgba(15, 23, 42, 0.18)" : "rgba(255, 255, 255, 0.1)";
    const filled = isLight ? "#d97706" : "#F59E0B";
    slider.style.background = `linear-gradient(to right, ${filled} 0%, ${filled} ${pct}%, ${unfilled} ${pct}%, ${unfilled} 100%)`;
  }

  window.addEventListener("themechanged", () => {
    const pSlider = el("price-slider") as HTMLInputElement | null;
    const vSlider = el("volume-slider") as HTMLInputElement | null;
    if (pSlider) updateTrackFill(pSlider);
    if (vSlider) updateTrackFill(vSlider);
  });

  function wirePriceControls() {
    const slider = el("price-slider") as HTMLInputElement | null;
    const input = el("price-input") as HTMLInputElement | null;
    if (!slider || !input) return;

    updateTrackFill(slider);

    slider.addEventListener("input", () => {
      const v = Number(slider.value);
      price = v;
      updateTrackFill(slider);
      update();
    });

    input.addEventListener("input", () => {
      let v = Number(input.value);
      const rate = CURRENCIES[selectedCurrency]?.rate || 1;
      if (!isNaN(v) && v > 0) {
        price = v / rate;
        if (price > Number(slider.max)) {
          slider.max = String(Math.ceil(price));
        }
        slider.value = String(Math.round(price));
      }
      updateTrackFill(slider);
      update();
    });
  }

  wirePriceControls();

  // Volume slider wire
  const volSlider = el("volume-slider") as HTMLInputElement | null;
  const volInput = el("volume-input") as HTMLInputElement | null;
  if (volSlider && volInput) {
    updateTrackFill(volSlider);
    volSlider.addEventListener("input", () => {
      volume = Number(volSlider.value);
      volInput.value = String(volume);
      updateTrackFill(volSlider);
      update();
    });
    volInput.addEventListener("input", () => {
      let v = Number(volInput.value);
      if (!isNaN(v) && v > 0) {
        volume = v;
        if (volume > Number(volSlider.max)) {
          volSlider.max = String(volume);
        }
        volSlider.value = String(volume);
      }
      updateTrackFill(volSlider);
      update();
    });
  }

  function wireToggle(id: string, setter: (b: boolean) => void) {
    const t = el(id) as HTMLInputElement | null;
    if (!t) return;
    t.addEventListener("change", () => {
      setter(t.checked);
      update();
    });
  }

  wireToggle("toggle-intl", (b) => { intl = b; });
  wireToggle("toggle-paypal", (b) => { paypal = b; });
  wireToggle("toggle-gumroad-mode", (b) => { gumroadDiscover = b; });
  wireToggle("toggle-physical", (b) => {
    isPhysical = b;
    // If enabling physical mode for the first time with 0 COGS, set reasonable default
    if (isPhysical && cogs === 0 && shippingCharge === 0 && shippingCost === 0) {
      cogs = 8;
      shippingCharge = 4.99;
      shippingCost = 4.50;
    }
    update();
  });

  // Wire COGS & Shipping Panel Inputs
  function wireCogsInput(id: string, setter: (val: number) => void) {
    const input = el(id) as HTMLInputElement | null;
    if (!input) return;
    input.addEventListener("input", () => {
      const v = Number(input.value);
      const rate = CURRENCIES[selectedCurrency]?.rate || 1;
      if (!isNaN(v) && v >= 0) {
        setter(v / rate);
      } else {
        setter(0);
      }
      update();
    });
  }

  wireCogsInput("input-cogs", (val) => { cogs = val; });
  wireCogsInput("input-shipping-charge", (val) => { shippingCharge = val; });
  wireCogsInput("input-shipping-cost", (val) => { shippingCost = val; });

  // Wire Free Shipping Quick Pill Button
  const freeShipBtn = el("btn-free-shipping");
  if (freeShipBtn) {
    freeShipBtn.addEventListener("click", () => {
      shippingCharge = 0;
      const scInput = el("input-shipping-charge") as HTMLInputElement | null;
      if (scInput) scInput.value = "0";
      update();
    });
  }

  // Mode Switcher Buttons
  document.querySelectorAll(".mode-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const targetMode = btn.getAttribute("data-mode") as "standard" | "reverse";
      if (!targetMode || targetMode === calcMode) return;

      document.querySelectorAll(".mode-btn").forEach((b) => {
        b.classList.remove("active");
        b.setAttribute("aria-selected", "false");
      });
      btn.classList.add("active");
      btn.setAttribute("aria-selected", "true");

      calcMode = targetMode;
      const isReverse = calcMode === "reverse";

      setText(
        "mode-switcher-desc",
        isReverse
          ? "Calculate required selling price to pocket your target profit"
          : "Calculate take-home profit from selling price"
      );

      setText(
        "price-slider-title",
        isReverse ? "Target Net Profit (per unit)" : "Product Price"
      );

      setText(
        "preset-header-title",
        isReverse ? "🎯 Target Profit Presets" : "⚡ 1-Click Quick Presets"
      );

      setText(
        "preset-header-subtitle",
        isReverse ? "Select a take-home goal to solve required pricing" : "Select a creator model to auto-fill"
      );

      const sSelect = el("sort-select") as HTMLSelectElement | null;
      if (sSelect && sSelect.options.length > 0) {
        sSelect.options[0].textContent = isReverse
          ? "Lowest Price to Charge (Best)"
          : "Highest Take-Home (Best)";
      }

      update();
    });
  });

  // Currency Selector Buttons
  document.querySelectorAll(".curr-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".curr-btn").forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      const curr = btn.getAttribute("data-curr");
      if (curr && CURRENCIES[curr]) {
        selectedCurrency = curr;
        update();
      }
    });
  });

  // Quick Presets
  document.querySelectorAll(".preset-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const pAttr = Number(btn.getAttribute("data-price"));
      const vAttr = Number(btn.getAttribute("data-volume"));
      const cAttr = Number(btn.getAttribute("data-cogs") || 0);
      const scAttr = Number(btn.getAttribute("data-ship-charge") || 0);
      const scCostAttr = Number(btn.getAttribute("data-ship-cost") || 0);

      if (pAttr && vAttr) {
        price = pAttr;
        volume = vAttr;

        if (isPhysical) {
          cogs = cAttr;
          shippingCharge = scAttr;
          shippingCost = scCostAttr;
        }

        const pSlider = el("price-slider") as HTMLInputElement | null;
        const vInput = el("volume-input") as HTMLInputElement | null;
        const vSlider = el("volume-slider") as HTMLInputElement | null;

        if (pSlider) { pSlider.value = String(price); updateTrackFill(pSlider); }
        if (vInput) vInput.value = String(volume);
        if (vSlider) { vSlider.value = String(volume); updateTrackFill(vSlider); }

        update();
      }
    });
  });

  // Filter Tabs
  document.querySelectorAll(".filter-tab").forEach((tab) => {
    tab.addEventListener("click", () => {
      document.querySelectorAll(".filter-tab").forEach((t) => t.classList.remove("active"));
      tab.classList.add("active");
      const filter = tab.getAttribute("data-filter");
      if (filter) {
        activeFilter = filter;
        update();
      }
    });
  });

  // Sort Dropdown
  const sortSelect = el("sort-select") as HTMLSelectElement | null;
  if (sortSelect) {
    sortSelect.addEventListener("change", () => {
      activeSort = sortSelect.value;
      update();
    });
  }

  // ── Fetch Live Exchange Rates Async ─────────────────────────
  async function fetchLiveRates() {
    try {
      const res = await fetch("https://open.er-api.com/v6/latest/USD");
      if (res.ok) {
        const data = await res.json();
        if (data && data.rates) {
          let updated = false;
          Object.keys(CURRENCIES).forEach((code) => {
            if (data.rates[code] && typeof data.rates[code] === "number") {
              CURRENCIES[code].rate = data.rates[code];
              updated = true;
            }
          });
          if (updated) {
            update();
          }
        }
      }
    } catch (e) {
      console.warn("Exchange rate fetch fallback:", e);
    }
  }

  // ── 1-Click CSV Export Engine ────────────────────────────────
  function exportMatrixToCSV() {
    if (!lastSnapshot) return;
    const snap = lastSnapshot;
    const dateStr = new Date().toISOString().split("T")[0];

    const escapeCsv = (val: string | number) => {
      const str = String(val);
      if (str.includes(",") || str.includes('"') || str.includes("\n")) {
        return `"${str.replace(/"/g, '""')}"`;
      }
      return str;
    };

    const lines: string[] = [];
    lines.push(`Platform Fee Matrix - Live Simulation Export`);
    lines.push(`Export Date,${dateStr}`);
    lines.push(`Calculation Mode,${snap.calcMode === "reverse" ? "Target Net Take-Home (Reverse)" : "Standard Selling Price"}`);
    lines.push(`Currency,${snap.currency} (${snap.currencySymbol})`);
    lines.push(`Unit Price / Target Net,${snap.currencySymbol}${snap.unitPrice.toFixed(2)}`);
    lines.push(`Monthly Sales Volume,${snap.salesVolume} units`);
    if (snap.isPhysical) {
      lines.push(`Product COGS / unit,${snap.currencySymbol}${snap.cogs.toFixed(2)}`);
      lines.push(`Shipping Charged to Buyer / unit,${snap.currencySymbol}${snap.shippingCharge.toFixed(2)}`);
      lines.push(`Actual Carrier Cost / unit,${snap.currencySymbol}${snap.shippingCost.toFixed(2)}`);
    }
    lines.push(`Payment Options,International Cards: ${snap.intl ? "Yes (+1.5%)" : "No"} | PayPal: ${snap.paypal ? "Yes" : "No"}`);
    lines.push(``); // blank separator line

    // CSV Table Header
    lines.push([
      "Platform",
      "Category",
      "Merchant of Record (Auto-Tax)",
      `Gross Revenue (${snap.currency})`,
      `Total Platform Fees (${snap.currency})`,
      ...(snap.isPhysical ? [`Direct COGS & Shipping (${snap.currency})`] : []),
      `Net Take-Home (${snap.currency})`,
      "Effective Fee Rate (%)",
      "Profit Margin (%)",
      ...(snap.calcMode === "reverse" ? [`Required Selling Price (${snap.currency})`] : []),
      "Winner Status"
    ].map(escapeCsv).join(","));

    // Sort platforms by net profit descending (or reqPrice ascending if reverse)
    const sorted = [...snap.platforms].sort((a, b) => {
      if (snap.calcMode === "reverse") return a.reqPrice - b.reqPrice;
      return b.net - a.net;
    });

    sorted.forEach((p) => {
      lines.push([
        p.name,
        p.category,
        p.isMoR ? "Yes (Full Global Remit)" : "No (Seller Responsible)",
        p.gross.toFixed(2),
        p.fees.toFixed(2),
        ...(snap.isPhysical ? [p.directCosts.toFixed(2)] : []),
        p.net.toFixed(2),
        (p.rate * 100).toFixed(2) + "%",
        (p.margin * 100).toFixed(2) + "%",
        ...(snap.calcMode === "reverse" ? [p.reqPrice.toFixed(2)] : []),
        p.isWinner ? "WINNER (Best Margin)" : ""
      ].map(escapeCsv).join(","));
    });

    lines.push(``);
    lines.push(`Exported from PlatformFeeMatrix.com - Real-time creator fee & tax intelligence.`);

    const csvContent = lines.join("\r\n");
    const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `platform-fee-matrix-${snap.calcMode}-${dateStr}.csv`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);

    // Visual button feedback
    const btnText = document.getElementById("export-csv-text");
    if (btnText) {
      btnText.textContent = "✓ Downloaded!";
      setTimeout(() => {
        btnText.textContent = "Export CSV";
      }, 2000);
    }
  }

  const exportBtn = el("btn-export-csv");
  if (exportBtn) {
    exportBtn.addEventListener("click", exportMatrixToCSV);
  }

  // ── Embed Widget Modal Trigger ──────────────────────────────
  const embedBtn = el("btn-open-embed");
  if (embedBtn) {
    embedBtn.addEventListener("click", () => {
      if (typeof (window as any).openEmbedModal === "function") {
        (window as any).openEmbedModal();
      }
    });
  }

  // Initial render & fetch live rates
  update();
  fetchLiveRates();
</script>

