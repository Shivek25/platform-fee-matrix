<!-- ─────────────────────────────────────────────────────────────
     Calculator JavaScript: Live exchange rate & currency engine
     ───────────────────────────────────────────────────────── -->
<script>
  // ── Currency Definitions & Live Rates ────────────────────────
  interface CurrencyConfig {
    symbol: string;
    code: string;
    locale: string;
    rate: number; // 1 USD = rate units
  }

  const CURRENCIES: Record<string, CurrencyConfig> = {
    USD: { symbol: "$", code: "USD", locale: "en-US", rate: 1.0 },
    EUR: { symbol: "€", code: "EUR", locale: "de-DE", rate: 0.8688 },
    GBP: { symbol: "£", code: "GBP", locale: "en-GB", rate: 0.7446 },
    INR: { symbol: "₹", code: "INR", locale: "en-IN", rate: 95.69 },
    CAD: { symbol: "C$", code: "CAD", locale: "en-CA", rate: 1.4018 },
    AUD: { symbol: "A$", code: "AUD", locale: "en-AU", rate: 1.4270 },
  };

  let selectedCurrency = "USD";

  // ── Formatters ───────────────────────────────────────────────
  const fmt = (n: number) => {
    const cfg = CURRENCIES[selectedCurrency] || CURRENCIES.USD;
    const absVal = Math.abs(n);
    const formattedNum = absVal.toLocaleString(cfg.locale, {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    });
    const prefix = n < 0 ? "−" : "";
    return `${prefix}${cfg.symbol}${formattedNum}`;
  };

  const fmtCompact = (n: number) => {
    const cfg = CURRENCIES[selectedCurrency] || CURRENCIES.USD;
    const absVal = Math.abs(n);
    const sign = n < 0 ? "−" : "";

    if (selectedCurrency === "INR") {
      // Indian Numbering System: Crore (Cr), Lakh (L), Thousand (K)
      if (absVal >= 10000000) { // 1 Crore = 10^7
        const val = absVal / 10000000;
        const formatted = val % 1 === 0 ? val.toFixed(0) : val.toFixed(2).replace(/\.00$/, "");
        return `(≈ ${sign}${cfg.symbol}${formatted} Cr)`;
      }
      if (absVal >= 100000) { // 1 Lakh = 10^5
        const val = absVal / 100000;
        const formatted = val % 1 === 0 ? val.toFixed(0) : val.toFixed(2).replace(/\.00$/, "");
        return `(≈ ${sign}${cfg.symbol}${formatted} L)`;
      }
      if (absVal >= 1000) { // 1 Thousand
        const val = absVal / 1000;
        const formatted = val % 1 === 0 ? val.toFixed(0) : val.toFixed(1).replace(/\.0$/, "");
        return `(≈ ${sign}${cfg.symbol}${formatted} K)`;
      }
      return `(≈ ${sign}${cfg.symbol}${absVal.toFixed(0)})`;
    } else {
      // Western System: Billion (B), Million (M), Thousand (K)
      if (absVal >= 1000000000) { // 1 Billion
        const val = absVal / 1000000000;
        const formatted = val % 1 === 0 ? val.toFixed(0) : val.toFixed(2).replace(/\.00$/, "");
        return `(≈ ${sign}${cfg.symbol}${formatted}B)`;
      }
      if (absVal >= 1000000) { // 1 Million
        const val = absVal / 1000000;
        const formatted = val % 1 === 0 ? val.toFixed(0) : val.toFixed(2).replace(/\.00$/, "");
        return `(≈ ${sign}${cfg.symbol}${formatted}M)`;
      }
      if (absVal >= 1000) { // 1 Thousand
        const val = absVal / 1000;
        const formatted = val % 1 === 0 ? val.toFixed(0) : val.toFixed(1).replace(/\.0$/, "");
        return `(≈ ${sign}${cfg.symbol}${formatted}K)`;
      }
      return `(≈ ${sign}${cfg.symbol}${absVal.toFixed(0)})`;
    }
  };

  const pct = (n: number) => `${(n * 100).toFixed(1)}%`;

  function el(id: string): HTMLElement | null {
    return document.getElementById(id);
  }

  function setText(id: string, val: string) {
    const e = el(id);
    if (e) e.textContent = val;
  }

  // ── State (Base USD values) ──────────────────────────────────
  let price = 25; // Base price in USD
  let volume = 50;
  let intl = false;
  let paypal = false;
  let gumroadDiscover = false;
  let activeFilter = "all";
  let activeSort = "net-desc";

  // ── Fee Formulas ───────────────────────────────────────────────
  function calcGumroad(p: number, intl: boolean, pp: boolean, discover: boolean, rate: number) {
    if (discover) {
      const platformCut = p * 0.30;
      return { gross: p, fees: platformCut, net: p - platformCut };
    }
    const platformCut = p * 0.10 + 0.50 * rate;
    const proc = (0.029 + (intl ? 0.015 : 0)) * p + 0.30 * rate;
    const totalProc = pp ? (0.0349 * p + 0.49 * rate) : proc;
    const totalFees = platformCut + totalProc;
    return { gross: p, fees: totalFees, net: p - totalFees };
  }

  function calcLemonSqueezy(p: number, intl: boolean, pp: boolean, rate: number) {
    const platformCut = p * 0.05 + 0.50 * rate;
    const intlExtra = intl ? p * 0.015 : 0;
    const paypalExtra = pp ? p * 0.015 : 0;
    const totalFees = platformCut + intlExtra + paypalExtra;
    return { gross: p, fees: totalFees, net: p - totalFees };
  }

  function calcPaddle(p: number, intl: boolean, rate: number) {
    const platformCut = p * 0.05 + 0.50 * rate;
    const intlExtra = intl ? p * 0.015 : 0;
    const totalFees = platformCut + intlExtra;
    return { gross: p, fees: totalFees, net: p - totalFees };
  }

  function calcProcFee(p: number, intl: boolean, pp: boolean, rate: number) {
    if (pp) return 0.0349 * p + 0.49 * rate;
    return (0.029 + (intl ? 0.015 : 0)) * p + 0.30 * rate;
  }

  function calcPayhip(p: number, vol: number, intl: boolean, pp: boolean, rate: number) {
    const proc = calcProcFee(p, intl, pp, rate);

    const freeFees = p * 0.05 + proc;
    const freeNet = p - freeFees;

    const plusMonthlyCost = 29 * rate;
    const plusTxFees = p * 0.02 + proc;
    const plusNetPerUnit = p - plusTxFees - plusMonthlyCost / vol;
    const plusFees = p - plusNetPerUnit;

    const proMonthlyCost = 99 * rate;
    const proTxFees = proc;
    const proNetPerUnit = p - proTxFees - proMonthlyCost / vol;
    const proFees = p - proNetPerUnit;

    return {
      free: { fees: freeFees, net: freeNet, totalFees: freeFees * vol, totalNet: freeNet * vol },
      plus: { fees: plusFees, net: plusNetPerUnit, totalFees: plusFees * vol, totalNet: plusNetPerUnit * vol },
      pro: { fees: proFees, net: proNetPerUnit, totalFees: proFees * vol, totalNet: proNetPerUnit * vol },
    };
  }

  function calcStripe(p: number, intl: boolean, pp: boolean, rate: number) {
    const proc = calcProcFee(p, intl, pp, rate);
    return { gross: p, fees: proc, net: p - proc };
  }

  function calcWhop(p: number, intl: boolean, pp: boolean, rate: number) {
    const platformCut = p * 0.03;
    const proc = calcProcFee(p, intl, pp, rate);
    const totalFees = platformCut + proc;
    return { gross: p, fees: totalFees, net: p - totalFees };
  }

  function calcSellfy(p: number, vol: number, intl: boolean, pp: boolean, rate: number) {
    const proc = calcProcFee(p, intl, pp, rate);
    const monthlyCost = 29 * rate;
    const feesPerUnit = proc + monthlyCost / vol;
    const netPerUnit = p - feesPerUnit;
    return { gross: p, fees: feesPerUnit, net: netPerUnit };
  }

  function calcPodia(p: number, vol: number, intl: boolean, pp: boolean, rate: number) {
    const proc = calcProcFee(p, intl, pp, rate);
    const monthlyCost = 39 * rate;
    const feesPerUnit = proc + monthlyCost / vol;
    const netPerUnit = p - feesPerUnit;
    return { gross: p, fees: feesPerUnit, net: netPerUnit };
  }

  function calcStan(p: number, vol: number, intl: boolean, pp: boolean, rate: number) {
    const proc = calcProcFee(p, intl, pp, rate);
    const monthlyCost = 29 * rate;
    const feesPerUnit = proc + monthlyCost / vol;
    const netPerUnit = p - feesPerUnit;
    return { gross: p, fees: feesPerUnit, net: netPerUnit };
  }

  function calcTeachable(p: number, vol: number, intl: boolean, pp: boolean, rate: number) {
    const proc = calcProcFee(p, intl, pp, rate);

    const basicMonthlyCost = 39 * rate;
    const basicTxFees = p * 0.05 + proc;
    const basicNetPerUnit = p - basicTxFees - basicMonthlyCost / vol;
    const basicFees = p - basicNetPerUnit;

    const proMonthlyCost = 119 * rate;
    const proTxFees = proc;
    const proNetPerUnit = p - proTxFees - proMonthlyCost / vol;
    const proFees = p - proNetPerUnit;

    return {
      basic: { fees: basicFees, net: basicNetPerUnit, totalFees: basicFees * vol, totalNet: basicNetPerUnit * vol },
      pro: { fees: proFees, net: proNetPerUnit, totalFees: proFees * vol, totalNet: proNetPerUnit * vol },
    };
  }

  function calcFiverr(p: number) {
    const fees = p * 0.20;
    return { gross: p, fees, net: p - fees };
  }

  function calcEtsy(p: number, intl: boolean, rate: number) {
    const listingFee = 0.20 * rate;
    const txFee = p * 0.065;
    const procFee = p * (0.03 + (intl ? 0.025 : 0)) + 0.25 * rate;
    const totalFees = listingFee + txFee + procFee;
    return { gross: p, fees: totalFees, net: p - totalFees };
  }

  function calcKDP(p: number, rate: number) {
    const platformCut = p * 0.30;
    const deliveryFee = 0.15 * rate;
    const totalFees = platformCut + deliveryFee;
    return { gross: p, fees: totalFees, net: p - totalFees };
  }

  function calcUpwork(p: number) {
    const fees = p * 0.10;
    return { gross: p, fees, net: p - fees };
  }

  // ── Render / Recalculate Matrix ──────────────────────────────
  function update() {
    const curr = CURRENCIES[selectedCurrency] || CURRENCIES.USD;
    const rate = curr.rate;
    const convPrice = price * rate;
    const gross = convPrice * volume;

    // Update Live Exchange Rate Badge
    const rateBadge = el("exchange-rate-badge");
    if (rateBadge) {
      if (selectedCurrency === "USD") {
        rateBadge.textContent = "🟢 Live rate: 1 USD = 1.00 USD (Base)";
      } else {
        rateBadge.textContent = `🟢 Live rate: 1 USD = ${rate.toFixed(4)} ${selectedCurrency}`;
      }
    }

    // Update Input value to show converted price (without stealing active focus)
    const pInput = el("price-input") as HTMLInputElement | null;
    if (pInput && document.activeElement !== pInput) {
      pInput.value = convPrice.toFixed(2).replace(/\.00$/, "");
    }

    // Update Currency Labels & Subtitles
    setText("price-symbol-label", curr.symbol);
    setText("price-min-label", fmt(1 * rate));
    const pSlider = el("price-slider") as HTMLInputElement | null;
    if (pSlider) setText("price-max-label", fmt(Number(pSlider.max) * rate));
    const vSlider = el("volume-slider") as HTMLInputElement | null;
    if (vSlider) setText("volume-max-label", Number(vSlider.max).toLocaleString());

    setText("paypal-toggle-desc", `3.49% + ${fmt(0.49 * rate)} per transaction`);
    setText("gumroad-toggle-desc", `Switch to marketplace (30% cut) vs. Direct (10% + ${fmt(0.50 * rate)})`);

    // Update Presets Meta Text
    setText("preset-meta-1", `${fmt(5 * rate)} × 100 sales`);
    setText("preset-meta-2", `${fmt(29 * rate)} × 50 sales`);
    setText("preset-meta-3", `${fmt(149 * rate)} × 20 sales`);
    setText("preset-meta-4", `${fmt(49 * rate)} × 30 sales`);

    // 1. Gumroad
    const gu = calcGumroad(convPrice, intl, paypal, gumroadDiscover, rate);
    const guTotalNet = gu.net * volume;
    const guTotalFees = gu.fees * volume;
    const guRate = gu.fees / convPrice;
    setText(
      "gumroad-mode-label",
      gumroadDiscover
        ? "Discover: 30% marketplace cut"
        : `Direct: 10% + ${fmt(0.50 * rate)} per sale`,
    );
    setText("gumroad-gross", fmt(gross));
    setText("gumroad-fees", fmt(-guTotalFees));
    setText("gumroad-net", fmt(guTotalNet));
    setText("gumroad-net-compact", fmtCompact(guTotalNet));
    setText("gumroad-rate", pct(guRate));

    // 2. Lemon Squeezy
    const ls = calcLemonSqueezy(convPrice, intl, paypal, rate);
    const lsTotalNet = ls.net * volume;
    const lsTotalFees = ls.fees * volume;
    const lsRate = ls.fees / convPrice;
    setText("ls-subtitle", `5% + ${fmt(0.50 * rate)} per sale`);
    setText("ls-gross", fmt(gross));
    setText("ls-fees", fmt(-lsTotalFees));
    setText("ls-net", fmt(lsTotalNet));
    setText("ls-net-compact", fmtCompact(lsTotalNet));
    setText("ls-rate", pct(lsRate));

    // 3. Paddle
    const pd = calcPaddle(convPrice, intl, rate);
    const pdTotalNet = pd.net * volume;
    const pdTotalFees = pd.fees * volume;
    const pdRate = pd.fees / convPrice;
    setText("paddle-subtitle", `5% + ${fmt(0.50 * rate)} per sale · Auto VAT`);
    setText("paddle-gross", fmt(gross));
    setText("paddle-fees", fmt(-pdTotalFees));
    setText("paddle-net", fmt(pdTotalNet));
    setText("paddle-net-compact", fmtCompact(pdTotalNet));
    setText("paddle-rate", pct(pdRate));

    // 4. Payhip
    const ph = calcPayhip(convPrice, volume, intl, paypal, rate);
    const highlightTier = (id: string, active: boolean) => {
      const row = el(id);
      if (!row) return;
      row.style.background = active ? "var(--color-profit-bg)" : "";
      row.style.borderColor = active ? "var(--color-profit)" : "var(--border-hairline)";
    };
    const phNets = [ph.free.totalNet, ph.plus.totalNet, ph.pro.totalNet];
    const phBestIdx = phNets.indexOf(Math.max(...phNets));
    const phBestLabels = ["Free Plan", "Plus Plan", "Pro Plan"];
    const phBestNet = phNets[phBestIdx];
    const phBestRate = [ph.free.fees / convPrice, ph.plus.fees / convPrice, ph.pro.fees / convPrice][phBestIdx];

    highlightTier("payhip-free-row", phBestIdx === 0);
    highlightTier("payhip-plus-row", phBestIdx === 1);
    highlightTier("payhip-pro-row", phBestIdx === 2);

    setText("payhip-subtitle", `Free 5% · Plus ${fmt(29 * rate)}/mo · Pro ${fmt(99 * rate)}/mo`);
    setText("payhip-plus-label", `Plus Plan (${fmt(29 * rate)}/mo + 2%)`);
    setText("payhip-pro-label", `Pro Plan (${fmt(99 * rate)}/mo + 0%)`);
    setText("payhip-free-net", fmt(ph.free.totalNet));
    setText("payhip-free-net-compact", fmtCompact(ph.free.totalNet));
    setText("payhip-free-fees", fmt(ph.free.totalFees));
    setText("payhip-free-rate", pct(ph.free.fees / convPrice));
    setText("payhip-plus-net", fmt(ph.plus.totalNet));
    setText("payhip-plus-net-compact", fmtCompact(ph.plus.totalNet));
    setText("payhip-plus-fees", fmt(ph.plus.totalFees));
    setText("payhip-plus-rate", pct(ph.plus.fees / convPrice));
    setText("payhip-pro-net", fmt(ph.pro.totalNet));
    setText("payhip-pro-net-compact", fmtCompact(ph.pro.totalNet));
    setText("payhip-pro-fees", fmt(ph.pro.totalFees));
    setText("payhip-pro-rate", pct(ph.pro.fees / convPrice));
    setText("payhip-best-label", `↑ ${phBestLabels[phBestIdx]} is best at this volume`);

    // 5. Stripe
    const st = calcStripe(convPrice, intl, paypal, rate);
    const stTotalNet = st.net * volume;
    const stTotalFees = st.fees * volume;
    const stRate = st.fees / convPrice;
    setText("stripe-subtitle", `2.9% + ${fmt(0.30 * rate)} · No platform fee`);
    setText("stripe-gross", fmt(gross));
    setText("stripe-fees", fmt(-stTotalFees));
    setText("stripe-net", fmt(stTotalNet));
    setText("stripe-net-compact", fmtCompact(stTotalNet));
    setText("stripe-rate", pct(stRate));

    // 6. Whop
    const wh = calcWhop(convPrice, intl, paypal, rate);
    const whTotalNet = wh.net * volume;
    const whTotalFees = wh.fees * volume;
    const whRate = wh.fees / convPrice;
    setText("whop-subtitle", `3% flat + 2.9% + ${fmt(0.30 * rate)} card fee`);
    setText("whop-gross", fmt(gross));
    setText("whop-fees", fmt(-whTotalFees));
    setText("whop-net", fmt(whTotalNet));
    setText("whop-net-compact", fmtCompact(whTotalNet));
    setText("whop-rate", pct(whRate));

    // 7. Sellfy
    const sf = calcSellfy(convPrice, volume, intl, paypal, rate);
    const sfTotalNet = sf.net * volume;
    const sfTotalFees = sf.fees * volume;
    const sfRate = sf.fees / convPrice;
    setText("sellfy-subtitle", `${fmt(29 * rate)}/mo Starter · 0% fee + 2.9% + ${fmt(0.30 * rate)}`);
    setText("sellfy-gross", fmt(gross));
    setText("sellfy-fees", fmt(-sfTotalFees));
    setText("sellfy-net", fmt(sfTotalNet));
    setText("sellfy-net-compact", fmtCompact(sfTotalNet));
    setText("sellfy-rate", pct(sfRate));

    // 8. Podia
    const po = calcPodia(convPrice, volume, intl, paypal, rate);
    const poTotalNet = po.net * volume;
    const poTotalFees = po.fees * volume;
    const poRate = po.fees / convPrice;
    setText("podia-subtitle", `${fmt(39 * rate)}/mo Mover · 0% fee + 2.9% + ${fmt(0.30 * rate)}`);
    setText("podia-gross", fmt(gross));
    setText("podia-fees", fmt(-poTotalFees));
    setText("podia-net", fmt(poTotalNet));
    setText("podia-net-compact", fmtCompact(poTotalNet));
    setText("podia-rate", pct(poRate));

    // 9. Stan Store
    const sn = calcStan(convPrice, volume, intl, paypal, rate);
    const snTotalNet = sn.net * volume;
    const snTotalFees = sn.fees * volume;
    const snRate = sn.fees / convPrice;
    setText("stan-subtitle", `${fmt(29 * rate)}/mo Plan · 0% fee + 2.9% + ${fmt(0.30 * rate)}`);
    setText("stan-gross", fmt(gross));
    setText("stan-fees", fmt(-snTotalFees));
    setText("stan-net", fmt(snTotalNet));
    setText("stan-net-compact", fmtCompact(snTotalNet));
    setText("stan-rate", pct(snRate));

    // 10. Teachable
    const tc = calcTeachable(convPrice, volume, intl, paypal, rate);
    const tcNets = [tc.basic.totalNet, tc.pro.totalNet];
    const tcBestIdx = tcNets.indexOf(Math.max(...tcNets));
    const tcBestLabels = ["Basic Plan", "Pro Plan"];
    const tcBestNet = tcNets[tcBestIdx];
    const tcBestRate = [tc.basic.fees / convPrice, tc.pro.fees / convPrice][tcBestIdx];

    highlightTier("teachable-basic-row", tcBestIdx === 0);
    highlightTier("teachable-pro-row", tcBestIdx === 1);

    setText("teachable-subtitle", `Basic ${fmt(39 * rate)}/mo + 5% · Pro ${fmt(119 * rate)}/mo + 0%`);
    setText("teachable-basic-label", `Basic (${fmt(39 * rate)}/mo + 5%)`);
    setText("teachable-pro-label", `Pro (${fmt(119 * rate)}/mo + 0%)`);
    setText("teachable-basic-net", fmt(tc.basic.totalNet));
    setText("teachable-basic-net-compact", fmtCompact(tc.basic.totalNet));
    setText("teachable-basic-fees", fmt(tc.basic.totalFees));
    setText("teachable-basic-rate", pct(tc.basic.fees / convPrice));
    setText("teachable-pro-net", fmt(tc.pro.totalNet));
    setText("teachable-pro-net-compact", fmtCompact(tc.pro.totalNet));
    setText("teachable-pro-fees", fmt(tc.pro.totalFees));
    setText("teachable-pro-rate", pct(tc.pro.fees / convPrice));
    setText("teachable-best-label", `↑ ${tcBestLabels[tcBestIdx]} is best at this volume`);

    // 11. Fiverr
    const fv = calcFiverr(convPrice);
    const fvTotalNet = fv.net * volume;
    const fvTotalFees = fv.fees * volume;
    const fvRate = fv.fees / convPrice;
    setText("fiverr-subtitle", `20% seller commission · Buyer pays processing fee`);
    setText("fiverr-gross", fmt(gross));
    setText("fiverr-fees", fmt(-fvTotalFees));
    setText("fiverr-net", fmt(fvTotalNet));
    setText("fiverr-net-compact", fmtCompact(fvTotalNet));
    setText("fiverr-rate", pct(fvRate));

    // 12. Etsy
    const et = calcEtsy(convPrice, intl, rate);
    const etTotalNet = et.net * volume;
    const etTotalFees = et.fees * volume;
    const etRate = et.fees / convPrice;
    setText("etsy-subtitle", `${fmt(0.20 * rate)} listing + 6.5% + 3% + ${fmt(0.25 * rate)} card`);
    setText("etsy-gross", fmt(gross));
    setText("etsy-fees", fmt(-etTotalFees));
    setText("etsy-net", fmt(etTotalNet));
    setText("etsy-net-compact", fmtCompact(etTotalNet));
    setText("etsy-rate", pct(etRate));

    // 13. Amazon KDP
    const kd = calcKDP(convPrice, rate);
    const kdTotalNet = kd.net * volume;
    const kdTotalFees = kd.fees * volume;
    const kdRate = kd.fees / convPrice;
    setText("kdp-subtitle", `30% fee (70% royalty) + ${fmt(0.15 * rate)}/MB · Amazon handles card fees`);
    setText("kdp-gross", fmt(gross));
    setText("kdp-fees", fmt(-kdTotalFees));
    setText("kdp-net", fmt(kdTotalNet));
    setText("kdp-net-compact", fmtCompact(kdTotalNet));
    setText("kdp-rate", pct(kdRate));

    // 14. Upwork
    const uw = calcUpwork(convPrice);
    const uwTotalNet = uw.net * volume;
    const uwTotalFees = uw.fees * volume;
    const uwRate = uw.fees / convPrice;
    setText("upwork-subtitle", `10% freelancer fee · Buyer pays gateway fees`);
    setText("upwork-gross", fmt(gross));
    setText("upwork-fees", fmt(-uwTotalFees));
    setText("upwork-net", fmt(uwTotalNet));
    setText("upwork-net-compact", fmtCompact(uwTotalNet));
    setText("upwork-rate", pct(uwRate));

    // ── Collect Platform Dataset ─────────────────────────────
    interface PlatformData {
      id: string;
      cardId: string;
      name: string;
      net: number;
      rate: number;
      isMoR: boolean;
      categories: string[];
    }

    const platforms: PlatformData[] = [
      { id: "gumroad", cardId: "card-gumroad", name: "Gumroad", net: guTotalNet, rate: guRate, isMoR: false, categories: ["direct"] },
      { id: "lemonsqueezy", cardId: "card-lemonsqueezy", name: "Lemon Squeezy", net: lsTotalNet, rate: lsRate, isMoR: true, categories: ["mor"] },
      { id: "paddle", cardId: "card-paddle", name: "Paddle", net: pdTotalNet, rate: pdRate, isMoR: true, categories: ["mor"] },
      { id: "payhip", cardId: "card-payhip", name: `Payhip (${phBestLabels[phBestIdx]})`, net: phBestNet, rate: phBestRate, isMoR: false, categories: ["direct", "monthly"] },
      { id: "stripe", cardId: "card-stripe", name: "Stripe Direct", net: stTotalNet, rate: stRate, isMoR: false, categories: ["direct"] },
      { id: "whop", cardId: "card-whop", name: "Whop", net: whTotalNet, rate: whRate, isMoR: false, categories: ["direct"] },
      { id: "sellfy", cardId: "card-sellfy", name: "Sellfy", net: sfTotalNet, rate: sfRate, isMoR: false, categories: ["direct", "monthly"] },
      { id: "podia", cardId: "card-podia", name: "Podia", net: poTotalNet, rate: poRate, isMoR: false, categories: ["direct", "monthly"] },
      { id: "stan", cardId: "card-stan", name: "Stan Store", net: snTotalNet, rate: snRate, isMoR: false, categories: ["direct", "monthly"] },
      { id: "teachable", cardId: "card-teachable", name: `Teachable (${tcBestLabels[tcBestIdx]})`, net: tcBestNet, rate: tcBestRate, isMoR: false, categories: ["direct", "monthly"] },
      { id: "fiverr", cardId: "card-fiverr", name: "Fiverr", net: fvTotalNet, rate: fvRate, isMoR: false, categories: ["marketplace"] },
      { id: "etsy", cardId: "card-etsy", name: "Etsy", net: etTotalNet, rate: etRate, isMoR: false, categories: ["marketplace"] },
      { id: "kdp", cardId: "card-kdp", name: "Amazon KDP", net: kdTotalNet, rate: kdRate, isMoR: false, categories: ["marketplace"] },
      { id: "upwork", cardId: "card-upwork", name: "Upwork", net: uwTotalNet, rate: uwRate, isMoR: false, categories: ["marketplace"] },
    ];

    // Filter platforms based on activeFilter
    const filteredPlatforms = platforms.filter(
      (p) => activeFilter === "all" || p.categories.includes(activeFilter)
    );

    // Find Winner within active filter category
    const activeWinner = [...filteredPlatforms].sort((a, b) => b.net - a.net)[0] || platforms[0];

    setText("winner-name", activeWinner.name);
    setText("winner-net", `${fmt(activeWinner.net)} net`);
    setText("winner-net-compact", fmtCompact(activeWinner.net));

    // Dispatch floating dock notification for active filter winner
    if (typeof window !== "undefined") {
      window.dispatchEvent(
        new CustomEvent("matrix-winner-updated", {
          detail: {
            name: activeWinner.name,
            netFormatted: `${fmt(activeWinner.net)} net`,
            netCompact: fmtCompact(activeWinner.net),
            activeFilter: activeFilter,
          },
        })
      );
    }

    // Deltas vs Active Winner (filtered by activeFilter, hide self-comparison, format ties)
    interface DeltaConfig {
      id: string;
      cardId: string;
      net: number;
      categories: string[];
    }

    const deltasConfig: DeltaConfig[] = [
      { id: "delta-stripe", cardId: "card-stripe", net: stTotalNet, categories: ["direct"] },
      { id: "delta-gumroad", cardId: "card-gumroad", net: guTotalNet, categories: ["direct"] },
      { id: "delta-ls", cardId: "card-lemonsqueezy", net: lsTotalNet, categories: ["mor"] },
      { id: "delta-paddle", cardId: "card-paddle", net: pdTotalNet, categories: ["mor"] },
      { id: "delta-payhip", cardId: "card-payhip", net: phBestNet, categories: ["direct", "monthly"] },
      { id: "delta-whop", cardId: "card-whop", net: whTotalNet, categories: ["direct"] },
      { id: "delta-sellfy", cardId: "card-sellfy", net: sfTotalNet, categories: ["direct", "monthly"] },
      { id: "delta-podia", cardId: "card-podia", net: poTotalNet, categories: ["direct", "monthly"] },
      { id: "delta-stan", cardId: "card-stan", net: snTotalNet, categories: ["direct", "monthly"] },
      { id: "delta-teachable", cardId: "card-teachable", net: tcBestNet, categories: ["direct", "monthly"] },
      { id: "delta-fiverr", cardId: "card-fiverr", net: fvTotalNet, categories: ["marketplace"] },
      { id: "delta-etsy", cardId: "card-etsy", net: etTotalNet, categories: ["marketplace"] },
      { id: "delta-kdp", cardId: "card-kdp", net: kdTotalNet, categories: ["marketplace"] },
      { id: "delta-upwork", cardId: "card-upwork", net: uwTotalNet, categories: ["marketplace"] },
    ];

    for (const item of deltasConfig) {
      const e = el(item.id);
      if (!e) continue;
      const row = (e.closest(".delta-row") as HTMLElement | null) || e.parentElement;
      const isWinnerCard = item.cardId === activeWinner.cardId;
      const isCategoryMatch = activeFilter === "all" || item.categories.includes(activeFilter);
      // Hide self-comparison row and non-category matching rows
      const isVisible = isCategoryMatch && !isWinnerCard;

      if (row) {
        row.style.display = isVisible ? "flex" : "none";
      }

      if (isVisible) {
        const delta = activeWinner.net - item.net;
        if (Math.abs(delta) < 0.01) {
          e.textContent = `${fmt(0)} (Tied)`;
          e.style.color = "var(--text-body)";
        } else {
          e.textContent = fmt(-delta);
          e.style.color = "var(--text-mute)";
        }
      }
    }

    // Pro Tip
    let tip = "";
    if (activeFilter === "mor") {
      tip = "Lemon Squeezy and Paddle both charge 5% + $0.50 as Merchants of Record, auto-filing global VAT/GST taxes.";
    } else if (activeWinner.isMoR) {
      tip = `${activeWinner.name} handles all VAT/GST globally: no tax headaches.`;
    } else {
      tip = `${activeWinner.name} gives maximum profit in this view. Consider Lemon Squeezy or Paddle for automatic global tax compliance.`;
    }
    setText("pro-tip-text", tip);

    // Highlight Winner Card
    document.querySelectorAll(".platform-card").forEach((c) => {
      c.classList.remove("card-winner-glow");
    });
    const winnerEl = el(activeWinner.cardId);
    if (winnerEl) {
      winnerEl.classList.add("card-winner-glow");
    }

    // ── Apply Filtering & Sorting to DOM Grid ───────────────────
    const grid = el("platforms");
    if (!grid) return;

    // Filter cards
    platforms.forEach((p) => {
      const card = el(p.cardId);
      if (!card) return;
      const isVisible = activeFilter === "all" || p.categories.includes(activeFilter);
      card.style.display = isVisible ? "flex" : "none";
      if (isVisible) {
        card.style.flexDirection = "column";
      }
    });

    // Sort visible cards via CSS order property
    const sortedPlatforms = [...platforms];
    if (activeSort === "net-desc") {
      sortedPlatforms.sort((a, b) => b.net - a.net);
    } else if (activeSort === "rate-asc") {
      sortedPlatforms.sort((a, b) => a.rate - b.rate);
    } else if (activeSort === "name-asc") {
      sortedPlatforms.sort((a, b) => a.name.localeCompare(b.name));
    }

    sortedPlatforms.forEach((p, index) => {
      const card = el(p.cardId);
      if (card) {
        card.style.order = String(index);
      }
    });

    // Keep Summary Card at order 999
    const summaryCard = el("card-winner");
    if (summaryCard) {
      summaryCard.style.order = "999";
    }

    // Highlight active preset button if price/volume match
    document.querySelectorAll(".preset-btn").forEach((btn) => {
      const pAttr = Number(btn.getAttribute("data-price"));
      const vAttr = Number(btn.getAttribute("data-volume"));
      if (pAttr === price && vAttr === volume) {
        btn.classList.add("active");
      } else {
        btn.classList.remove("active");
      }
    });
  }

  // ── Event Wiring ───────────────────────────────────────────────
  function updateTrackFill(slider: HTMLInputElement) {
    const min = Number(slider.min) || 1;
    const max = Number(slider.max) || 100;
    const val = Number(slider.value) || min;
    const pct = ((val - min) / (max - min)) * 100;
    const isLight = document.documentElement.classList.contains("light");
    const unfilled = isLight ? "rgba(15, 23, 42, 0.18)" : "rgba(255, 255, 255, 0.1)";
    const filled = isLight ? "#d97706" : "#F59E0B";
    slider.style.background = `linear-gradient(to right, ${filled} 0%, ${filled} ${pct}%, ${unfilled} ${pct}%, ${unfilled} 100%)`;
  }

  window.addEventListener("themechanged", () => {
    const pSlider = el("price-slider") as HTMLInputElement | null;
    const vSlider = el("volume-slider") as HTMLInputElement | null;
    if (pSlider) updateTrackFill(pSlider);
    if (vSlider) updateTrackFill(vSlider);
  });

  function wirePriceControls() {
    const slider = el("price-slider") as HTMLInputElement | null;
    const input = el("price-input") as HTMLInputElement | null;
    if (!slider || !input) return;

    updateTrackFill(slider);

    slider.addEventListener("input", () => {
      const v = Number(slider.value);
      price = v;
      updateTrackFill(slider);
      update();
    });

    input.addEventListener("input", () => {
      let v = Number(input.value);
      const rate = CURRENCIES[selectedCurrency]?.rate || 1;
      if (!isNaN(v) && v > 0) {
        price = v / rate;
        if (price > Number(slider.max)) {
          slider.max = String(Math.ceil(price));
        }
        slider.value = String(Math.round(price));
      }
      updateTrackFill(slider);
      update();
    });
  }

  wirePriceControls();

  // Volume slider wire
  const volSlider = el("volume-slider") as HTMLInputElement | null;
  const volInput = el("volume-input") as HTMLInputElement | null;
  if (volSlider && volInput) {
    updateTrackFill(volSlider);
    volSlider.addEventListener("input", () => {
      volume = Number(volSlider.value);
      volInput.value = String(volume);
      updateTrackFill(volSlider);
      update();
    });
    volInput.addEventListener("input", () => {
      let v = Number(volInput.value);
      if (!isNaN(v) && v > 0) {
        volume = v;
        if (volume > Number(volSlider.max)) {
          volSlider.max = String(volume);
        }
        volSlider.value = String(volume);
      }
      updateTrackFill(volSlider);
      update();
    });
  }

  function wireToggle(id: string, setter: (b: boolean) => void) {
    const t = el(id) as HTMLInputElement | null;
    if (!t) return;
    t.addEventListener("change", () => {
      setter(t.checked);
      update();
    });
  }

  wireToggle("toggle-intl", (b) => { intl = b; });
  wireToggle("toggle-paypal", (b) => { paypal = b; });
  wireToggle("toggle-gumroad-mode", (b) => { gumroadDiscover = b; });

  // Currency Selector Buttons
  document.querySelectorAll(".curr-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".curr-btn").forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      const curr = btn.getAttribute("data-curr");
      if (curr && CURRENCIES[curr]) {
        selectedCurrency = curr;
        update();
      }
    });
  });

  // Quick Presets
  document.querySelectorAll(".preset-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const pAttr = Number(btn.getAttribute("data-price"));
      const vAttr = Number(btn.getAttribute("data-volume"));
      if (pAttr && vAttr) {
        price = pAttr;
        volume = vAttr;

        const pSlider = el("price-slider") as HTMLInputElement | null;
        const vInput = el("volume-input") as HTMLInputElement | null;
        const vSlider = el("volume-slider") as HTMLInputElement | null;

        if (pSlider) { pSlider.value = String(price); updateTrackFill(pSlider); }
        if (vInput) vInput.value = String(volume);
        if (vSlider) { vSlider.value = String(volume); updateTrackFill(vSlider); }

        update();
      }
    });
  });

  // Filter Tabs
  document.querySelectorAll(".filter-tab").forEach((tab) => {
    tab.addEventListener("click", () => {
      document.querySelectorAll(".filter-tab").forEach((t) => t.classList.remove("active"));
      tab.classList.add("active");
      const filter = tab.getAttribute("data-filter");
      if (filter) {
        activeFilter = filter;
        update();
      }
    });
  });

  // Sort Dropdown
  const sortSelect = el("sort-select") as HTMLSelectElement | null;
  if (sortSelect) {
    sortSelect.addEventListener("change", () => {
      activeSort = sortSelect.value;
      update();
    });
  }

  // ── Fetch Live Exchange Rates Async ─────────────────────────
  async function fetchLiveRates() {
    try {
      const res = await fetch("https://open.er-api.com/v6/latest/USD");
      if (res.ok) {
        const data = await res.json();
        if (data && data.rates) {
          let updated = false;
          Object.keys(CURRENCIES).forEach((code) => {
            if (data.rates[code] && typeof data.rates[code] === "number") {
              CURRENCIES[code].rate = data.rates[code];
              updated = true;
            }
          });
          if (updated) {
            update();
          }
        }
      }
    } catch (e) {
      console.warn("Exchange rate fetch fallback:", e);
    }
  }

  // Initial render & fetch live rates
  update();
  fetchLiveRates();
</script>

