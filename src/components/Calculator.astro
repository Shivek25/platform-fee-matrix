---
// Calculator.astro: Interactive multi-platform net margin calculator
// Dynamic Live Currency Engine: Fetches real-time exchange rates & converts all figures
---

<section
  id="calculator"
  class="calc-section"
  style="padding: 80px 24px; background: var(--bg-page);"
>
  <div style="max-width: 1200px; margin: 0 auto;">
    <!-- Section header -->
    <div style="text-align: center; margin-bottom: 40px;">
      <p
        style="
        font-family: var(--font-mono);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--text-mute);
        margin: 0 0 12px;
      "
      >
        Real-time Calculator
      </p>
      <h2
        style="
        font-size: clamp(28px, 4vw, 40px);
        font-weight: 600;
        letter-spacing: -1.5px;
        color: var(--text-ink);
        margin: 0 0 16px;
        line-height: 1.1;
      "
      >
        Compare platform fees instantly.
      </h2>
      <p
        style="
        font-size: 17px;
        color: var(--text-body);
        max-width: 540px;
        margin: 0 auto 24px;
        line-height: 1.6;
      "
      >
        Adjust price, volume, and payment options to see exact take-home profit
        across 10 top creator platforms with live currency conversion.
      </p>

      <!-- Currency Selector Bar & Live Exchange Rate Indicator -->
      <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px;">
        <div style="display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap;">
          <span style="font-size: 13px; color: var(--text-mute); font-weight: 500;">Currency:</span>
          <div id="currency-selector" class="currency-selector-box">
            <button type="button" class="curr-btn active" data-curr="USD">$ USD</button>
            <button type="button" class="curr-btn" data-curr="EUR">€ EUR</button>
            <button type="button" class="curr-btn" data-curr="GBP">£ GBP</button>
            <button type="button" class="curr-btn" data-curr="INR">₹ INR</button>
            <button type="button" class="curr-btn" data-curr="CAD">C$ CAD</button>
            <button type="button" class="curr-btn" data-curr="AUD">A$ AUD</button>
          </div>
        </div>
        <div id="exchange-rate-badge" style="font-size: 11px; font-family: var(--font-mono); color: var(--color-emerald-profit); background: rgba(16, 185, 129, 0.1); padding: 3px 12px; border-radius: 100px; border: 1px solid rgba(16, 185, 129, 0.25);">
          🟢 Live rate: 1 USD = 1.00 USD (Base)
        </div>
      </div>
    </div>

    <!-- ─── Controls Panel ─────────────────────────── -->
    <div class="card-base sticky-controls-card" style="padding: 28px 32px; margin-bottom: 32px;">
      <!-- Mode Switcher Row -->
      <div class="mode-switcher-container">
        <div class="mode-switcher-info">
          <span class="mode-switcher-title">
            🎯 Calculation Mode
          </span>
          <span class="mode-switcher-subtitle" id="mode-switcher-desc">
            Calculate take-home profit from selling price
          </span>
        </div>
        <div class="calc-mode-switcher" id="calc-mode-switcher" role="tablist" aria-label="Calculation Mode">
          <button type="button" class="mode-btn active" data-mode="standard" role="tab" aria-selected="true" id="mode-btn-standard">
            <span class="mode-btn-icon">⚡</span>
            <span>Calculate Take-Home</span>
          </button>
          <button type="button" class="mode-btn" data-mode="reverse" role="tab" aria-selected="false" id="mode-btn-reverse">
            <span class="mode-btn-icon">🎯</span>
            <span>Target Take-Home (Reverse)</span>
          </button>
        </div>
      </div>

      <!-- Quick Presets Row -->
      <div style="margin-bottom: 28px; padding-bottom: 20px; border-bottom: 1px solid var(--border-hairline);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;">
          <span style="font-size: 13px; font-weight: 600; color: var(--text-ink); text-transform: uppercase; letter-spacing: 0.05em; font-family: var(--font-mono);" id="preset-header-title">
            ⚡ 1-Click Quick Presets
          </span>
          <span style="font-size: 12px; color: var(--text-mute);" id="preset-header-subtitle">Select a creator model to auto-fill</span>
        </div>
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px;" id="preset-buttons" class="preset-grid">
          <button type="button" class="preset-btn" data-price="5" data-volume="100" id="preset-btn-1">
            <span class="preset-title" id="preset-title-1">Micro-Template</span>
            <span class="preset-meta" id="preset-meta-1">$5.00 × 100 sales</span>
          </button>
          <button type="button" class="preset-btn" data-price="29" data-volume="50" id="preset-btn-2">
            <span class="preset-title" id="preset-title-2">Ebook</span>
            <span class="preset-meta" id="preset-meta-2">$29.00 × 50 sales</span>
          </button>
          <button type="button" class="preset-btn" data-price="149" data-volume="20" id="preset-btn-3">
            <span class="preset-title" id="preset-title-3">Course</span>
            <span class="preset-meta" id="preset-meta-3">$149.00 × 20 sales</span>
          </button>
          <button type="button" class="preset-btn" data-price="49" data-volume="30" id="preset-btn-4">
            <span class="preset-title" id="preset-title-4">SaaS</span>
            <span class="preset-meta" id="preset-meta-4">$49.00 × 30 sales</span>
          </button>
        </div>
      </div>

      <!-- Sliders row -->
      <div
        style="
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        margin-bottom: 32px;
      "
        class="controls-grid"
      >
        <!-- Price slider -->
        <div>
          <div
            class="slider-header-row"
            style="display: flex; justify-content: space-between; align-items: flex-end; min-height: 36px; margin-bottom: 12px;"
          >
            <label
              for="price-slider"
              id="price-slider-title"
              class="slider-label"
              style="font-size: 14px; font-weight: 500; color: var(--text-ink); white-space: nowrap;"
            >
              Product Price
            </label>
            <div style="display: flex; align-items: center; gap: 4px;">
              <span id="price-symbol-label" style="font-size: 14px; color: var(--text-body);">$</span>
              <input
                type="number"
                id="price-input"
                min="1"
                value="25"
                step="any"
                style="
                  width: 110px;
                  height: 32px;
                  padding: 0 8px;
                  font-size: 14px;
                  font-weight: 600;
                  color: var(--text-ink);
                  background: var(--bg-input);
                  border: 1px solid var(--border-hairline);
                  border-radius: 6px;
                  text-align: right;
                  font-family: var(--font-mono);
                "
              />
            </div>
          </div>
          <input
            type="range"
            id="price-slider"
            min="1"
            max="5000"
            value="25"
            step="1"
            aria-label="Product price slider"
          />
          <div
            style="display: flex; justify-content: space-between; margin-top: 6px;"
          >
            <span id="price-min-label" style="font-size: 12px; color: var(--text-mute);">$1.00</span>
            <span id="price-max-label" style="font-size: 12px; color: var(--text-mute);">$5,000.00</span>
          </div>
        </div>

        <!-- Volume slider -->
        <div>
          <div
            class="slider-header-row"
            style="display: flex; justify-content: space-between; align-items: flex-end; min-height: 36px; margin-bottom: 12px;"
          >
            <label
              for="volume-slider"
              class="slider-label"
              style="font-size: 14px; font-weight: 500; color: var(--text-ink); white-space: nowrap;"
            >
              Monthly Sales
            </label>
            <div style="display: flex; align-items: center; gap: 4px;">
              <input
                type="number"
                id="volume-input"
                min="1"
                value="50"
                style="
                  width: 100px;
                  height: 32px;
                  padding: 0 8px;
                  font-size: 14px;
                  font-weight: 600;
                  color: var(--text-ink);
                  background: var(--bg-input);
                  border: 1px solid var(--border-hairline);
                  border-radius: 6px;
                  text-align: right;
                  font-family: var(--font-mono);
                "
              />
              <span style="font-size: 14px; color: var(--text-body);"
                >units</span
              >
            </div>
          </div>
          <input
            type="range"
            id="volume-slider"
            min="1"
            max="5000"
            value="50"
            step="1"
            aria-label="Monthly sales volume slider"
          />
          <div
            style="display: flex; justify-content: space-between; margin-top: 6px;"
          >
            <span style="font-size: 12px; color: var(--text-mute);">1</span>
            <span id="volume-max-label" style="font-size: 12px; color: var(--text-mute);">5,000</span>
          </div>
        </div>
      </div>

      <!-- Toggles row -->
      <div
        style="
        border-top: 1px solid var(--border-hairline);
        padding-top: 24px;
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
      "
        class="toggles-row"
      >
        <!-- International cards -->
        <label
          style="display: flex; align-items: center; gap: 12px; cursor: pointer;"
        >
          <span class="toggle-switch">
            <input
              type="checkbox"
              id="toggle-intl"
              role="switch"
              aria-label="International card surcharge toggle"
            />
            <span class="toggle-track"></span>
            <span class="toggle-thumb"></span>
          </span>
          <span style="display: flex; flex-direction: column; gap: 2px;">
            <span
              style="font-size: 13px; font-weight: 500; color: var(--text-ink);"
              >International Cards</span
            >
            <span style="font-size: 12px; color: var(--text-mute);"
              >+1.5% surcharge on card fees</span
            >
          </span>
        </label>

        <!-- PayPal processing -->
        <label
          style="display: flex; align-items: center; gap: 12px; cursor: pointer;"
        >
          <span class="toggle-switch">
            <input
              type="checkbox"
              id="toggle-paypal"
              role="switch"
              aria-label="PayPal processing toggle"
            />
            <span class="toggle-track"></span>
            <span class="toggle-thumb"></span>
          </span>
          <span style="display: flex; flex-direction: column; gap: 2px;">
            <span
              style="font-size: 13px; font-weight: 500; color: var(--text-ink);"
              >PayPal Processing</span
            >
            <span style="font-size: 12px; color: var(--text-mute);" id="paypal-toggle-desc"
              >3.49% + $0.49 per transaction</span
            >
          </span>
        </label>

        <!-- Gumroad mode -->
        <label
          style="display: flex; align-items: center; gap: 12px; cursor: pointer;"
        >
          <span class="toggle-switch">
            <input
              type="checkbox"
              id="toggle-gumroad-mode"
              role="switch"
              aria-label="Gumroad Discover marketplace toggle"
            />
            <span class="toggle-track"></span>
            <span class="toggle-thumb"></span>
          </span>
          <span style="display: flex; flex-direction: column; gap: 2px;">
            <span
              style="font-size: 13px; font-weight: 500; color: var(--text-ink);"
              >Gumroad Discover</span
            >
            <span style="font-size: 12px; color: var(--text-mute);" id="gumroad-toggle-desc"
              >Switch to marketplace (30% cut) vs. Direct (10% + $0.50)</span
            >
          </span>
        </label>

        <!-- Physical & E-Commerce Mode -->
        <label
          style="display: flex; align-items: center; gap: 12px; cursor: pointer;"
        >
          <span class="toggle-switch">
            <input
              type="checkbox"
              id="toggle-physical"
              role="switch"
              aria-label="Physical and E-Commerce products mode toggle"
            />
            <span class="toggle-track"></span>
            <span class="toggle-thumb"></span>
          </span>
          <span style="display: flex; flex-direction: column; gap: 2px;">
            <span
              style="font-size: 13px; font-weight: 500; color: var(--text-ink);"
              >📦 Physical & E-Commerce</span
            >
            <span style="font-size: 12px; color: var(--text-mute);" id="physical-toggle-desc"
              >Factor in COGS & carrier shipping deductions</span
            >
          </span>
        </label>
      </div>

      <!-- ─── COGS & Shipping Expandable Panel ──────── -->
      <div
        id="cogs-shipping-panel"
        class="cogs-shipping-panel"
        style="display: none;"
      >
        <div class="cogs-panel-header">
          <div class="cogs-panel-title-wrap">
            <span class="cogs-badge">📦 Physical Commerce</span>
            <h4 class="cogs-panel-title">Product Direct Costs & Shipping Logistics</h4>
          </div>
          <span class="cogs-panel-subtitle">
            Marketplaces & processors calculate fees on total buyer payment. COGS and carrier costs are deducted from net profit.
          </span>
        </div>

        <div class="cogs-inputs-grid">
          <!-- 1. Item Cost (COGS) -->
          <div class="cogs-input-card">
            <div class="cogs-input-header">
              <label for="input-cogs" class="cogs-label">Item Unit Cost (COGS)</label>
              <span class="cogs-hint">Manufacturing / Wholesale</span>
            </div>
            <div class="cogs-input-wrap">
              <span class="cogs-curr-sym" id="cogs-symbol">$</span>
              <input
                type="number"
                id="input-cogs"
                min="0"
                value="0"
                step="any"
                class="cogs-num-input"
                placeholder="0.00"
                aria-label="Item manufacturing unit cost"
              />
            </div>
          </div>

          <!-- 2. Shipping Charged to Buyer -->
          <div class="cogs-input-card">
            <div class="cogs-input-header">
              <div style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
                <label for="input-shipping-charge" class="cogs-label">Shipping Charged to Buyer</label>
                <button type="button" id="btn-free-shipping" class="free-ship-btn">Free Shipping ($0)</button>
              </div>
            </div>
            <div class="cogs-input-wrap">
              <span class="cogs-curr-sym" id="ship-charge-symbol">$</span>
              <input
                type="number"
                id="input-shipping-charge"
                min="0"
                value="0"
                step="any"
                class="cogs-num-input"
                placeholder="0.00"
                aria-label="Shipping fee charged to customer"
              />
            </div>
          </div>

          <!-- 3. Actual Shipping Cost (Carrier) -->
          <div class="cogs-input-card">
            <div class="cogs-input-header">
              <label for="input-shipping-cost" class="cogs-label">Actual Shipping Cost (Carrier)</label>
              <span class="cogs-hint">Postage, label & packaging</span>
            </div>
            <div class="cogs-input-wrap">
              <span class="cogs-curr-sym" id="ship-cost-symbol">$</span>
              <input
                type="number"
                id="input-shipping-cost"
                min="0"
                value="0"
                step="any"
                class="cogs-num-input"
                placeholder="0.00"
                aria-label="Actual shipping carrier cost"
              />
            </div>
          </div>
        </div>

        <!-- Live Summary Strip -->
        <div class="cogs-summary-strip">
          <div class="cogs-strip-item">
            <span class="cogs-strip-label">Buyer Pays (Gross Base):</span>
            <span class="cogs-strip-val" id="cogs-strip-buyer-paid">$25.00</span>
          </div>
          <div class="cogs-strip-divider"></div>
          <div class="cogs-strip-item">
            <span class="cogs-strip-label">Unit Direct Costs:</span>
            <span class="cogs-strip-val cogs-strip-warn" id="cogs-strip-direct-cost">−$0.00 / unit</span>
          </div>
          <div class="cogs-strip-divider"></div>
          <div class="cogs-strip-item">
            <span class="cogs-strip-label">Total Monthly Direct Costs:</span>
            <span class="cogs-strip-val cogs-strip-warn" id="cogs-strip-total-costs">−$0.00 (50 units)</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ─── Matrix Toolbar: Filter Tabs & Sorting ────── -->
    <div
      style="
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 24px;
        background: var(--bg-card-soft);
        padding: 12px 20px;
        border-radius: var(--radius-lg);
        border: 1px solid var(--border-hairline);
      "
      class="matrix-toolbar"
    >
      <!-- Filter Tabs -->
      <div style="display: flex; align-items: center; justify-content: center; gap: 8px 6px; flex-wrap: wrap;" id="filter-tabs" class="matrix-filter-tabs">
        <button type="button" class="filter-tab active" data-filter="all">All Platforms (14)</button>
        <button type="button" class="filter-tab" data-filter="mor">Auto-Tax (MoR)</button>
        <button type="button" class="filter-tab" data-filter="direct">Direct Gateways</button>
        <button type="button" class="filter-tab" data-filter="monthly">Fixed Monthly Plans</button>
        <button type="button" class="filter-tab" data-filter="marketplace">Marketplace & Freelance</button>
      </div>

      <!-- Sorting Selector & Action Buttons -->
      <div style="display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap;" class="matrix-sort-group">
        <div style="display: flex; align-items: center; gap: 6px;">
          <label for="sort-select" style="font-size: 13px; color: var(--text-mute); font-weight: 500;">Sort By:</label>
          <select
            id="sort-select"
            style="
              background: var(--bg-input);
              color: var(--text-ink);
              border: 1px solid var(--border-hairline);
              border-radius: 8px;
              padding: 6px 12px;
              font-size: 13px;
              font-weight: 500;
              cursor: pointer;
              outline: none;
              font-family: var(--font-sans);
            "
          >
            <option value="net-desc">Highest Take-Home</option>
            <option value="rate-asc">Lowest Effective Fee %</option>
            <option value="name-asc">Alphabetical</option>
          </select>
        </div>

        <!-- 1-Click CSV Export Button -->
        <button
          type="button"
          id="btn-export-csv"
          class="toolbar-action-btn"
          title="Download live calculation matrix as a CSV spreadsheet"
          aria-label="Export comparison matrix as CSV"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span id="export-csv-text">Export CSV</span>
        </button>

        <!-- Embed Widget Button -->
        <button
          type="button"
          id="btn-open-embed"
          class="toolbar-action-btn"
          title="Embed interactive calculator widget or badge on your website"
          aria-label="Embed widget on website"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
          </svg>
          <span>Embed Widget</span>
        </button>
      </div>
    </div>

    <!-- ─── Platform Cards Grid ─────────────────────── -->
    <div
      id="platforms"
      style="
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    "
      class="platforms-grid"
      aria-live="polite"
      aria-label="Platform fee comparison"
    >
      <!-- ─── GUMROAD ─── -->
      <div
        class="card-base platform-card"
        id="card-gumroad"
        data-categories="direct"
        data-name="Gumroad"
        style="padding: 24px;"
      >
        <div
          style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 16px;"
        >
          <div>
            <div
              style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;"
            >
              <img src="/icons/gumroad.svg" width="20" height="20" alt="Gumroad" style="border-radius: 4px;" />
              <h3
                style="font-size: 15px; font-weight: 600; color: var(--text-ink); margin: 0; letter-spacing: -0.3px;"
              >
                Gumroad
              </h3>
            </div>
            <p
              id="gumroad-mode-label"
              style="font-size: 12px; color: var(--text-mute); margin: 0; font-family: var(--font-mono);"
            >
              Direct: 10% + $0.50
            </p>
          </div>
          <div
            style="display: flex; flex-direction: column; gap: 4px; align-items: flex-end;"
          >
            <span class="badge badge-tax">Self-File Taxes</span>
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 12px;">
          <div
            style="display: flex; justify-content: space-between; align-items: baseline;"
          >
            <span style="font-size: 13px; color: var(--text-mute);" class="card-row-lbl-gross">Gross Revenue</span>
            <span
              id="gumroad-gross"
              style="font-size: 13px; font-weight: 500; color: var(--text-ink); font-family: var(--font-mono);"
              >$1,250.00</span
            >
          </div>
          <div
            style="display: flex; justify-content: space-between; align-items: baseline;"
          >
            <span style="font-size: 13px; color: var(--text-mute);"
              >Platform & Fees</span
            >
            <span
              id="gumroad-fees"
              style="font-size: 13px; font-weight: 500; color: var(--color-error); font-family: var(--font-mono);"
              >−$235.00</span
            >
          </div>
          <div
            class="card-row-costs"
            style="display: none; justify-content: space-between; align-items: baseline;"
          >
            <span style="font-size: 13px; color: var(--text-mute);">COGS & Shipping</span>
            <span
              id="gumroad-costs"
              style="font-size: 13px; font-weight: 500; color: #f59e0b; font-family: var(--font-mono);"
              >−$0.00</span
            >
          </div>
          <div style="height: 1px; background: var(--border-hairline);"></div>
          <div
            style="display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; border-radius: 8px; background: var(--color-profit-bg);"
          >
            <span style="font-size: 14px; font-weight: 600; color: var(--color-profit);" class="card-row-lbl-net">Net Profit</span>
            <div style="text-align: right; display: flex; flex-direction: column; align-items: flex-end;">
              <span
                id="gumroad-net"
                style="font-size: 17px; font-weight: 700; color: var(--color-profit); font-family: var(--font-mono); letter-spacing: -0.5px;"
                >$1,015.00</span
              >
              <span
                id="gumroad-net-compact"
                style="font-size: 11px; font-weight: 600; color: var(--color-profit); opacity: 0.85; font-family: var(--font-mono); margin-top: 1px;"
                >(≈ $1K)</span
              >
            </div>
          </div>
          <div
            style="display: flex; justify-content: space-between; align-items: center;"
          >
            <span style="font-size: 12px; color: var(--text-mute);"
              >Effective fee rate</span
            >
            <span
