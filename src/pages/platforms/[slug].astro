---
// src/pages/platforms/[slug].astro
// Programmatic SEO Platform Detail Page with Embedded Live Mini-Calculator

import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import RateReportModal from "../../components/RateReportModal.astro";
import { ALL_PLATFORMS, type PlatformSEOProfile } from "../../data/platforms";
import { ALL_COMPARISONS } from "../../data/comparisons";

export async function getStaticPaths() {
  return ALL_PLATFORMS.map((platform) => ({
    params: { slug: platform.slug },
    props: { platform },
  }));
}

interface Props {
  platform: PlatformSEOProfile;
}

const { platform } = Astro.props;

// Find comparisons relevant to this platform
const relatedComparisons = ALL_COMPARISONS.filter(
  (c) => c.p1Id === platform.id || c.p2Id === platform.id
);

// Revenue simulation tiers
const revenueTiers = [
  { label: "$500 / month", volume: 20, price: 25 },
  { label: "$1,000 / month", volume: 40, price: 25 },
  { label: "$2,500 / month", volume: 50, price: 50 },
  { label: "$5,000 / month", volume: 100, price: 50 },
  { label: "$10,000 / month", volume: 100, price: 100 },
];

function calculateEstimatedNet(price: number, volume: number, p: PlatformSEOProfile) {
  const gross = price * volume;
  const variableFee = (p.calcDefaults.variableRate) * gross;
  const fixedFee = (p.calcDefaults.fixedFee) * volume;
  const monthly = p.calcDefaults.monthlyFee;
  const totalFees = variableFee + fixedFee + monthly;
  const net = Math.max(0, gross - totalFees);
  const feeRate = gross > 0 ? (totalFees / gross) * 100 : 0;
  const margin = gross > 0 ? (net / gross) * 100 : 0;
  return { gross, totalFees, net, feeRate, margin };
}

const pageTitle = `${platform.name} Fee Calculator & 2026 Pricing Breakdown | Platform Fee Matrix`;
const pageDescription = `Complete fee breakdown and real-time take-home profit calculator for ${platform.name}. Learn hidden costs, refund policies, VAT remittance, and see exact net margins.`;

// Schema.org Structured Data
const schemaJson = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": platform.name,
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Web",
    "offers": {
      "@type": "Offer",
      "price": platform.calcDefaults.monthlyFee > 0 ? String(platform.calcDefaults.monthlyFee) : "0",
      "priceCurrency": "USD",
      "description": platform.feeFormula
    },
    "description": platform.description
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": platform.faqs.map((f) => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": f.answer
      }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://platformfeematrix.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Platforms",
        "item": "https://platformfeematrix.com/platforms"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": platform.name,
        "item": `https://platformfeematrix.com/platforms/${platform.slug}`
      }
    ]
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  schemaJson={schemaJson}
>
  <Nav />

  <main style="max-width: 1040px; margin: 0 auto; padding: 48px 24px 80px;">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb" style="margin-bottom: 24px; font-size: 13px;">
      <ol style="display: flex; align-items: center; gap: 8px; list-style: none; padding: 0; margin: 0; color: var(--text-mute); flex-wrap: wrap;">
        <li><a href="/" style="color: var(--text-mute); text-decoration: none;">Home</a></li>
        <li><span>/</span></li>
        <li><a href="/platforms" style="color: var(--text-mute); text-decoration: none;">Platforms</a></li>
        <li><span>/</span></li>
        <li style="color: var(--text-ink); font-weight: 500;">{platform.name}</li>
      </ol>
    </nav>

    <!-- Platform Hero Header -->
    <header style="margin-bottom: 40px;">
      <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 14px; flex-wrap: wrap;">
        <img
          src={platform.icon}
          width="48"
          height="48"
          alt={`${platform.name} logo`}
          style="border-radius: 10px; background: rgba(255,255,255,0.05); padding: 4px; border: 1px solid var(--border-hairline);"
        />
        <div>
          <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
            <h1 style="font-size: clamp(26px, 4vw, 36px); font-weight: 700; color: var(--text-ink); margin: 0; letter-spacing: -0.5px;">
              {platform.name} Fees & Calculator
            </h1>
            <span
              style={`font-size: 11px; font-weight: 600; padding: 3px 10px; border-radius: 100px; text-transform: uppercase; letter-spacing: 0.05em; background: ${platform.badgeColor}20; color: ${platform.badgeColor}; border: 1px solid ${platform.badgeColor}40;`}
            >
              {platform.badge}
            </span>
            <span
              style="font-size: 11px; font-weight: 600; padding: 3px 10px; border-radius: 100px; font-family: var(--font-mono); background: rgba(16, 185, 129, 0.1); color: var(--color-profit); border: 1px solid rgba(16, 185, 129, 0.3); display: inline-flex; align-items: center; gap: 4px;"
            >
              <span style="font-size: 7px;">●</span> Verified: {platform.lastVerified}
            </span>
            <button
              type="button"
              class="btn-report-rate"
              data-platform={platform.name}
              style="background: transparent; border: 1px solid var(--border-hairline); border-radius: 100px; padding: 2px 10px; font-size: 11px; color: var(--text-mute); cursor: pointer; display: inline-flex; align-items: center; gap: 4px;"
              onmouseover="this.style.color='var(--color-primary)';this.style.borderColor='var(--color-primary)';"
              onmouseout="this.style.color='var(--text-mute)';this.style.borderColor='var(--border-hairline)';"
            >
              Report Change ↗
            </button>
          </div>
          <p style="font-size: 14px; color: var(--text-mute); margin: 4px 0 0; font-family: var(--font-mono);">
            {platform.feeFormula}
          </p>
        </div>
      </div>
      <p style="font-size: 16px; color: var(--text-body); line-height: 1.6; max-width: 820px; margin: 0;">
        {platform.description}
      </p>
    </header>

    <!-- ─── Interactive Embedded Mini-Calculator ────── -->
    <section
      class="card-base"
      style="padding: 28px; margin-bottom: 44px; border: 1px solid rgba(245, 158, 11, 0.3); background: var(--bg-card-soft);"
    >
      <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 20px; flex-wrap: wrap; gap: 8px;">
        <div>
          <h2 style="font-size: 20px; font-weight: 700; color: var(--text-ink); margin: 0 0 4px;">
            ⚡ Live {platform.name} Take-Home Calculator
          </h2>
          <p style="font-size: 13px; color: var(--text-mute); margin: 0;">
            Adjust selling price and monthly volume to see your exact take-home profit on {platform.name}.
          </p>
        </div>
        <a
          href="/#calculator"
          style="font-size: 13px; font-weight: 600; color: var(--color-primary); text-decoration: none;"
        >
          Compare all 14 platforms →
        </a>
      </div>

      <!-- Calculator Controls Grid -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px;" class="mini-calc-grid">
        <!-- Price Slider -->
        <div>
          <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
            <label for="mini-price-input" style="font-size: 13px; font-weight: 600; color: var(--text-ink);">
              Selling Price ($)
            </label>
            <input
              type="number"
              id="mini-price-input"
              min="1"
              value={platform.calcDefaults.price}
              style="width: 80px; height: 28px; padding: 0 6px; font-size: 13px; font-weight: 600; text-align: right; background: var(--bg-input); border: 1px solid var(--border-hairline); border-radius: 6px; color: var(--text-ink); font-family: var(--font-mono);"
            />
          </div>
          <input
            type="range"
            id="mini-price-slider"
            min="1"
            max="1000"
            value={platform.calcDefaults.price}
            style="width: 100%; accent-color: var(--color-primary);"
            aria-label="Product selling price"
          />
        </div>

        <!-- Volume Slider -->
        <div>
          <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
            <label for="mini-vol-input" style="font-size: 13px; font-weight: 600; color: var(--text-ink);">
              Monthly Sales (Units)
            </label>
            <input
              type="number"
              id="mini-vol-input"
              min="1"
              value={platform.calcDefaults.volume}
              style="width: 80px; height: 28px; padding: 0 6px; font-size: 13px; font-weight: 600; text-align: right; background: var(--bg-input); border: 1px solid var(--border-hairline); border-radius: 6px; color: var(--text-ink); font-family: var(--font-mono);"
            />
          </div>
          <input
            type="range"
            id="mini-vol-slider"
            min="1"
            max="500"
            value={platform.calcDefaults.volume}
            style="width: 100%; accent-color: var(--color-primary);"
            aria-label="Monthly sales volume"
          />
        </div>
      </div>

      <!-- Real-Time Metrics Strip -->
      <div
        style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; padding: 18px; border-radius: 10px; background: rgba(0,0,0,0.25); border: 1px solid var(--border-hairline);"
        class="mini-calc-results"
      >
        <div>
          <span style="font-size: 11px; text-transform: uppercase; color: var(--text-mute); font-family: var(--font-mono);">Gross Revenue</span>
          <p id="mini-res-gross" style="font-size: 18px; font-weight: 700; color: var(--text-ink); margin: 4px 0 0; font-family: var(--font-mono);">$1,250.00</p>
        </div>
        <div>
          <span style="font-size: 11px; text-transform: uppercase; color: var(--text-mute); font-family: var(--font-mono);">{platform.name} Fees</span>
          <p id="mini-res-fees" style="font-size: 18px; font-weight: 700; color: var(--color-error); margin: 4px 0 0; font-family: var(--font-mono);">−$161.25</p>
        </div>
        <div>
          <span style="font-size: 11px; text-transform: uppercase; color: var(--text-mute); font-family: var(--font-mono);">Take-Home Profit</span>
          <p id="mini-res-net" style="font-size: 18px; font-weight: 700; color: var(--color-profit); margin: 4px 0 0; font-family: var(--font-mono);">$1,088.75</p>
        </div>
        <div>
          <span style="font-size: 11px; text-transform: uppercase; color: var(--text-mute); font-family: var(--font-mono);">Net Margin</span>
          <p id="mini-res-margin" style="font-size: 18px; font-weight: 700; color: var(--color-profit); margin: 4px 0 0; font-family: var(--font-mono);">87.1%</p>
        </div>
      </div>
    </section>

    <!-- ─── Fee Structure Summary Matrix ───────────── -->
    <section style="margin-bottom: 44px;">
      <h2 style="font-size: 20px; font-weight: 700; color: var(--text-ink); margin: 0 0 16px;">
        📋 Complete {platform.name} Fee Breakdown
      </h2>
      <div style="overflow-x: auto; border-radius: var(--radius-lg); border: 1px solid var(--border-hairline);">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 14px; background: var(--bg-card);">
          <tbody>
            <tr style="border-bottom: 1px solid var(--border-hairline);">
              <th style="padding: 14px 18px; color: var(--text-mute); width: 35%; font-weight: 500;">Pricing Model</th>
              <td style="padding: 14px 18px; color: var(--text-ink); font-weight: 600;">{platform.feeFormula}</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border-hairline);">
              <th style="padding: 14px 18px; color: var(--text-mute); font-weight: 500;">Sales Tax / EU VAT</th>
              <td style="padding: 14px 18px; color: var(--text-ink);">{platform.taxMode}</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border-hairline);">
              <th style="padding: 14px 18px; color: var(--text-mute); font-weight: 500;">Payout Schedule</th>
              <td style="padding: 14px 18px; color: var(--text-ink);">{platform.payoutSchedule}</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border-hairline);">
              <th style="padding: 14px 18px; color: var(--text-mute); font-weight: 500;">Payout Methods</th>
              <td style="padding: 14px 18px; color: var(--text-ink);">{platform.payoutMethods.join(", ")}</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border-hairline);">
              <th style="padding: 14px 18px; color: var(--text-mute); font-weight: 500;">Minimum Payout</th>
              <td style="padding: 14px 18px; color: var(--text-ink); font-family: var(--font-mono);">{platform.payoutThreshold}</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border-hairline);">
              <th style="padding: 14px 18px; color: var(--text-mute); font-weight: 500;">International Cards</th>
              <td style="padding: 14px 18px; color: var(--text-ink);">{platform.intlFeeNote}</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border-hairline);">
              <th style="padding: 14px 18px; color: var(--text-mute); font-weight: 500;">PayPal Transactions</th>
              <td style="padding: 14px 18px; color: var(--text-ink);">{platform.paypalFeeNote}</td>
            </tr>
            <tr>
              <th style="padding: 14px 18px; color: var(--text-mute); font-weight: 500;">Dispute / Chargeback Fee</th>
              <td style="padding: 14px 18px; color: var(--color-error); font-family: var(--font-mono);">{platform.chargebackFee}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- ─── Monthly Revenue Simulation Table ───────── -->
    <section style="margin-bottom: 44px;">
      <h2 style="font-size: 20px; font-weight: 700; color: var(--text-ink); margin: 0 0 16px;">
        📈 Estimated Take-Home at Different Sales Volumes
      </h2>
      <div style="overflow-x: auto; border-radius: var(--radius-lg); border: 1px solid var(--border-hairline);">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13.5px; background: var(--bg-card);">
          <thead>
            <tr style="border-bottom: 1px solid var(--border-hairline); background: rgba(0,0,0,0.2);">
              <th style="padding: 12px 16px; color: var(--text-mute);">Target Revenue</th>
              <th style="padding: 12px 16px; color: var(--text-mute);">Sample Scenario</th>
              <th style="padding: 12px 16px; color: var(--text-mute);">{platform.name} Fees</th>
              <th style="padding: 12px 16px; color: var(--text-mute);">Net Take-Home</th>
              <th style="padding: 12px 16px; color: var(--text-mute);">Effective Fee %</th>
            </tr>
          </thead>
          <tbody>
            {revenueTiers.map((tier) => {
              const res = calculateEstimatedNet(tier.price, tier.volume, platform);
              return (
                <tr style="border-bottom: 1px solid var(--border-hairline);">
                  <td style="padding: 12px 16px; font-weight: 600; color: var(--text-ink);">{tier.label}</td>
                  <td style="padding: 12px 16px; color: var(--text-mute); font-family: var(--font-mono);">
                    ${tier.price} × {tier.volume} units
                  </td>
                  <td style="padding: 12px 16px; color: var(--color-error); font-family: var(--font-mono);">
                    −${res.totalFees.toFixed(2)}
                  </td>
                  <td style="padding: 12px 16px; font-weight: 700; color: var(--color-profit); font-family: var(--font-mono);">
                    ${res.net.toFixed(2)}
                  </td>
                  <td style="padding: 12px 16px; font-weight: 600; color: var(--text-ink); font-family: var(--font-mono);">
                    {res.feeRate.toFixed(1)}%
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <!-- ─── Pros, Cons & Hidden Fees ───────────────── -->
    <section style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 44px;" class="pros-cons-grid">
      <!-- Pros -->
      <div class="card-base" style="padding: 24px;">
        <h3 style="font-size: 16px; font-weight: 700; color: var(--color-profit); margin: 0 0 14px; display: flex; align-items: center; gap: 8px;">
          <span>✓</span> Advantages of {platform.name}
        </h3>
        <ul style="margin: 0; padding-left: 20px; font-size: 14px; color: var(--text-body); line-height: 1.7;">
          {platform.pros.map((pro) => (
            <li style="margin-bottom: 8px;">{pro}</li>
          ))}
        </ul>
      </div>

      <!-- Cons -->
      <div class="card-base" style="padding: 24px;">
        <h3 style="font-size: 16px; font-weight: 700; color: var(--color-error); margin: 0 0 14px; display: flex; align-items: center; gap: 8px;">
          <span>✗</span> Drawbacks & Limitations
        </h3>
        <ul style="margin: 0; padding-left: 20px; font-size: 14px; color: var(--text-body); line-height: 1.7;">
          {platform.cons.map((con) => (
            <li style="margin-bottom: 8px;">{con}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Hidden Fees Warning Box -->
    {platform.hiddenFees.length > 0 && (
      <section style="padding: 20px 24px; border-radius: var(--radius-lg); background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.3); margin-bottom: 44px;">
        <h3 style="font-size: 15px; font-weight: 700; color: #f59e0b; margin: 0 0 10px; display: flex; align-items: center; gap: 8px;">
          <span>⚠️</span> Fine Print & Hidden Fees to Watch For
        </h3>
        <ul style="margin: 0; padding-left: 20px; font-size: 13.5px; color: var(--text-body); line-height: 1.65;">
          {platform.hiddenFees.map((item) => (
            <li style="margin-bottom: 6px;">{item}</li>
          ))}
        </ul>
      </section>
    )}

    <!-- ─── Popular Head-to-Head Comparisons ───────── -->
    {relatedComparisons.length > 0 && (
      <section style="margin-bottom: 48px;">
        <h2 style="font-size: 20px; font-weight: 700; color: var(--text-ink); margin: 0 0 16px;">
          ⚔️ Popular {platform.name} Comparisons
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px;">
          {relatedComparisons.map((c) => (
            <a
              href={`/compare/${c.slug}`}
              class="card-base"
              style="padding: 16px 20px; text-decoration: none; display: flex; flex-direction: column; gap: 8px; transition: all 0.15s ease;"
            >
              <span style="font-size: 15px; font-weight: 600; color: var(--text-ink);">
                {c.title.split(":")[0]}
              </span>
              <span style="font-size: 12px; color: var(--text-mute); line-height: 1.4;">
                {c.headline}
              </span>
              <span style="font-size: 12px; font-weight: 600; color: var(--color-primary); margin-top: 4px;">
                Compare Fees →
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- ─── Frequently Asked Questions ─────────────── -->
    <section style="margin-bottom: 60px;">
      <h2 style="font-size: 20px; font-weight: 700; color: var(--text-ink); margin: 0 0 16px;">
        💬 Frequently Asked Questions about {platform.name} Fees
      </h2>
      <div style="display: flex; flex-direction: column; gap: 12px;">
        {platform.faqs.map((faq) => (
          <details class="card-base" style="padding: 16px 20px; cursor: pointer;">
            <summary style="font-size: 15px; font-weight: 600; color: var(--text-ink); outline: none;">
              {faq.question}
            </summary>
            <p style="font-size: 14px; color: var(--text-body); line-height: 1.65; margin: 12px 0 0;">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>

    <!-- Bottom Matrix CTA Banner -->
    <section
      class="card-base"
      style="padding: 36px; text-align: center; background: linear-gradient(135deg, rgba(245, 158, 11, 0.1), rgba(16, 185, 129, 0.08)); border: 1px solid rgba(245, 158, 11, 0.3);"
    >
      <h2 style="font-size: 24px; font-weight: 700; color: var(--text-ink); margin: 0 0 10px;">
        See How {platform.name} Ranks Across All 14 Platforms
      </h2>
      <p style="font-size: 15px; color: var(--text-body); max-width: 580px; margin: 0 auto 20px; line-height: 1.6;">
        Test international card surcharges, PayPal toggles, physical COGS & shipping costs, and reverse target pricing in our full interactive comparison matrix.
      </p>
      <a
        href="/#calculator"
        style="display: inline-block; padding: 12px 28px; border-radius: 100px; background: var(--color-primary); color: #0b0f17; font-weight: 700; font-size: 14px; text-decoration: none; box-shadow: 0 4px 20px rgba(245, 158, 11, 0.35);"
      >
        Open Full 14-Platform Matrix →
      </a>
    </section>
  </main>

  <RateReportModal />
  <Footer />
</Layout>

<!-- ─── Interactive Mini-Calculator Script ───────── -->
<script is:inline define:vars={{
  varRate: platform.calcDefaults.variableRate,
  fixFee: platform.calcDefaults.fixedFee,
  moFee: platform.calcDefaults.monthlyFee
}}>
  (function () {
    const pSlider = document.getElementById("mini-price-slider");
    const pInput = document.getElementById("mini-price-input");
    const vSlider = document.getElementById("mini-vol-slider");
    const vInput = document.getElementById("mini-vol-input");

    const grossEl = document.getElementById("mini-res-gross");
    const feesEl = document.getElementById("mini-res-fees");
    const netEl = document.getElementById("mini-res-net");
    const marginEl = document.getElementById("mini-res-margin");

    function recalc() {
      const price = parseFloat(pInput?.value || "25") || 25;
      const vol = parseFloat(vInput?.value || "50") || 50;

      const gross = price * vol;
      const totalFees = (varRate * gross) + (fixFee * vol) + moFee;
      const net = Math.max(0, gross - totalFees);
      const margin = gross > 0 ? (net / gross) * 100 : 0;

      if (grossEl) grossEl.textContent = "$" + gross.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (feesEl) feesEl.textContent = "−$" + totalFees.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (netEl) netEl.textContent = "$" + net.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (marginEl) marginEl.textContent = margin.toFixed(1) + "%";
    }

    if (pSlider && pInput) {
      pSlider.addEventListener("input", function () {
        pInput.value = pSlider.value;
        recalc();
      });
      pInput.addEventListener("input", function () {
        pSlider.value = pInput.value;
        recalc();
      });
    }

    if (vSlider && vInput) {
      vSlider.addEventListener("input", function () {
        vInput.value = vSlider.value;
        recalc();
      });
      vInput.addEventListener("input", function () {
        vSlider.value = vInput.value;
        recalc();
      });
    }

    recalc();
  })();
</script>

