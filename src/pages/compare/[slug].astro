---
// src/pages/compare/[slug].astro
// Programmatic SEO Comparison Page with Real-Time Side-by-Side Delta Calculator

import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import RateReportModal from "../../components/RateReportModal.astro";
import { ALL_COMPARISONS, type ComparisonPair } from "../../data/comparisons";
import { PLATFORMS_DATA } from "../../data/platforms";

export async function getStaticPaths() {
  return ALL_COMPARISONS.map((comparison) => {
    const p1 = PLATFORMS_DATA[comparison.p1Id];
    const p2 = PLATFORMS_DATA[comparison.p2Id];
    return {
      params: { slug: comparison.slug },
      props: { comparison, p1, p2 },
    };
  });
}

interface Props {
  comparison: ComparisonPair;
  p1: typeof PLATFORMS_DATA[string];
  p2: typeof PLATFORMS_DATA[string];
}

const { comparison, p1, p2 } = Astro.props;

// Default price & volume for interactive comparison
const defaultPrice = 35;
const defaultVolume = 50;

function calcFee(price: number, volume: number, p: typeof p1) {
  const gross = price * volume;
  const fees = (p.calcDefaults.variableRate * gross) + (p.calcDefaults.fixedFee * volume) + p.calcDefaults.monthlyFee;
  const net = Math.max(0, gross - fees);
  const rate = gross > 0 ? (fees / gross) * 100 : 0;
  return { gross, fees, net, rate };
}

const p1Initial = calcFee(defaultPrice, defaultVolume, p1);
const p2Initial = calcFee(defaultPrice, defaultVolume, p2);
const initialDelta = Math.abs(p1Initial.net - p2Initial.net);
const initialWinner = p1Initial.net >= p2Initial.net ? p1 : p2;

// Schema.org Structured Data
const schemaJson = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": comparison.title,
    "description": comparison.metaDescription,
    "author": {
      "@type": "Organization",
      "name": "Platform Fee Matrix"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": comparison.faqs.map((f) => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": f.answer
      }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://platformfeematrix.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Compare",
        "item": "https://platformfeematrix.com/compare"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": `${p1.name} vs ${p2.name}`,
        "item": `https://platformfeematrix.com/compare/${comparison.slug}`
      }
    ]
  }
];
---

<Layout
  title={`${comparison.title} | Platform Fee Matrix`}
  description={comparison.metaDescription}
  schemaJson={schemaJson}
>
  <Nav />

  <main style="max-width: 1040px; margin: 0 auto; padding: 48px 24px 80px;">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb" style="margin-bottom: 24px; font-size: 13px;">
      <ol style="display: flex; align-items: center; gap: 8px; list-style: none; padding: 0; margin: 0; color: var(--text-mute); flex-wrap: wrap;">
        <li><a href="/" style="color: var(--text-mute); text-decoration: none;">Home</a></li>
        <li><span>/</span></li>
        <li><a href="/compare" style="color: var(--text-mute); text-decoration: none;">Compare</a></li>
        <li><span>/</span></li>
        <li style="color: var(--text-ink); font-weight: 500;">{p1.name} vs {p2.name}</li>
      </ol>
    </nav>

    <!-- Matchup Hero -->
    <header style="text-align: center; margin-bottom: 40px;">
      <!-- VS Badges & Logos Banner -->
      <div style="display: inline-flex; align-items: center; justify-content: center; gap: 20px; margin-bottom: 20px; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 10px; padding: 8px 16px; border-radius: 100px; background: var(--bg-card); border: 1px solid var(--border-hairline);">
          <img src={p1.icon} width="28" height="28" alt={p1.name} style="border-radius: 6px;" />
          <span style="font-size: 15px; font-weight: 700; color: var(--text-ink);">{p1.name}</span>
        </div>
        <span style="font-size: 16px; font-weight: 800; color: var(--color-primary); font-family: var(--font-mono); padding: 4px 10px; background: rgba(245, 158, 11, 0.15); border-radius: 100px; border: 1px solid rgba(245, 158, 11, 0.3);">
          VS
        </span>
        <div style="display: flex; align-items: center; gap: 10px; padding: 8px 16px; border-radius: 100px; background: var(--bg-card); border: 1px solid var(--border-hairline);">
          <img src={p2.icon} width="28" height="28" alt={p2.name} style="border-radius: 6px;" />
          <span style="font-size: 15px; font-weight: 700; color: var(--text-ink);">{p2.name}</span>
        </div>
      </div>

      <h1 style="font-size: clamp(28px, 4.5vw, 42px); font-weight: 700; color: var(--text-ink); margin: 0 0 14px; letter-spacing: -0.5px;">
        {comparison.headline}
      </h1>
      <p style="font-size: 16px; color: var(--text-body); max-width: 760px; margin: 0 auto; line-height: 1.65;">
        {comparison.verdictSummary}
      </p>
    </header>

    <!-- ─── Interactive Side-by-Side Delta Calculator ─── -->
    <section
      class="card-base"
      style="padding: 28px; margin-bottom: 44px; border: 1px solid rgba(245, 158, 11, 0.3); background: var(--bg-card-soft);"
    >
      <div style="text-align: center; margin-bottom: 24px;">
        <h2 style="font-size: 20px; font-weight: 700; color: var(--text-ink); margin: 0 0 6px;">
          ⚡ Side-by-Side Profit Delta Calculator
        </h2>
        <p style="font-size: 13px; color: var(--text-mute); margin: 0;">
          Test your exact selling price to see which platform puts more cash in your bank account every month.
        </p>
      </div>

      <!-- Controls -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px;" class="side-calc-controls">
        <div>
          <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
            <label for="side-price-input" style="font-size: 13px; font-weight: 600; color: var(--text-ink);">Product Price ($)</label>
            <input
              type="number"
              id="side-price-input"
              min="1"
              value={defaultPrice}
              style="width: 80px; height: 28px; padding: 0 6px; font-size: 13px; font-weight: 600; text-align: right; background: var(--bg-input); border: 1px solid var(--border-hairline); border-radius: 6px; color: var(--text-ink); font-family: var(--font-mono);"
            />
          </div>
          <input
            type="range"
            id="side-price-slider"
            min="1"
            max="1000"
            value={defaultPrice}
            style="width: 100%; accent-color: var(--color-primary);"
            aria-label="Comparison product price slider"
          />
        </div>
        <div>
          <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
            <label for="side-vol-input" style="font-size: 13px; font-weight: 600; color: var(--text-ink);">Monthly Sales (Units)</label>
            <input
              type="number"
              id="side-vol-input"
              min="1"
              value={defaultVolume}
              style="width: 80px; height: 28px; padding: 0 6px; font-size: 13px; font-weight: 600; text-align: right; background: var(--bg-input); border: 1px solid var(--border-hairline); border-radius: 6px; color: var(--text-ink); font-family: var(--font-mono);"
            />
          </div>
          <input
            type="range"
            id="side-vol-slider"
            min="1"
            max="500"
            value={defaultVolume}
            style="width: 100%; accent-color: var(--color-primary);"
            aria-label="Comparison monthly sales volume slider"
          />
        </div>
      </div>

      <!-- Side-by-Side Columns -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px;" class="side-calc-cards">
        <!-- Platform 1 Result -->
        <div id="side-card-p1" class="card-base" style="padding: 20px; border: 1px solid var(--border-hairline); background: var(--bg-card);">
          <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
            <img src={p1.icon} width="24" height="24" alt={p1.name} style="border-radius: 4px;" />
            <h3 style="font-size: 16px; font-weight: 700; color: var(--text-ink); margin: 0;">{p1.name}</h3>
          </div>
          <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 13px;">
            <span style="color: var(--text-mute);">Fees:</span>
            <span id="side-p1-fees" style="color: var(--color-error); font-family: var(--font-mono); font-weight: 600;">−${p1Initial.fees.toFixed(2)}</span>
          </div>
          <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 13px;">
            <span style="color: var(--text-mute);">Effective Fee Rate:</span>
            <span id="side-p1-rate" style="color: var(--text-ink); font-family: var(--font-mono); font-weight: 600;">{p1Initial.rate.toFixed(1)}%</span>
          </div>
          <div style="height: 1px; background: var(--border-hairline); margin: 10px 0;"></div>
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: 14px; font-weight: 600; color: var(--text-ink);">Take-Home:</span>
            <span id="side-p1-net" style="font-size: 20px; font-weight: 700; color: var(--color-profit); font-family: var(--font-mono);">${p1Initial.net.toFixed(2)}</span>
          </div>
          <div style="margin-top: 14px; padding-top: 10px; border-top: 1px dashed var(--border-hairline); display: flex; align-items: center; justify-content: space-between; font-size: 11px;">
            <span style="display: inline-flex; align-items: center; gap: 5px; color: var(--text-mute);">
              <span style="width: 6px; height: 6px; border-radius: 50%; background: #10b981;"></span>
              Verified: {p1.lastVerified}
            </span>
            <button
              type="button"
              onclick={`window.openRateReportModal && window.openRateReportModal('${p1.name}')`}
              style="background: none; border: none; padding: 0; color: var(--color-primary); cursor: pointer; font-size: 11px; font-weight: 600; text-decoration: underline;"
            >
              Report Change ↗
            </button>
          </div>
        </div>

        <!-- Platform 2 Result -->
        <div id="side-card-p2" class="card-base" style="padding: 20px; border: 1px solid var(--border-hairline); background: var(--bg-card);">
          <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
            <img src={p2.icon} width="24" height="24" alt={p2.name} style="border-radius: 4px;" />
            <h3 style="font-size: 16px; font-weight: 700; color: var(--text-ink); margin: 0;">{p2.name}</h3>
          </div>
          <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 13px;">
            <span style="color: var(--text-mute);">Fees:</span>
            <span id="side-p2-fees" style="color: var(--color-error); font-family: var(--font-mono); font-weight: 600;">−${p2Initial.fees.toFixed(2)}</span>
          </div>
          <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 13px;">
            <span style="color: var(--text-mute);">Effective Fee Rate:</span>
            <span id="side-p2-rate" style="color: var(--text-ink); font-family: var(--font-mono); font-weight: 600;">{p2Initial.rate.toFixed(1)}%</span>
          </div>
          <div style="height: 1px; background: var(--border-hairline); margin: 10px 0;"></div>
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: 14px; font-weight: 600; color: var(--text-ink);">Take-Home:</span>
            <span id="side-p2-net" style="font-size: 20px; font-weight: 700; color: var(--color-profit); font-family: var(--font-mono);">${p2Initial.net.toFixed(2)}</span>
          </div>
          <div style="margin-top: 14px; padding-top: 10px; border-top: 1px dashed var(--border-hairline); display: flex; align-items: center; justify-content: space-between; font-size: 11px;">
            <span style="display: inline-flex; align-items: center; gap: 5px; color: var(--text-mute);">
              <span style="width: 6px; height: 6px; border-radius: 50%; background: #10b981;"></span>
              Verified: {p2.lastVerified}
            </span>
            <button
              type="button"
              onclick={`window.openRateReportModal && window.openRateReportModal('${p2.name}')`}
              style="background: none; border: none; padding: 0; color: var(--color-primary); cursor: pointer; font-size: 11px; font-weight: 600; text-decoration: underline;"
            >
              Report Change ↗
            </button>
          </div>
        </div>
      </div>

      <!-- Live Delta Banner -->
      <div
        id="side-delta-banner"
        style="padding: 14px 18px; border-radius: 8px; background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.3); text-align: center; font-size: 14px; font-weight: 600; color: var(--color-profit);"
      >
        🏆 <span id="side-winner-text">{initialWinner.name} puts an extra +${initialDelta.toFixed(2)} in your pocket each month</span>
      </div>
    </section>

    <!-- ─── Side-by-Side Comparison Table ───────────── -->
    <section style="margin-bottom: 48px;">
      <h2 style="font-size: 20px; font-weight: 700; color: var(--text-ink); margin: 0 0 16px;">
        📊 Key Differences: {p1.name} vs {p2.name}
      </h2>
      <div style="overflow-x: auto; border-radius: var(--radius-lg); border: 1px solid var(--border-hairline);">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 14px; background: var(--bg-card);">
          <thead>
            <tr style="border-bottom: 1px solid var(--border-hairline); background: rgba(0,0,0,0.2);">
              <th style="padding: 14px 18px; color: var(--text-mute); width: 28%;">Feature / Policy</th>
              <th style="padding: 14px 18px; color: var(--text-ink); width: 36%;">{p1.name}</th>
              <th style="padding: 14px 18px; color: var(--text-ink); width: 36%;">{p2.name}</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid var(--border-hairline);">
              <td style="padding: 14px 18px; font-weight: 600; color: var(--text-ink);">Pricing Model</td>
              <td style="padding: 14px 18px; color: var(--text-body);">{p1.feeFormula}</td>
              <td style="padding: 14px 18px; color: var(--text-body);">{p2.feeFormula}</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border-hairline);">
              <td style="padding: 14px 18px; font-weight: 600; color: var(--text-ink);">Tax Handling</td>
              <td style="padding: 14px 18px; color: var(--text-body);">{p1.taxMode}</td>
              <td style="padding: 14px 18px; color: var(--text-body);">{p2.taxMode}</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border-hairline);">
              <td style="padding: 14px 18px; font-weight: 600; color: var(--text-ink);">Payout Schedule</td>
              <td style="padding: 14px 18px; color: var(--text-body);">{p1.payoutSchedule}</td>
              <td style="padding: 14px 18px; color: var(--text-body);">{p2.payoutSchedule}</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border-hairline);">
              <td style="padding: 14px 18px; font-weight: 600; color: var(--text-ink);">Best Suited For</td>
              <td style="padding: 14px 18px; color: var(--text-body);">{p1.bestFor}</td>
              <td style="padding: 14px 18px; color: var(--text-body);">{p2.bestFor}</td>
            </tr>
            {comparison.tableHighlights.map((row) => (
              <tr style="border-bottom: 1px solid var(--border-hairline);">
                <td style="padding: 14px 18px; font-weight: 600; color: var(--text-ink);">{row.feature}</td>
                <td style={`padding: 14px 18px; font-weight: ${row.winner === 'p1' ? '600' : 'normal'}; color: ${row.winner === 'p1' ? 'var(--color-profit)' : 'var(--text-body)'};`}>
                  {row.winner === 'p1' ? '✓ ' : ''}{row.p1Value}
                </td>
                <td style={`padding: 14px 18px; font-weight: ${row.winner === 'p2' ? '600' : 'normal'}; color: ${row.winner === 'p2' ? 'var(--color-profit)' : 'var(--text-body)'};`}>
                  {row.winner === 'p2' ? '✓ ' : ''}{row.p2Value}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- ─── Scenario Breakdown Cards ───────────────── -->
    <section style="margin-bottom: 48px;">
      <h2 style="font-size: 20px; font-weight: 700; color: var(--text-ink); margin: 0 0 16px;">
        🎯 Which Platform Should You Choose?
      </h2>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;" class="scenario-grid">
        <div class="card-base" style="padding: 20px;">
          <h3 style="font-size: 15px; font-weight: 700; color: var(--color-primary); margin: 0 0 8px;">
            👤 Solo Creators & Indie Authors
          </h3>
          <p style="font-size: 13.5px; color: var(--text-body); line-height: 1.6; margin: 0;">
            {comparison.scenarioWinners.soloCreators}
          </p>
        </div>
        <div class="card-base" style="padding: 20px;">
          <h3 style="font-size: 15px; font-weight: 700; color: var(--color-primary); margin: 0 0 8px;">
            🌍 SaaS Builders & Global Software
          </h3>
          <p style="font-size: 13.5px; color: var(--text-body); line-height: 1.6; margin: 0;">
            {comparison.scenarioWinners.globalSaaS}
          </p>
        </div>
        <div class="card-base" style="padding: 20px;">
          <h3 style="font-size: 15px; font-weight: 700; color: var(--color-primary); margin: 0 0 8px;">
            📦 Physical Merchandise & Crafts
          </h3>
          <p style="font-size: 13.5px; color: var(--text-body); line-height: 1.6; margin: 0;">
            {comparison.scenarioWinners.physicalMerch}
          </p>
        </div>
        <div class="card-base" style="padding: 20px;">
          <h3 style="font-size: 15px; font-weight: 700; color: var(--color-primary); margin: 0 0 8px;">
            🚀 High-Volume Businesses
          </h3>
          <p style="font-size: 13.5px; color: var(--text-body); line-height: 1.6; margin: 0;">
            {comparison.scenarioWinners.highVolume}
          </p>
        </div>
      </div>
    </section>

    <!-- ─── Individual Platform Links ──────────────── -->
    <section style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 48px;" class="platform-cards-links">
      <div class="card-base" style="padding: 22px;">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 10px;">
          <img src={p1.icon} width="32" height="32" alt={p1.name} style="border-radius: 6px;" />
          <div>
            <h3 style="font-size: 16px; font-weight: 700; color: var(--text-ink); margin: 0;">{p1.name} Deep Dive</h3>
            <span style="font-size: 12px; color: var(--text-mute);">{p1.badge}</span>
          </div>
        </div>
        <p style="font-size: 13px; color: var(--text-body); line-height: 1.6; margin: 0 0 14px;">
          {p1.headline}
        </p>
        <a
          href={`/platforms/${p1.slug}`}
          style="font-size: 13px; font-weight: 600; color: var(--color-primary); text-decoration: none;"
        >
          View full {p1.name} fee breakdown & calculator →
        </a>
      </div>

      <div class="card-base" style="padding: 22px;">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 10px;">
          <img src={p2.icon} width="32" height="32" alt={p2.name} style="border-radius: 6px;" />
          <div>
            <h3 style="font-size: 16px; font-weight: 700; color: var(--text-ink); margin: 0;">{p2.name} Deep Dive</h3>
            <span style="font-size: 12px; color: var(--text-mute);">{p2.badge}</span>
          </div>
        </div>
        <p style="font-size: 13px; color: var(--text-body); line-height: 1.6; margin: 0 0 14px;">
          {p2.headline}
        </p>
        <a
          href={`/platforms/${p2.slug}`}
          style="font-size: 13px; font-weight: 600; color: var(--color-primary); text-decoration: none;"
        >
          View full {p2.name} fee breakdown & calculator →
        </a>
      </div>
    </section>

    <!-- ─── FAQ Section ────────────────────────────── -->
    <section style="margin-bottom: 60px;">
      <h2 style="font-size: 20px; font-weight: 700; color: var(--text-ink); margin: 0 0 16px;">
        💬 Frequently Asked Questions: {p1.name} vs {p2.name}
      </h2>
      <div style="display: flex; flex-direction: column; gap: 12px;">
        {comparison.faqs.map((faq) => (
          <details class="card-base" style="padding: 16px 20px; cursor: pointer;">
            <summary style="font-size: 15px; font-weight: 600; color: var(--text-ink); outline: none;">
              {faq.question}
            </summary>
            <p style="font-size: 14px; color: var(--text-body); line-height: 1.65; margin: 12px 0 0;">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>

    <!-- Bottom Full Matrix CTA Banner -->
    <section
      class="card-base"
      style="padding: 36px; text-align: center; background: linear-gradient(135deg, rgba(245, 158, 11, 0.1), rgba(16, 185, 129, 0.08)); border: 1px solid rgba(245, 158, 11, 0.3);"
    >
      <h2 style="font-size: 24px; font-weight: 700; color: var(--text-ink); margin: 0 0 10px;">
        Compare {p1.name} and {p2.name} Across All 14 Platforms
      </h2>
      <p style="font-size: 15px; color: var(--text-body); max-width: 580px; margin: 0 auto 20px; line-height: 1.6;">
        Explore live currency conversion, physical COGS & shipping deductions, and target take-home pricing in the full interactive fee matrix.
      </p>
      <a
        href="/#calculator"
        style="display: inline-block; padding: 12px 28px; border-radius: 100px; background: var(--color-primary); color: #0b0f17; font-weight: 700; font-size: 14px; text-decoration: none; box-shadow: 0 4px 20px rgba(245, 158, 11, 0.35);"
      >
        Open Full Interactive Matrix →
      </a>
    </section>
  </main>

  <RateReportModal />
  <Footer />
</Layout>

<!-- ─── Interactive Side-by-Side Calculator Script ─ -->
<script is:inline define:vars={{
  p1Name: p1.name,
  p1VarRate: p1.calcDefaults.variableRate,
  p1FixFee: p1.calcDefaults.fixedFee,
  p1MoFee: p1.calcDefaults.monthlyFee,
  p2Name: p2.name,
  p2VarRate: p2.calcDefaults.variableRate,
  p2FixFee: p2.calcDefaults.fixedFee,
  p2MoFee: p2.calcDefaults.monthlyFee,
}}>
  (function () {
    const pSlider = document.getElementById("side-price-slider");
    const pInput = document.getElementById("side-price-input");
    const vSlider = document.getElementById("side-vol-slider");
    const vInput = document.getElementById("side-vol-input");

    const p1FeesEl = document.getElementById("side-p1-fees");
    const p1RateEl = document.getElementById("side-p1-rate");
    const p1NetEl = document.getElementById("side-p1-net");

    const p2FeesEl = document.getElementById("side-p2-fees");
    const p2RateEl = document.getElementById("side-p2-rate");
    const p2NetEl = document.getElementById("side-p2-net");

    const winnerTextEl = document.getElementById("side-winner-text");
    const p1Card = document.getElementById("side-card-p1");
    const p2Card = document.getElementById("side-card-p2");

    function recalc() {
      const price = parseFloat(pInput?.value || "35") || 35;
      const vol = parseFloat(vInput?.value || "50") || 50;

      const gross = price * vol;

      const p1Fees = (p1VarRate * gross) + (p1FixFee * vol) + p1MoFee;
      const p1Net = Math.max(0, gross - p1Fees);
      const p1Rate = gross > 0 ? (p1Fees / gross) * 100 : 0;

      const p2Fees = (p2VarRate * gross) + (p2FixFee * vol) + p2MoFee;
      const p2Net = Math.max(0, gross - p2Fees);
      const p2Rate = gross > 0 ? (p2Fees / gross) * 100 : 0;

      const fmt = (n) => "$" + n.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });

      if (p1FeesEl) p1FeesEl.textContent = "−" + fmt(p1Fees);
      if (p1RateEl) p1RateEl.textContent = p1Rate.toFixed(1) + "%";
      if (p1NetEl) p1NetEl.textContent = fmt(p1Net);

      if (p2FeesEl) p2FeesEl.textContent = "−" + fmt(p2Fees);
      if (p2RateEl) p2RateEl.textContent = p2Rate.toFixed(1) + "%";
      if (p2NetEl) p2NetEl.textContent = fmt(p2Net);

      const delta = Math.abs(p1Net - p2Net);
      if (Math.abs(p1Net - p2Net) < 0.5) {
        if (winnerTextEl) winnerTextEl.textContent = "⚖️ Both platforms deliver virtually identical profit at this volume";
        if (p1Card) p1Card.style.borderColor = "var(--border-hairline)";
        if (p2Card) p2Card.style.borderColor = "var(--border-hairline)";
      } else if (p1Net > p2Net) {
        if (winnerTextEl) winnerTextEl.textContent = "🏆 " + p1Name + " puts an extra +" + fmt(delta) + " in your pocket each month";
        if (p1Card) p1Card.style.borderColor = "var(--color-profit)";
        if (p2Card) p2Card.style.borderColor = "var(--border-hairline)";
      } else {
        if (winnerTextEl) winnerTextEl.textContent = "🏆 " + p2Name + " puts an extra +" + fmt(delta) + " in your pocket each month";
        if (p2Card) p2Card.style.borderColor = "var(--color-profit)";
        if (p1Card) p1Card.style.borderColor = "var(--border-hairline)";
      }
    }

    if (pSlider && pInput) {
      pSlider.addEventListener("input", function () {
        pInput.value = pSlider.value;
        recalc();
      });
      pInput.addEventListener("input", function () {
        pSlider.value = pInput.value;
        recalc();
      });
    }

    if (vSlider && vInput) {
      vSlider.addEventListener("input", function () {
        vInput.value = vSlider.value;
        recalc();
      });
      vInput.addEventListener("input", function () {
        vSlider.value = vInput.value;
        recalc();
      });
    }

    recalc();
  })();
</script>

<style>
  @media (max-width: 768px) {
    .side-calc-controls,
    .side-calc-cards,
    .scenario-grid,
    .platform-cards-links {
      grid-template-columns: 1fr !important;
    }
  }
</style>
