const schemaJson = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Digital Creator & Freelance Platforms Fee Directory",
  "url": "https://platformfeematrix.com/platforms",
  "description": "Comprehensive directory and fee comparison of 14 leading creator storefronts, payment gateways, and freelance marketplaces.",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": platforms.map((p, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": p.name,
      "description": p.description,
      "url": `https://platformfeematrix.com/platforms#${p.id}`
    }))
  }
};
---

<Layout
  title="All 14 Creator & Digital Product Platforms Compared | Platform Fee Matrix"
  description="Explore detailed fee breakdowns, tax compliance modes, payout timelines, and pros/cons for Gumroad, Lemon Squeezy, Stripe, Payhip, Whop, Paddle, Fiverr, Upwork, and more."
  schemaJson={schemaJson}
>
  <Nav />

  <!-- ─── Header ─────────────────────────────────────── -->
  <section
    style="
    position: relative;
    padding: 70px 24px 30px;
    text-align: center;
  "
  >
    <div style="max-width: 860px; margin: 0 auto;">
      <div class="reveal-on-scroll stagger-1 hero-eyebrow" style="margin-bottom: 16px;">
        <span
          style="
          background: linear-gradient(135deg, #F59E0B, #D97706);
          color: #0B0F17;
          font-size: 10px;
          font-weight: 700;
          padding: 3px 10px;
          border-radius: 100px;
          letter-spacing: 0.05em;
          box-shadow: 0 0 10px rgba(245, 158, 11, 0.5);
          margin-right: 4px;
          flex-shrink: 0;
        "
          >PLATFORM DIRECTORY</span
        >
        <span>14 Platforms · Fee Structures · Tax Models · Payout Rules</span>
      </div>

      <h1 class="reveal-on-scroll stagger-2 hero-headline" style="font-size: clamp(28px, 4.5vw, 44px); margin-bottom: 16px;">
        Compare All 14 Creator Platforms
      </h1>

      <p
        class="reveal-on-scroll stagger-3"
        style="
        font-size: 17px;
        color: var(--text-body);
        line-height: 1.65;
        max-width: 680px;
        margin: 0 auto;
      "
      >
        Understand the legal, tax, and fee implications of each platform before choosing where to sell your digital goods, courses, or services.
      </p>
    </div>
  </section>

  <!-- ─── Platforms Grid ─────────────────────────────── -->
  <section
    class="platforms-directory-section"
    style="
    padding: 20px 24px 80px;
    max-width: 1200px;
    margin: 0 auto;
  "
  >
    <div
      style="
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
      gap: 20px;
    "
    >
      {
        platforms.map((p) => (
          <article
            id={p.id}
            class="card-base"
            style="
            padding: 28px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: transform 0.2s ease, border-color 0.2s ease;
          "
          >
            <div>
              <!-- Card Header -->
              <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 16px;">
                <div style="display: flex; align-items: center; gap: 12px;">
                  <img src={p.icon} width="32" height="32" alt={p.name} style="border-radius: 6px;" />
                  <div>
                    <h2 style="font-size: 18px; font-weight: 700; color: var(--text-ink); margin: 0; letter-spacing: -0.3px;">
                      <a href={`/platforms/${p.id}`} style="color: inherit; text-decoration: none;" onmouseover="this.style.color='var(--color-primary)'" onmouseout="this.style.color='var(--text-ink)'">
                        {p.name}
                      </a>
                    </h2>
                    <span style="font-size: 12px; color: var(--text-mute); font-family: var(--font-mono);">
                      {p.taxMode.split('(')[0]}
                    </span>
                  </div>
                </div>
                <span
                  class="badge"
                  style={`background: ${p.badgeColor}15; color: ${p.badgeColor}; border: 1px solid ${p.badgeColor}35; font-size: 11px;`}
                >
                  {p.badge}
                </span>
              </div>

              <p style="font-size: 14px; color: var(--text-body); line-height: 1.6; margin: 0 0 16px;">
                {p.description}
              </p>

              <!-- Fee Pill -->
              <div
                style="
                background: rgba(255, 255, 255, 0.03);
                border: 1px solid var(--border-hairline);
                border-radius: 10px;
                padding: 12px 14px;
                margin-bottom: 16px;
              "
              >
                <span style="font-size: 11px; font-family: var(--font-mono); text-transform: uppercase; color: var(--text-mute); display: block; margin-bottom: 4px;">
                  Fee Structure
                </span>
                <span style="font-size: 13px; font-weight: 600; color: var(--color-primary); font-family: var(--font-mono);">
                  {p.feeFormula}
                </span>
              </div>

              <!-- Pros / Cons -->
              <div style="margin-bottom: 16px;">
                <p style="font-size: 12px; font-weight: 600; color: var(--color-profit); margin: 0 0 6px;">
                  ✓ Key Advantages:
                </p>
                <ul style="margin: 0 0 12px; padding-left: 18px; font-size: 13px; color: var(--text-body); line-height: 1.5;">
                  {p.pros.map((pro) => <li>{pro}</li>)}
                </ul>

                <p style="font-size: 12px; font-weight: 600; color: var(--color-error); margin: 0 0 6px;">
                  ⚠ Considerations:
                </p>
                <ul style="margin: 0; padding-left: 18px; font-size: 13px; color: var(--text-mute); line-height: 1.5;">
                  {p.cons.map((con) => <li>{con}</li>)}
                </ul>
              </div>
            </div>

            <!-- Card Footer / Actions -->
            <div style="border-top: 1px solid var(--border-hairline); padding-top: 14px; margin-top: 12px; display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap;">
              <a
                href={`/platforms/${p.id}`}
                style="
                  font-size: 12.5px;
                  font-weight: 600;
                  color: var(--color-primary);
                  text-decoration: none;
                  display: inline-flex;
                  align-items: center;
                  gap: 4px;
                  transition: gap 0.15s ease;
                "
                onmouseover="this.style.textDecoration='underline'"
                onmouseout="this.style.textDecoration='none'"
              >
                Full Fee Guide & Breakdown →
              </a>
              <a
                href="/calculator"
                style="
                display: inline-flex;
                align-items: center;
                gap: 4px;
                background: rgba(255, 255, 255, 0.04);
                border: 1px solid var(--border-hairline);
                color: var(--text-ink);
                padding: 5px 12px;
                border-radius: 100px;
                font-size: 12px;
                font-weight: 500;
                text-decoration: none;
                transition: all 0.15s ease;
              "
                onmouseover="this.style.background='rgba(245, 158, 11, 0.1)';this.style.borderColor='var(--color-primary)';"
                onmouseout="this.style.background='rgba(255, 255, 255, 0.04)';this.style.borderColor='var(--border-hairline)';"
              >
                Simulate Fee ↗
              </a>
              <!-- Trust Badge & Report Row -->
              <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 10px; padding-top: 8px; border-top: 1px solid var(--border-hairline); font-size: 11px; color: var(--text-mute); font-family: var(--font-mono); width: 100%;">
                <span><span style="color: var(--color-profit); font-size: 8px;">●</span> Verified: Sep 2026</span>
                <button type="button" class="btn-report-rate" data-platform={p.name} style="background:none; border:none; color:var(--text-mute); font-size:11px; cursor:pointer;" onmouseover="this.style.color='var(--color-primary)'" onmouseout="this.style.color='var(--text-mute)'">
                  Report Change ↗
                </button>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <PlatformModal />
  <RateReportModal />
  <Footer />
</Layout>

<style>
  @media (max-width: 768px) {
    .platforms-directory-section {
      padding: 16px 16px 60px !important;
    }
    .platforms-directory-section article {
      padding: 20px 16px !important;
    }
  }
</style>
