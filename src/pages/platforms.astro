  },
  {
    id: "stan",
    name: "Stan Store",
    icon: "/icons/stan.svg",
    category: "monthly",
    badge: "Link-in-Bio Store",
    badgeColor: "#F97316",
    feeFormula: "$29/mo Creator Plan · 0% transaction fee + 2.9% + $0.30 card",
    taxMode: "Self-File Taxes",
    payoutTime: "Direct Stripe payouts (1–2 business days)",
