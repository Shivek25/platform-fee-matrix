---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PlatformModal from "../components/PlatformModal.astro";
import RateReportModal from "../components/RateReportModal.astro";

interface PlatformDetail {
  id: string;
  name: string;
  icon: string;
  category: string;
  badge: string;
  badgeColor: string;
  feeFormula: string;
  taxMode: string;
  payoutTime: string;
  bestFor: string;
  pros: string[];
  cons: string[];
  description: string;
}

const platforms: PlatformDetail[] = [
  {
    id: "lemonsqueezy",
    name: "Lemon Squeezy",
    icon: "/icons/lemonsqueezy.svg",
    category: "mor",
    badge: "Merchant of Record",
    badgeColor: "#10B981",
    feeFormula: "5% + $0.50 per transaction (+1.5% PayPal/intl)",
    taxMode: "Full Auto-Remit (Global VAT, GST, US Sales Tax)",
    payoutTime: "Weekly or Bi-weekly (direct bank deposit / PayPal)",
    bestFor: "Software, SaaS licenses, templates, and digital downloads sold worldwide",
    pros: [
      "Zero tax compliance liability (handles EU VAT, UK VAT, US sales taxes automatically)",
      "Built-in license key generation & recurring subscription engine",
      "Hosted high-converting checkout overlays & customer portal"
