<Layout
  title="Fee Calculator | Compare PayPal, Stripe, Fiverr, Etsy & 14 Platform Fees"
  description="Free interactive fee calculator & platform fee comparison. Calculate exact take-home profit & seller fees across PayPal (goods & services), Stripe, Etsy, Fiverr, Gumroad, Whop, and 14+ platforms."
  keywords="fee calculator, platform fee calculator, paypal fee calculator, paypal goods and services fee calculator, stripe fee calculator, etsy fee calculator, fiverr fee calculator, upwork fee calculator, gumroad fee calculator, lemon squeezy fee calculator, whop fee calculator, platform fee, fee comparison, creator fee calculator, seller fee calculator, payment processing fees"
  schemaJson={schemaJson}
