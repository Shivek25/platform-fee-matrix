import { COMPARISONS_DATA } from "../data/comparisons";
import { PLATFORMS_DATA } from "../data/platforms";

const featuredComparisons = [
  "gumroad-vs-lemon-squeezy",
  "stripe-vs-paddle",
  "fiverr-vs-upwork",
  "gumroad-vs-etsy"
].map((slug) => {
  const c = COMPARISONS_DATA[slug];
  const p1 = PLATFORMS_DATA[c.p1Id];
  const p2 = PLATFORMS_DATA[c.p2Id];
  return {
    slug,
    title: `${p1.name} vs ${p2.name}`,
    p1Name: p1.name,
    p2Name: p2.name,
    p1Icon: p1.icon,
    p2Icon: p2.icon,
    verdict: c.verdictSummary,
  };
});

const homeFaqs = [
  {
    q: "How do you calculate PayPal Goods and Services fees?",
    a: "Standard PayPal Goods and Services transactions in the US typically cost 2.99% to 3.49% + $0.49 per domestic payment. For cross-border transactions, PayPal adds an extra 1.50% international surcharge plus currency exchange spread. Our fee calculator lets you toggle PayPal on or off to simulate your exact take-home profit versus standard Stripe card processing (2.9% + $0.30)."
  },
  {
    q: "How does the Fiverr fee calculator compute freelancer earnings?",
    a: "Fiverr retains a flat 20% seller service commission from every completed order. For instance, on a $100 gig order, Fiverr takes $20.00, giving the freelancer $80.00 net earnings before bank transfer or PayPal withdrawal fees. Our fee calculator accurately models Fiverr's 20% platform cut."
  },
  {
    q: "How are Etsy seller fees calculated on digital products?",
    a: "Etsy charges three main fees on digital product sales: a $0.20 listing fee (renewed every 4 months or after each purchase), a 6.5% transaction cut on the total sale price, and an Etsy Payments processing fee (typically 3.0% + $0.25 in the US). On a $10 digital printable, total fees equal roughly $1.40, leaving the creator with $8.60 net profit."
  },
  {
    q: "How do Stripe credit card processing fees compare to PayPal?",
    a: "Standard US Stripe card processing is 2.9% + $0.30 with zero monthly subscription fees. PayPal standard merchant checkout is 3.49% + $0.49. On a $50 sale, Stripe costs $1.75 in gateway fees while PayPal costs $2.24 — saving you $0.49 per order (~1% higher profit margin) when using Stripe."
  },
  {
    q: "What is the difference between a platform fee and a payment processing fee?",
    a: "A platform fee is what a software storefront or marketplace charges for hosting, licensing, file fulfillment, or audience discovery (e.g. Gumroad's 10%, Fiverr's 20%, or Etsy's 6.5%). A payment processing fee is charged by financial merchant networks (Stripe or PayPal, typically 2.9% + $0.30) to securely process card payments. Some platforms bundle both into one rate (e.g. Lemon Squeezy's 5% + $0.50), while others stack them on top."
  },
  {
    q: "Why do Merchant of Record (MoR) platforms charge higher fees than direct gateways?",
    a: "Merchant of Record platforms like Lemon Squeezy and Paddle (5% + $0.50) legally act as the reseller. They collect, calculate, file, and remit sales tax, EU VAT, and GST in 200+ countries, absorbing audit risk and legal liability so creators don't need expensive cross-border tax accounting software."
  },
  {
    q: "Which platform has the lowest fees for selling digital products?",
    a: "For creators with their own custom website or tax stack, Stripe Direct (2.9% + $0.30) or Payhip Pro ($99/mo + 0% platform fee) yield the highest net profit margin. For all-in-one storefronts with built-in affiliate and community features, Whop (3% + card fees) provides the lowest take-home cut."
  }
];

