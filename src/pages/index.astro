---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Calculator from "../components/Calculator.astro";
import GuideSection from "../components/GuideSection.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Platform Fee Matrix — Compare Gumroad vs Lemon Squeezy vs Payhip vs Stripe vs Whop Fees"
  description="Instantly compare net profit across Gumroad, Lemon Squeezy, Payhip, Stripe, and Whop with our free interactive fee calculator. Adjust price, volume, and payment options for real-time results."
>
  <Nav />

  <!-- ─── Hero Section ─────────────────────────────── -->
  <section style="
    position: relative;
    overflow: hidden;
    padding: 96px 24px 80px;
    background: var(--bg-page);
    text-align: center;
  ">
    <!-- Mesh gradient backdrop -->
    <div class="hero-gradient" style="
      position: absolute;
      inset: 0;
      z-index: 0;
    " aria-hidden="true"></div>

    <div style="position: relative; z-index: 1; max-width: 760px; margin: 0 auto;">

      <!-- Eyebrow badge -->
      <div style="
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--bg-card);
        border: 1px solid var(--border-hairline);
        border-radius: 100px;
        padding: 5px 14px 5px 8px;
        font-size: 13px;
        color: var(--text-body);
        margin-bottom: 32px;
        box-shadow: var(--shadow-card);
      ">
        <span style="
          background: #171717;
          color: #fff;
          font-size: 10px;
          font-weight: 600;
          padding: 2px 8px;
          border-radius: 100px;
          letter-spacing: 0.05em;
        ">NEW</span>
        <span>5 platforms. Real-time. No spreadsheet needed.</span>
      </div>

      <!-- Headline -->
      <h1 style="
        font-size: clamp(36px, 6vw, 56px);
        font-weight: 600;
        letter-spacing: -2.2px;
        color: var(--text-ink);
        line-height: 1.05;
        margin: 0 0 24px;
      ">
        Stop guessing.<br />
        Calculate your real take-home.
      </h1>

      <!-- Sub-headline -->
      <p style="
        font-size: 18px;
        color: var(--text-body);
        line-height: 1.65;
        max-width: 560px;
        margin: 0 auto 40px;
      ">
        The interactive fee calculator that shows you exactly how much Gumroad, Lemon Squeezy, Payhip, Stripe, and Whop actually cost — at your price, your volume, and your payment mix.
      </p>

      <!-- CTA row -->
      <div style="
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
      ">
        <a
          href="#calculator"
          id="hero-cta-primary"
          style="
            display: inline-flex;
            align-items: center;
            gap: 8px;
            height: 44px;
            padding: 0 20px;
            background: var(--color-primary);
            color: var(--bg-page);
            border-radius: 100px;
            font-size: 15px;
            font-weight: 500;
            text-decoration: none;
            transition: opacity 0.15s ease;
            letter-spacing: -0.2px;
          "
          onmouseover="this.style.opacity='0.85'"
          onmouseout="this.style.opacity='1'"
        >
          Open Calculator
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
        <a
          href="#guide"
          id="hero-cta-secondary"
          style="
            display: inline-flex;
            align-items: center;
            height: 44px;
            padding: 0 20px;
            background: var(--bg-card);
            color: var(--text-ink);
            border: 1px solid var(--border-hairline);
            border-radius: 100px;
            font-size: 15px;
            font-weight: 500;
            text-decoration: none;
            transition: background 0.15s ease;
            letter-spacing: -0.2px;
          "
          onmouseover="this.style.background='var(--bg-card-soft)'"
          onmouseout="this.style.background='var(--bg-card)'"
        >
          Read the Guide
        </a>
      </div>

      <!-- Platform logos/indicators strip -->
      <div style="
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 24px;
        margin-top: 56px;
        flex-wrap: wrap;
      ">
        {["Gumroad", "Lemon Squeezy", "Payhip", "Stripe", "Whop"].map((name) => (
          <div style="
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            color: var(--text-mute);
            padding: 6px 14px;
            border-radius: 100px;
            background: var(--bg-card);
            border: 1px solid var(--border-hairline);
          ">
            <span style="font-size: 11px; width: 6px; height: 6px; background: var(--border-hairline-strong); border-radius: 50%; display: inline-block;"></span>
            {name}
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ─── Stats Row ─────────────────────────────────── -->
  <section style="
    background: var(--bg-card);
    border-top: 1px solid var(--border-hairline);
    border-bottom: 1px solid var(--border-hairline);
    padding: 0;
  ">
    <div style="
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
    " class="stats-grid">
      {[
        { value: "5", label: "Platforms compared" },
        { value: "0ms", label: "Calculation latency" },
        { value: "3", label: "Toggle variables" },
        { value: "100%", label: "Client-side, no tracking" },
      ].map(({ value, label }) => (
        <div style="
          padding: 28px 24px;
          border-right: 1px solid var(--border-hairline);
          text-align: center;
        " class="stat-item">
          <p style="
            font-size: 28px;
            font-weight: 700;
            color: var(--text-ink);
            margin: 0 0 4px;
            letter-spacing: -1px;
            font-family: var(--font-mono);
          ">{value}</p>
          <p style="font-size: 13px; color: var(--text-mute); margin: 0;">{label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ─── Main Calculator ───────────────────────────── -->
  <Calculator />

  <!-- ─── Guide ─────────────────────────────────────── -->
  <GuideSection />

  <!-- ─── Bottom CTA Band ───────────────────────────── -->
  <section style="
    padding: 96px 24px;
    background: var(--color-primary);
    text-align: center;
  ">
    <div style="max-width: 600px; margin: 0 auto;">
      <p style="
        font-family: var(--font-mono);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: rgba(255,255,255,0.4);
        margin: 0 0 20px;
      ">Free forever</p>
      <h2 style="
        font-size: clamp(28px, 4vw, 40px);
        font-weight: 600;
        letter-spacing: -1.5px;
        color: #ffffff;
        margin: 0 0 20px;
        line-height: 1.1;
      ">Know your margin before you launch.</h2>
      <p style="
        font-size: 17px;
        color: rgba(255,255,255,0.6);
        margin: 0 0 40px;
        line-height: 1.6;
      ">Bookmark this tool. Share it with your creator friends. No sign-up required.</p>
      <a
        href="#calculator"
        style="
          display: inline-flex;
          align-items: center;
          gap: 8px;
          height: 48px;
          padding: 0 24px;
          background: #ffffff;
          color: #171717;
          border-radius: 100px;
          font-size: 15px;
          font-weight: 600;
          text-decoration: none;
          transition: opacity 0.15s ease;
          letter-spacing: -0.2px;
        "
        onmouseover="this.style.opacity='0.9'"
        onmouseout="this.style.opacity='1'"
      >
        Calculate Now
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  @media (max-width: 768px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }
    .stat-item:nth-child(2) {
      border-right: none !important;
    }
    .stat-item {
      border-bottom: 1px solid var(--border-hairline);
    }
  }
  @media (max-width: 480px) {
    .stats-grid {
      grid-template-columns: 1fr !important;
    }
    .stat-item {
      border-right: none !important;
    }
  }
</style>
