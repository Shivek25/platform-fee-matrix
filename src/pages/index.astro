      </div>

      <!-- Headline -->
      <h1
        class="reveal-on-scroll stagger-2 hero-headline"
        style="
        font-size: clamp(36px, 5.5vw, 62px);
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: -0.03em;
        margin: 0 auto 24px;
        max-width: 820px;
      "
