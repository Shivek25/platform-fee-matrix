        </a>
      </div>

      <!-- Platform indicators strip -->
      <!-- Desktop Layout: 5 - 5 - 5 -->
      <div class="hero-pills-container hero-pills-desktop">
        <!-- Row 1 (5 items) -->
        <div class="hero-pills-row">
