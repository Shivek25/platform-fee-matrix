---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Calculator from "../components/Calculator.astro";
import GuideSection from "../components/GuideSection.astro";
import Footer from "../components/Footer.astro";
import PlatformModal from "../components/PlatformModal.astro";
import EmbedModal from "../components/EmbedModal.astro";
import RateReportModal from "../components/RateReportModal.astro";
import { COMPARISONS_DATA } from "../data/comparisons";
import { PLATFORMS_DATA } from "../data/platforms";

const featuredComparisons = [
  "gumroad-vs-lemon-squeezy",
  "stripe-vs-paddle",
  "fiverr-vs-upwork",
  "gumroad-vs-etsy"
].map((slug) => {
  const c = COMPARISONS_DATA[slug];
  const p1 = PLATFORMS_DATA[c.p1Id];
  const p2 = PLATFORMS_DATA[c.p2Id];
  return {
    slug,
    title: `${p1.name} vs ${p2.name}`,
    p1Name: p1.name,
    p2Name: p2.name,
    p1Icon: p1.icon,
    p2Icon: p2.icon,
    verdict: c.verdictSummary,
  };
});

const schemaJson = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Platform Fee Matrix",
  "url": "https://platformfeematrix.com",
  "description": "Real-time fee calculator comparing net take-home profit and tax compliance across 14 top creator & freelance platforms.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://platformfeematrix.com/platforms?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};
---

<Layout
  title="Platform Fee Matrix | Compare 14 Digital Product & Creator Platform Fees"
  description="Instantly compare net profit across 14 creator platforms including Gumroad, Lemon Squeezy, Stripe, Payhip, Whop, Paddle, Fiverr, Upwork, and Etsy with our free interactive fee calculator."
  schemaJson={schemaJson}
>
  <Nav />

  <!-- ─── Hero Section ─────────────────────────────── -->
  <section
    class="hero-section"
    style="
    position: relative;
    overflow: hidden;
    padding: 110px 24px 90px;
    background: transparent;
    text-align: center;
  "
  >
    <!-- Mesh gradient backdrop -->
    <div
      class="hero-gradient"
      style="
      position: absolute;
      inset: 0;
      z-index: 0;
    "
      aria-hidden="true"
    >
    </div>

    <div
      style="position: relative; z-index: 1; max-width: 860px; margin: 0 auto;"
    >
      <!-- Eyebrow badge -->
      <div
        class="reveal-on-scroll stagger-1 hero-eyebrow"
        style="margin-bottom: 24px;"
      >
        <span
          style="
          background: linear-gradient(135deg, #F59E0B, #D97706);
          color: #0B0F17;
          font-size: 10px;
          font-weight: 700;
          padding: 3px 10px;
          border-radius: 100px;
          letter-spacing: 0.05em;
          box-shadow: 0 0 10px rgba(245, 158, 11, 0.5);
          margin-right: 4px;
          flex-shrink: 0;
        "
