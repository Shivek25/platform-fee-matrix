<script>
  function initStatCounters() {
    const statItems = document.querySelectorAll('.stat-item');
    const statObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const p = entry.target.querySelector('p:first-child');
          if (p && !p.hasAttribute('data-animated')) {
            p.setAttribute('data-animated', 'true');
            animateStatCounter(p);
          }
          statObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.3 });

    statItems.forEach((el) => statObserver.observe(el));
  }

  function animateStatCounter(el: Element) {
    const rawText = el.textContent ? el.textContent.trim() : '';
    const numMatch = rawText.match(/\d+/);
    if (!numMatch) return;

    const targetNum = parseInt(numMatch[0], 10);
    const prefix = rawText.substring(0, rawText.indexOf(numMatch[0]));
    const suffix = rawText.substring(rawText.indexOf(numMatch[0]) + numMatch[0].length);

    const duration = 1200;
    const startTime = performance.now();

    function step(now: number) {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      // Ease out expo curve
      const easedProgress = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);
      const currentNum = Math.floor(easedProgress * targetNum);
      el.textContent = `${prefix}${currentNum}${suffix}`;

      if (progress < 1) {
        requestAnimationFrame(step);
      } else {
        el.textContent = rawText;
      }
    }

    requestAnimationFrame(step);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStatCounters);
  } else {
    initStatCounters();
  }
</script>

<style>
  /* Secondary CTA Button */
  .hero-secondary-btn {
    display: inline-flex;
    align-items: center;
    height: 48px;
    padding: 0 24px;
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(12px);
    color: var(--text-ink);
    border: 1px solid var(--border-hairline-strong);
    border-radius: 100px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease;
    letter-spacing: -0.2px;
  }
  .hero-secondary-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(245, 158, 11, 0.3);
  }
  :global(html.light) .hero-secondary-btn {
    background: rgba(15, 23, 42, 0.04);
    border-color: rgba(15, 23, 42, 0.15);
  }
  :global(html.light) .hero-secondary-btn:hover {
    background: rgba(15, 23, 42, 0.08);
    border-color: rgba(217, 119, 6, 0.4);
  }

  /* Hero Platform Pills Container & Rows */
  .hero-pills-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    margin-top: 0;
  }
  .hero-pills-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  /* Desktop / Mobile Platform Pills Layout Switch */
  .hero-pills-desktop {
    display: flex !important;
  }
  .hero-pills-mobile {
    display: none !important;
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 64px 16px 44px !important;
    }
    .hero-eyebrow {
      font-size: 12px !important;
      padding: 5px 12px 5px 8px !important;
      gap: 8px !important;
    }
    .hero-pills-desktop {
      display: none !important;
    }
    .hero-pills-mobile {
      display: flex !important;
      gap: 10px !important;
      margin-top: 32px !important;
      width: 100% !important;
      max-width: 100% !important;
    }
    .hero-pills-mobile .hero-pills-row {
      gap: 8px 6px !important;
      flex-wrap: wrap !important;
      justify-content: center !important;
      width: 100% !important;
      max-width: 100% !important;
    }
    .hero-pills-mobile .hero-platform-pill {
      font-size: 13px !important;
      padding: 7px 12px !important;
      gap: 6px !important;
      white-space: nowrap !important;
    }
  }

  @media (max-width: 440px) {
    .hero-section {
      padding: 52px 14px 36px !important;
    }
    .hero-pills-mobile .hero-platform-pill {
      font-size: 12px !important;
      padding: 6px 10px !important;
      gap: 5px !important;
    }
    .hero-pills-mobile .hero-pills-row {
      gap: 6px 4px !important;
    }
  }

  /* Hero Platform Pills */
  .hero-platform-pill {
    display: flex;
    align-items: center;
    gap: 10px;
