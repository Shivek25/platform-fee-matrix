---
import "../styles/global.css";
import ScrollProgress from "../components/ScrollProgress.astro";
import FloatingDock from "../components/FloatingDock.astro";

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  schemaJson?: object | object[];
}

const {
  title = "Fee Calculator | Compare PayPal, Stripe, Fiverr, Etsy & 14 Platform Fees",
  description = "Free interactive fee calculator & platform fee comparison. Calculate exact take-home profit & seller fees across PayPal (goods & services), Stripe, Etsy, Fiverr, Gumroad, Whop, and 14+ platforms.",
  keywords = "fee calculator, platform fee calculator, paypal fee calculator, paypal goods and services fee calculator, stripe fee calculator, etsy fee calculator, fiverr fee calculator, upwork fee calculator, gumroad fee calculator, lemon squeezy fee calculator, whop fee calculator, platform fee, fee comparison, creator fee calculator, seller fee calculator, payment processing fees",
  canonical = `https://platformfeematrix.com${Astro.url.pathname.replace(/\/+$/, "") || "/"}`,
  ogType = "website",
  ogImage = "https://platformfeematrix.com/og-image.jpg",
  schemaJson,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link id="app-favicon" rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon-dark.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO & Indexing -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Platform Fee Matrix" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content="Platform Fee Matrix - Fee Calculator & Platform Fee Comparison" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Platform Fee Matrix - Fee Calculator & Platform Fee Comparison" />

    <!-- Structured Data (JSON-LD) -->
    {schemaJson && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(schemaJson)}
      />
    )}

    <!-- Fonts: Inter + JetBrains Mono from Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap"
      rel="stylesheet"
    />

    <!-- Dark/Light mode & dynamic favicon initialization -->
    <script is:inline>
      (function () {
        function updateFavicon(isLight) {
          let favicon = document.getElementById("app-favicon");
          const targetHref = isLight ? "/favicon-light.svg" : "/favicon-dark.svg";
          if (!favicon) {
            favicon = document.createElement("link");
            favicon.id = "app-favicon";
            favicon.rel = "icon";
            favicon.type = "image/svg+xml";
            document.head.appendChild(favicon);
          }
          favicon.setAttribute("href", targetHref);
        }

        const stored = localStorage.getItem("theme");
        const systemPrefersLight = window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches;
        const isLight = stored === "light" || (!stored && systemPrefersLight);

        if (isLight) {
          document.documentElement.classList.add("light");
          document.documentElement.classList.remove("dark");
        } else {
          document.documentElement.classList.add("dark");
          document.documentElement.classList.remove("light");
        }
        updateFavicon(isLight);

        // Instant reactivity when user switches theme in-app
        window.addEventListener("themechanged", function () {
          const currentIsLight = document.documentElement.classList.contains("light");
          updateFavicon(currentIsLight);
        });

        // Instant reactivity if OS theme changes without manual override
        if (window.matchMedia) {
          try {
            window.matchMedia("(prefers-color-scheme: light)").addEventListener("change", function (e) {
              if (!localStorage.getItem("theme")) {
                if (e.matches) {
                  document.documentElement.classList.add("light");
                  document.documentElement.classList.remove("dark");
                } else {
                  document.documentElement.classList.add("dark");
                  document.documentElement.classList.remove("light");
                }
                updateFavicon(e.matches);
              }
            });
          } catch (_) {}
        }
      })();
    </script>
  </head>
  <body class="bg-mesh-grid">
    <!-- Ambient Mouse-Following Spotlight (Strictly in Background) -->
    <div
      id="mouse-spotlight"
      class="mouse-spotlight-bg"
      aria-hidden="true"
    >
    </div>

    <!-- Ambient Floating Greenish Neon Orbs (Random Drifting Mesh Glow) -->
    <div class="bg-neon-orbs" aria-hidden="true">
      <div class="neon-orb-wrapper neon-orb-wrapper-1">
        <div class="neon-orb neon-orb-1"></div>
      </div>
      <div class="neon-orb-wrapper neon-orb-wrapper-2">
        <div class="neon-orb neon-orb-2"></div>
      </div>
      <div class="neon-orb-wrapper neon-orb-wrapper-3">
        <div class="neon-orb neon-orb-3"></div>
      </div>
    </div>

    <ScrollProgress />

    <div style="position: relative; z-index: 1;">
      <slot />
    </div>

    <FloatingDock />

    <!-- 60 FPS Mouse Spotlight & Interactive Parallax Orbs Tracking Script -->
    <script is:inline>
      (function () {
        let mouseX = window.innerWidth / 2;
        let mouseY = window.innerHeight / 3;
        let currentX = mouseX;
        let currentY = mouseY;
        let ticking = false;

        const spotlight = document.getElementById("mouse-spotlight");
        const orb1 = document.querySelector(".neon-orb-1");
        const orb2 = document.querySelector(".neon-orb-2");
        const orb3 = document.querySelector(".neon-orb-3");
        const neonOrbsContainer = document.querySelector(".bg-neon-orbs");
        const guideSection = document.getElementById("guide");

        function checkLightGuideSoftening() {
          if (guideSection && neonOrbsContainer && document.documentElement.classList.contains("light")) {
            const rect = guideSection.getBoundingClientRect();
            if (rect.top <= window.innerHeight - 50) {
              neonOrbsContainer.classList.add("guide-softened");
            } else {
              neonOrbsContainer.classList.remove("guide-softened");
            }
          } else if (neonOrbsContainer) {
            neonOrbsContainer.classList.remove("guide-softened");
          }
        }

        window.addEventListener("scroll", checkLightGuideSoftening, { passive: true });
        window.addEventListener("themechanged", checkLightGuideSoftening);
        checkLightGuideSoftening();

        window.addEventListener("mousemove", function (e) {
          mouseX = e.clientX;
          mouseY = e.clientY;

          if (!ticking) {
            window.requestAnimationFrame(function () {
              // Smooth lerp interpolation for soft fluid motion
              currentX += (mouseX - currentX) * 0.12;
              currentY += (mouseY - currentY) * 0.12;
              if (spotlight) {
                spotlight.style.setProperty("--spotlight-x", currentX + "px");
                spotlight.style.setProperty("--spotlight-y", currentY + "px");
              }

              // Interactive mouse parallax drift on floating neon orbs
              const offsetX = (currentX - window.innerWidth / 2) * 0.05;
              const offsetY = (currentY - window.innerHeight / 2) * 0.05;

              if (orb1) orb1.style.transform = `translate3d(${offsetX}px, ${offsetY}px, 0)`;
              if (orb2) orb2.style.transform = `translate3d(${-offsetX * 1.3}px, ${-offsetY * 1.3}px, 0)`;
              if (orb3) orb3.style.transform = `translate3d(${offsetX * 0.9}px, ${-offsetY * 0.9}px, 0)`;

              ticking = false;
            });
            ticking = true;
          }
        }, { passive: true });

        // Universal Scroll Reveal Observer for all pages
        function initScrollReveals() {
          const revealElements = document.querySelectorAll('.reveal-on-scroll, .reveal-3d');
          if (!revealElements.length) return;
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
              }
            });
          }, { threshold: 0.05, rootMargin: '0px 0px -20px 0px' });

          revealElements.forEach((el) => observer.observe(el));
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initScrollReveals);
        } else {
          initScrollReveals();
        }
      })();
    </script>
  </body>
</html>
