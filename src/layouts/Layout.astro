---
import "../styles/global.css";
import ScrollProgress from "../components/ScrollProgress.astro";
import FloatingDock from "../components/FloatingDock.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: string;
  schemaJson?: object | object[];
}

const {
  title = "Platform Fee Matrix | Compare Digital Product Platform Fees",
  description = "Compare net profit across Gumroad, Lemon Squeezy, Payhip, Stripe, and Whop with our real-time interactive fee calculator. Find the best platform for your digital products.",
  canonical = `https://platformfeematrix.com${Astro.url.pathname}`,
  ogType = "website",
  schemaJson,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Platform Fee Matrix" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {schemaJson && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(schemaJson)}
      />
    )}

    <!-- Fonts: Inter + JetBrains Mono from Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap"
      rel="stylesheet"
    />

    <!-- Dark mode initialization -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        if (stored === "light") {
          document.documentElement.classList.add("light");
        } else {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
  </head>
  <body class="bg-mesh-grid">
    <!-- Ambient Mouse-Following Spotlight (Strictly in Background) -->
    <div
      id="mouse-spotlight"
      class="mouse-spotlight-bg"
      aria-hidden="true"
    >
    </div>

    <!-- Ambient Floating Greenish Neon Orbs (Random Drifting Mesh Glow) -->
    <div class="bg-neon-orbs" aria-hidden="true">
      <div class="neon-orb-wrapper neon-orb-wrapper-1">
        <div class="neon-orb neon-orb-1"></div>
      </div>
      <div class="neon-orb-wrapper neon-orb-wrapper-2">
        <div class="neon-orb neon-orb-2"></div>
      </div>
      <div class="neon-orb-wrapper neon-orb-wrapper-3">
        <div class="neon-orb neon-orb-3"></div>
      </div>
    </div>

    <ScrollProgress />

    <div style="position: relative; z-index: 1;">
      <slot />
    </div>

    <FloatingDock />

    <!-- 60 FPS Mouse Spotlight & Interactive Parallax Orbs Tracking Script -->
    <script is:inline>
      (function () {
        let mouseX = window.innerWidth / 2;
        let mouseY = window.innerHeight / 3;
        let currentX = mouseX;
        let currentY = mouseY;
        let ticking = false;

        const spotlight = document.getElementById("mouse-spotlight");
        const orb1 = document.querySelector(".neon-orb-1");
        const orb2 = document.querySelector(".neon-orb-2");
        const orb3 = document.querySelector(".neon-orb-3");
        const neonOrbsContainer = document.querySelector(".bg-neon-orbs");
        const guideSection = document.getElementById("guide");

        function checkLightGuideSoftening() {
          if (guideSection && neonOrbsContainer && document.documentElement.classList.contains("light")) {
            const rect = guideSection.getBoundingClientRect();
            if (rect.top <= window.innerHeight - 50) {
              neonOrbsContainer.classList.add("guide-softened");
            } else {
              neonOrbsContainer.classList.remove("guide-softened");
            }
          } else if (neonOrbsContainer) {
            neonOrbsContainer.classList.remove("guide-softened");
          }
        }

        window.addEventListener("scroll", checkLightGuideSoftening, { passive: true });
        window.addEventListener("themechanged", checkLightGuideSoftening);
        checkLightGuideSoftening();

        window.addEventListener("mousemove", function (e) {
          mouseX = e.clientX;
          mouseY = e.clientY;

          if (!ticking) {
            window.requestAnimationFrame(function () {
              // Smooth lerp interpolation for soft fluid motion
              currentX += (mouseX - currentX) * 0.12;
              currentY += (mouseY - currentY) * 0.12;
              if (spotlight) {
                spotlight.style.setProperty("--spotlight-x", currentX + "px");
                spotlight.style.setProperty("--spotlight-y", currentY + "px");
              }

              // Interactive mouse parallax drift on floating neon orbs
              const offsetX = (currentX - window.innerWidth / 2) * 0.05;
              const offsetY = (currentY - window.innerHeight / 2) * 0.05;

              if (orb1) orb1.style.transform = `translate3d(${offsetX}px, ${offsetY}px, 0)`;
              if (orb2) orb2.style.transform = `translate3d(${-offsetX * 1.3}px, ${-offsetY * 1.3}px, 0)`;
              if (orb3) orb3.style.transform = `translate3d(${offsetX * 0.9}px, ${-offsetY * 0.9}px, 0)`;

              ticking = false;
            });
            ticking = true;
          }
        }, { passive: true });

        // Universal Scroll Reveal Observer for all pages
        function initScrollReveals() {
          const revealElements = document.querySelectorAll('.reveal-on-scroll, .reveal-3d');
          if (!revealElements.length) return;
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
              }
            });
          }, { threshold: 0.05, rootMargin: '0px 0px -20px 0px' });

          revealElements.forEach((el) => observer.observe(el));
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initScrollReveals);
        } else {
          initScrollReveals();
        }
      })();
    </script>
  </body>
</html>
