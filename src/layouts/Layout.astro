---
import "../styles/global.css";
import ScrollProgress from "../components/ScrollProgress.astro";
import FloatingDock from "../components/FloatingDock.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = "Platform Fee Matrix — Compare Digital Product Platform Fees",
  description = "Compare net profit across Gumroad, Lemon Squeezy, Payhip, Stripe, and Whop with our real-time interactive fee calculator. Find the best platform for your digital products.",
  canonical = `https://platformfeematrix.com${Astro.url.pathname}`,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Platform Fee Matrix" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Fonts: Inter + JetBrains Mono from Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap"
      rel="stylesheet"
    />

    <!-- Dark mode initialization -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        if (stored === "light") {
          document.documentElement.classList.add("light");
        } else {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
  </head>
  <body class="bg-mesh-grid">
    <!-- Ambient Mouse-Following Spotlight (Strictly in Background) -->
    <div
      id="mouse-spotlight"
      style="
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        background: radial-gradient(650px circle at var(--spotlight-x, 50vw) var(--spotlight-y, 30vh), rgba(245, 158, 11, 0.07), rgba(121, 40, 202, 0.04), transparent 75%);
        transition: opacity 0.3s ease;
      "
      aria-hidden="true"
    >
    </div>

    <ScrollProgress />

    <div style="position: relative; z-index: 1;">
      <slot />
    </div>

    <FloatingDock />

    <!-- 60 FPS Mouse Spotlight Tracking Script -->
    <script is:inline>
      (function () {
        let mouseX = window.innerWidth / 2;
        let mouseY = window.innerHeight / 3;
        let currentX = mouseX;
        let currentY = mouseY;
        let ticking = false;

        const spotlight = document.getElementById("mouse-spotlight");

        window.addEventListener("mousemove", function (e) {
          mouseX = e.clientX;
          mouseY = e.clientY;

          if (!ticking) {
            window.requestAnimationFrame(function () {
              // Smooth lerp interpolation for soft fluid motion
              currentX += (mouseX - currentX) * 0.15;
              currentY += (mouseY - currentY) * 0.15;
              if (spotlight) {
                spotlight.style.setProperty("--spotlight-x", currentX + "px");
                spotlight.style.setProperty("--spotlight-y", currentY + "px");
              }
              ticking = false;
            });
            ticking = true;
          }
        });
      })();
    </script>
  </body>
</html>
